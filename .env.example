# Copy to .env for local development; set the same variables in Vercel/Netlify.

# Public site URL (canonical links, sitemap, OG tags, QR code)
SITE_URL=https://kilf2027.vercel.app

# Form endpoint (Formspree, Getform, or a Google Apps Script web-app URL).
# All forms POST JSON here with a "form" field naming the form.
PUBLIC_FORM_ENDPOINT=

# Optional per-form overrides (fall back to PUBLIC_FORM_ENDPOINT)
PUBLIC_FORM_ENDPOINT_PARTNER=
PUBLIC_FORM_ENDPOINT_NEWSLETTER=

# Analytics: set ONE of these (leave both empty to disable)
PUBLIC_GA4_ID=
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: link for the "Book a partnership call" button (Calendly, Cal.com…)
PUBLIC_PARTNER_CALL_URL=
# Optional: WhatsApp channel/community invite link for the signup block
PUBLIC_WHATSAPP_URL=
