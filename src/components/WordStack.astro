---
/** Stacked word block from the brochure's hero pages. */
interface Props { tone?: 'light' | 'dark'; class?: string }
const { tone = 'light', class: cls = '' } = Astro.props;
const words = ['Stories', 'People', 'Places', 'Possibilities'];
---
<ul
  aria-hidden="true"
  class:list={[
    'text-right text-[0.7rem] font-extrabold uppercase leading-[1.35] tracking-[0.22em] sm:text-xs',
    tone === 'dark' ? 'text-mist' : 'text-muted',
    cls,
  ]}
>
  {words.map((w, i) => <li class:list={[i === words.length - 1 && (tone === 'dark' ? 'text-coral' : 'text-coral-ink')]}>{w}</li>)}
</ul>
