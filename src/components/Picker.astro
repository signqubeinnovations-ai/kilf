---
import Icon from './Icon.astro';
import Counter from './Counter.astro';
import { pickerTypes, pickerStyles } from '@/lib/content';
import { waFor } from '@/lib/site';
interface Props { n?: number; of?: number; }
const { n, of } = Astro.props;
---
<section class="section s-rust picker" id="next-project" aria-label="Project picker">
  {n && of && <Counter n={n} of={of} />}
  <div class="wrap grid-12">
    <div class="pk-intro">
      <p class="eyebrow">Plan in 30 seconds</p>
      <h2 id="pk-h" class="t-4" data-hl><span class="ln"><span class="thin">WHAT'S YOUR</span></span><span class="ln" style="--i:1"><span class="bold">NEXT PROJECT?</span></span></h2>
      <p class="body-copy pk-sub">Three quick choices. We turn them into a style board and send it to our studio on WhatsApp. No prices, no obligation.</p>
    </div>
    <form class="pk" data-picker novalidate>
      <p class="pk-step caps num" aria-live="polite"><span data-pk-step>Step 01</span> / 03</p>

      <fieldset class="pk-fs" data-pk-fs="1">
        <legend class="t-2">Building type</legend>
        <div class="pk-tiles">
          {pickerTypes.map((t, i) => (
            <label class="pk-tile"><input type="radio" name="type" value={t.id} data-label={t.label} required checked={i === 0} /><span>{t.label}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="pk-fs" data-pk-fs="2">
        <legend class="t-2">Style</legend>
        <div class="pk-tiles pk-styles">
          {pickerStyles.map((s, i) => (
            <label class="pk-tile">
              <input type="radio" name="style" value={s.id} data-label={s.label} required checked={i === 0} />
              <span class="pk-sw" aria-hidden="true">{s.board.map((c) => <i style={`background:${c}`} />)}</span>
              <span>{s.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="pk-fs" data-pk-fs="3">
        <legend class="t-2">Approximate facade area</legend>
        <div class="pk-range">
          <output class="t-3" data-pk-out for="pk-area"><span data-pk-area>1,500</span> <span class="thin">sq ft</span></output>
          <input id="pk-area" type="range" name="area" min="100" max="20000" step="100" value="1500" aria-describedby="pk-area-h" />
          <p id="pk-area-h" class="body-copy">A rough guess is fine. A typical single shop front is a few hundred sq ft. Not sure? Leave it and we will measure.</p>
        </div>
      </fieldset>

      <div class="pk-nav">
        <button type="button" class="btn btn-ghost" data-pk-back hidden>Back</button>
        <button type="button" class="btn btn-primary" data-pk-next>Next <Icon name="arrow" class="arrow" /></button>
      </div>

      <div class="pk-result" data-pk-result hidden tabindex="-1" aria-live="polite">
        <p class="eyebrow">Your style board</p>
        <div class="pk-board" data-pk-board aria-hidden="true"><i /><i /><i /></div>
        <h3 class="t-2" data-pk-title></h3>
        <p class="body-copy" data-pk-note></p>
        <dl class="pk-sum" data-pk-sum></dl>
        <div class="pk-actions">
          <a class="btn btn-primary btn-lg" data-pk-wa href={waFor('building')} target="_blank" rel="noopener" data-track="picker_complete"><Icon name="wa" class="wa-ic" /><span>Send this to FACADO on WhatsApp</span></a>
          <button type="button" class="btn btn-ghost" data-pk-restart>Start again</button>
        </div>
      </div>
      <noscript><p class="body-copy">Prefer to just talk? <a href={waFor('building')}>Message us on WhatsApp</a>.</p></noscript>
    </form>
  </div>
</section>

<style>
  .pk-intro { grid-column: 1 / -1; }
  .pk { grid-column: 1 / -1; margin-top: 3rem; }
  @media (min-width: 64rem) { .pk-intro { grid-column: 1 / span 5; } .pk { grid-column: 7 / span 6; margin-top: 0.5rem; } }
  .pk-sub { margin-top: 1.5rem; max-width: 40ch; }
  .pk-step { font-size: 0.9rem; margin-bottom: 1.5rem; }
  .pk-fs { border: 0; margin: 0; padding: 0; }
  .pk-fs + .pk-fs { margin-top: 2.5rem; }
  :global(.js) .pk.stepped .pk-fs + .pk-fs { margin-top: 0; }
  legend { padding: 0; margin-bottom: 1.25rem; font-weight: 700; }
  .pk-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  .pk-styles { grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
  .pk-tile { position: relative; display: grid; gap: 0.75rem; align-content: end; min-height: 5.5rem; padding: 1rem; border: 1px solid var(--rule); cursor: pointer; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.95rem; line-height: 1.15; transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease); }
  .pk-tile:hover { border-color: var(--fg); }
  .pk-tile input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .pk-tile:has(input:checked) { border-color: var(--accent); background: color-mix(in oklab, var(--color-cream) 8%, transparent); box-shadow: inset 0 0 0 1px var(--accent); }
  .pk-tile:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .pk-sw { display: flex; height: 1.6rem; }
  .pk-sw i { flex: 1; }
  .pk-range { display: grid; gap: 1.25rem; }
  .pk-range output { font-weight: 700; }
  input[type='range'] { width: 100%; height: 44px; accent-color: var(--color-sand); background: transparent; }
  .pk-nav { display: flex; gap: 0.75rem; margin-top: 2rem; }
  .pk-result { margin-top: 2rem; display: grid; gap: 1.1rem; }
  .pk-result:focus { outline: none; }
  .pk-board { display: grid; grid-template-columns: 2fr 1fr 1fr; height: 9rem; border: 1px solid var(--rule); }
  .pk-board i:first-child { grid-row: span 1; }
  .pk-sum { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1.5rem; margin: 0.5rem 0 0; padding: 1rem 0; border-block: 1px solid var(--rule); }
  .pk-sum :global(dt) { font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.85rem; color: var(--accent); }
  .pk-sum :global(dd) { margin: 0; }
  .pk-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
</style>

<script>
  import { track } from '@/scripts/analytics';
  import { pickerStyles } from '@/lib/content';
  const form = document.querySelector<HTMLFormElement>('[data-picker]');
  if (form) {
    const fss = [...form.querySelectorAll<HTMLFieldSetElement>('[data-pk-fs]')];
    const next = form.querySelector<HTMLButtonElement>('[data-pk-next]')!;
    const back = form.querySelector<HTMLButtonElement>('[data-pk-back]')!;
    const stepLbl = form.querySelector<HTMLElement>('[data-pk-step]')!;
    const result = form.querySelector<HTMLElement>('[data-pk-result]')!;
    const nav = form.querySelector<HTMLElement>('.pk-nav')!;
    const range = form.querySelector<HTMLInputElement>('input[type=range]')!;
    const areaOut = form.querySelector<HTMLElement>('[data-pk-area]')!;
    const fmt = (n: number) => n.toLocaleString('en-IN');
    let step = 0;
    form.classList.add('stepped');
    const show = () => {
      fss.forEach((f, i) => (f.hidden = i !== step));
      back.hidden = step === 0;
      next.firstChild!.textContent = step === fss.length - 1 ? 'See my style board ' : 'Next ';
      stepLbl.textContent = `Step ${String(step + 1).padStart(2, '0')}`;
    };
    range.addEventListener('input', () => (areaOut.textContent = fmt(+range.value)));
    const val = (name: string) => form.querySelector<HTMLInputElement>(`input[name=${name}]:checked`);
    next.addEventListener('click', () => {
      if (step < fss.length - 1) { step++; show(); fss[step].querySelector<HTMLElement>('input')?.focus(); return; }
      const type = val('type')!, style = val('style')!;
      const s = pickerStyles.find((x) => x.id === style.value)!;
      const area = fmt(+range.value);
      form.querySelectorAll<HTMLElement>('[data-pk-board] i').forEach((el, i) => (el.style.background = s.board[i]));
      form.querySelector('[data-pk-title]')!.textContent = `${s.label} for a ${type.dataset.label!.toLowerCase()}`;
      form.querySelector('[data-pk-note]')!.textContent = s.note;
      form.querySelector('[data-pk-sum]')!.innerHTML = `<dt>Building</dt><dd>${type.dataset.label}</dd><dt>Style</dt><dd>${s.label}</dd><dt>Area</dt><dd>About ${area} sq ft</dd>`;
      const msg = `Hi FACADO, I'd like a free facade design.\nBuilding type: ${type.dataset.label}\nStyle: ${s.label}\nApprox. facade area: ${area} sq ft\nLocation: `;
      form.querySelector<HTMLAnchorElement>('[data-pk-wa]')!.href = `https://wa.me/918113013556?text=${encodeURIComponent(msg)}`;
      fss.forEach((f) => (f.hidden = true));
      nav.hidden = true;
      stepLbl.textContent = 'Done';
      result.hidden = false;
      result.focus();
      track('picker_view_result', { building: type.value, style: s.id, area: +range.value });
    });
    back.addEventListener('click', () => { step = Math.max(0, step - 1); show(); });
    form.querySelector('[data-pk-restart]')!.addEventListener('click', () => { step = 0; result.hidden = true; nav.hidden = false; show(); });
    show();
  }
</script>
