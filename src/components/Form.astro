---
import { site, env } from '@/lib/site';
import { useTranslations, type Lang } from '@/i18n/ui';
import LimeButton from './LimeButton.astro';
import Icon from './Icon.astro';
/**
 * Static-hosting form. POSTs JSON to PUBLIC_FORM_ENDPOINT (Formspree,
 * Getform, a Google Apps Script web app…). Includes a honeypot field and a
 * minimum fill time for spam protection, client-side validation and a
 * success state. Put <Field formId={id} …/> components in the slot.
 */
interface Props {
  id: string;
  name: string; // sent as the "form" field, e.g. "volunteer"
  submitLabel?: string;
  endpoint?: string;
  lang?: Lang;
  class?: string;
  successTitle?: string;
  successText?: string;
  tone?: 'light' | 'dark';
  grid?: boolean;
}
const {
  id,
  name,
  lang = 'en',
  submitLabel,
  endpoint = env.formEndpoint,
  class: cls = '',
  successTitle = lang === 'ml' ? 'നന്ദി!' : 'Thank you!',
  successText,
  tone = 'light',
  grid = true,
} = Astro.props;
const t = useTranslations(lang);
const dark = tone === 'dark';
---
<form
  id={id}
  data-kilf-form
  data-endpoint={endpoint}
  data-dev={import.meta.env.DEV ? 'true' : undefined}
  data-sending={t('form.sending')}
  data-required={t('form.required')}
  novalidate
  class:list={['relative', cls]}
>
  <input type="hidden" name="form" value={name} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <!-- honeypot: humans never see or fill this -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label>Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div data-fields>
    <div class:list={[grid && 'grid gap-5 sm:grid-cols-2']}>
      <slot />
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <LimeButton type="submit" label={submitLabel ?? t('form.submit')} data-submit />
      <p class:list={['text-sm', dark ? 'text-mist' : 'text-muted']}>
        {lang === 'ml' ? 'നിങ്ങളുടെ വിവരങ്ങൾ KILF-നു മാത്രം.' : 'We only use your details for KILF.'}
        <a href={lang === 'ml' ? '/ml/privacy' : '/privacy'} class="underline underline-offset-4">{lang === 'ml' ? 'സ്വകാര്യത' : 'Privacy'}</a>
      </p>
    </div>
    <p data-form-error role="alert" class:list={['mt-4 hidden rounded-xl px-4 py-3 text-sm font-semibold', dark ? 'bg-white/10 text-cream' : 'bg-coral/10 text-coral-ink']}>
      {t('form.error')} <a href={`mailto:${site.email}`} class="underline">{site.email}</a>.
    </p>
  </div>

  <div data-success class:list={['hidden rounded-2xl p-6 sm:p-8', dark ? 'bg-white/10' : 'bg-sky']} tabindex="-1" role="status">
    <div class="flex items-start gap-4">
      <span class="inline-grid size-12 shrink-0 place-items-center rounded-full bg-lime text-navy"><Icon name="check" size={26} /></span>
      <div>
        <p class="font-display text-2xl font-extrabold tracking-tight">{successTitle}</p>
        <p class:list={['mt-1', dark ? 'text-cream/90' : 'text-muted']}>{successText ?? t('form.success')}</p>
      </div>
    </div>
  </div>
</form>

<script>
  const MIN_FILL_MS = 2500;
  document.querySelectorAll<HTMLFormElement>('form[data-kilf-form]').forEach((form) => {
    const started = Date.now();
    const fields = form.querySelector<HTMLElement>('[data-fields]')!;
    const success = form.querySelector<HTMLElement>('[data-success]')!;
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitText = submit.querySelector('span')!;
    const originalLabel = submitText.textContent;

    const controls = () =>
      Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input:not([type=hidden]):not([name=_gotcha]), textarea, select'));

    const showError = (el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
      const msg = form.querySelector<HTMLElement>(`[data-error-for="${el.name}"]`);
      const valid = el.checkValidity();
      el.setAttribute('aria-invalid', String(!valid));
      if (msg) {
        msg.textContent = valid ? '' : el.validity.valueMissing ? form.dataset.required || 'Required' : el.validationMessage;
        msg.classList.toggle('hidden', valid);
      }
      return valid;
    };

    controls().forEach((el) => {
      el.addEventListener('blur', () => el.value && showError(el));
      el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && showError(el));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      const invalid = controls().filter((el) => !showError(el));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }
      const data = Object.fromEntries(new FormData(form).entries());
      const done = () => {
        fields.classList.add('hidden');
        success.classList.remove('hidden');
        success.focus();
      };
      // Bots: filled honeypot or inhumanly fast → pretend success, send nothing.
      if (data._gotcha || Date.now() - started < MIN_FILL_MS) return done();
      delete data._gotcha;

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        if (form.dataset.dev) {
          console.warn('[KILF] PUBLIC_FORM_ENDPOINT is not set; simulating success in dev.', data);
          return done();
        }
        errorBox.classList.remove('hidden');
        return;
      }
      submit.disabled = true;
      submitText.textContent = form.dataset.sending || 'Sending…';
      try {
        const body = JSON.stringify({ ...data, submittedAt: new Date().toISOString() });
        if (endpoint.includes('script.google.com')) {
          // Google Apps Script web apps don't answer CORS preflights: send a
          // "simple" request and trust it (the script parses e.postData.contents).
          await fetch(endpoint, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body });
        } else {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body,
          });
          if (!res.ok) throw new Error(String(res.status));
        }
        done();
      } catch {
        errorBox.classList.remove('hidden');
      } finally {
        submit.disabled = false;
        submitText.textContent = originalLabel;
      }
    });
  });
</script>
