---
import { useTranslations, localizePath, type Lang, type UIKey } from '@/i18n/ui';
/** Five ways in, as a numbered list between hairlines. */
interface Props { lang?: Lang; tone?: 'light' | 'dark' }
const { lang = 'en', tone = 'light' } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const rows = [
  { key: 'register', href: '/get-involved#register' },
  { key: 'volunteer', href: '/get-involved#volunteer' },
  { key: 'exhibit', href: '/get-involved#exhibit' },
  { key: 'partner', href: '/partners' },
  { key: 'attend', href: '/passes' },
] as const;
const dark = tone === 'dark';
---
<ol class:list={['border-t', dark ? 'border-white/20' : 'border-line']} data-reveal-group>
  {rows.map((r, i) => (
    <li class:list={['border-b', dark ? 'border-white/20' : 'border-line']}>
      <a href={lp(r.href)} class="group grid grid-cols-[3rem_1fr_auto] items-baseline gap-x-4 py-7 sm:grid-cols-[4.5rem_1fr_auto] sm:py-9">
        <span class:list={['text-sm font-medium tabular-nums', dark ? 'text-white/70' : 'text-navy']} lang="en">{String(i + 1).padStart(2, '0')}</span>
        <span>
          <span class:list={['block font-display text-[1.7rem] font-semibold leading-tight tracking-[-0.03em] transition-colors duration-300 sm:text-[2rem]', dark ? 'text-white group-hover:text-lime' : 'text-navy group-hover:text-blue-bright']}>
            {t(`home.involved.${r.key}` as UIKey)}
          </span>
          <span class:list={['mt-2 block text-[1rem] leading-relaxed sm:text-[1.05rem]', dark ? 'text-white/75' : 'text-muted']}>{t(`home.involved.${r.key}.d` as UIKey)}</span>
        </span>
        <span aria-hidden="true" class:list={['self-center text-xl transition-transform duration-500 ease-[var(--ease-calm)] group-hover:-translate-y-1 group-hover:translate-x-1', dark ? 'text-lime' : 'text-blue-bright']}>↗</span>
      </a>
    </li>
  ))}
</ol>
