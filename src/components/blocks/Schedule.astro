---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { site } from '@/lib/site';
/**
 * Day-by-day schedule, rendered once src/content/schedule.json has entries.
 */
interface Props { days: CollectionEntry<'schedule'>[] }
const { days } = Astro.props;
const speakers = await getCollection('speakers');
const speakerName = (slug: string) => speakers.find((s) => s.id === slug)?.data.name ?? slug;
const venueName = (id: string) => site.venues.find((v) => v.id === id)?.name ?? id;
const fmt = (d: string) => new Date(`${d}T12:00:00+05:30`).toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const sorted = [...days].sort((a, b) => a.data.date.localeCompare(b.data.date));
---
<div class="space-y-12">
  {sorted.map((day) => (
    <section aria-labelledby={`day-${day.id}`}>
      <h3 id={`day-${day.id}`} class="flex flex-wrap items-baseline gap-3 border-b border-line pb-3">
        <span class="display text-3xl text-navy">{day.data.label}</span>
        <time datetime={day.data.date} class="text-sm font-bold uppercase tracking-[0.14em] text-coral-ink">{fmt(day.data.date)}</time>
      </h3>
      <ol class="mt-4 divide-y divide-line">
        {[...day.data.sessions].sort((a, b) => a.start.localeCompare(b.start)).map((s) => (
          <li class="grid gap-2 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
            <p class="font-light text-2xl tabular-nums text-blue">{s.start}{s.end && <span class="text-base text-muted">–{s.end}</span>}</p>
            <div>
              <h4 class="font-display text-xl font-extrabold tracking-tight">{s.title}</h4>
              {s.description && <p class="mt-1 text-muted">{s.description}</p>}
              <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
                <span class="inline-flex items-center gap-1.5"><Icon name="pin" size={16} />{venueName(s.venue)}</span>
                <span class="inline-flex items-center gap-1.5"><Icon name="globe" size={16} />{s.language}</span>
                {s.speakers.length > 0 && <span class="inline-flex items-center gap-1.5"><Icon name="users" size={16} />{s.speakers.map(speakerName).join(', ')}</span>}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
