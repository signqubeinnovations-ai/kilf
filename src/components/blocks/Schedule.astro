---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { site } from '@/lib/site';
import { localizePath, type Lang } from '@/i18n/ui';
/**
 * The day-by-day programme (src/content/schedule.json). Without JavaScript
 * every day is listed in turn; with it, the days become tabs, and the strand
 * chips filter the sessions. Speaker chips link to their notes on /speakers.
 */
interface Props { days: CollectionEntry<'schedule'>[]; lang: Lang }
const { days, lang } = Astro.props;
const speakers = await getCollection('speakers');
const strands = (await getCollection('strands')).sort((a, b) => a.data.order - b.data.order);
const speaker = (slug: string) => speakers.find((s) => s.id === slug);
const venueName = (id: string) => site.venues.find((v) => v.id === id)?.name ?? id;
const strandName = (id?: string) => (id === 'youth' ? 'Youth' : strands.find((s) => s.id === id)?.data.name);
const formats = {
  conversation: 'Conversation',
  panel: 'Panel',
  reading: 'Reading',
  workshop: 'Workshop',
  performance: 'Performance',
  screening: 'Screening',
  walk: 'Walk',
  ceremony: 'Ceremony',
} as const;
// A colour per strand, for the small square beside its name.
const colours: Record<string, string> = {
  literature: '#2447ed',
  cinema: '#a3391f',
  music: '#8a3fd1',
  theatre: '#ff8870',
  art: '#e0a400',
  ideas: '#152f81',
  children: '#2aa198',
  bookfair: '#173ccb',
  food: '#d4553a',
  youth: '#b7c62b',
};
const initials = (name: string) =>
  name
    .replace(/\./g, ' ')
    .split(/\s+/)
    .filter((w) => w.length > 1 || /[A-Z]/.test(w))
    .slice(-2)
    .map((w) => w[0].toUpperCase())
    .join('');
const when = (date: string, o: Intl.DateTimeFormatOptions) => new Date(`${date}T12:00:00+05:30`).toLocaleDateString('en-GB', { timeZone: 'Asia/Kolkata', ...o });
const sorted = [...days].sort((a, b) => a.data.date.localeCompare(b.data.date));
const byTime = (list: CollectionEntry<'schedule'>['data']['sessions']) => [...list].sort((a, b) => a.start.localeCompare(b.start));
// Only the strands that actually appear, in their usual order.
const present = new Set(sorted.flatMap((d) => d.data.sessions.map((s) => s.strand).filter(Boolean)));
const filters = [...strands.map((s) => s.id), 'youth'].filter((id) => present.has(id));
const total = sorted.reduce((n, d) => n + d.data.sessions.length, 0);
---
<div data-schedule>
  <nav class="sticky top-[var(--hh)] z-30 -mx-5 border-b border-line bg-cream/95 px-5 backdrop-blur-sm sm:-mx-8 sm:px-8 lg:mx-0 lg:px-0" aria-label="Festival days">
    <ul class="flex gap-2 overflow-x-auto py-3 [scrollbar-width:none]" data-tablist>
      {sorted.map((d) => (
        <li class="shrink-0">
          <a
            href={`#day-${d.id}`}
            data-tab={d.id}
            class="day-tab flex min-h-16 items-center gap-3 px-4 py-2 text-navy ring-1 ring-inset ring-navy/15 transition-colors hover:bg-navy/5 sm:min-w-[12.5rem] sm:px-5"
          >
            <span class="numeral text-[2.1rem] leading-none">{when(d.data.date, { day: '2-digit' })}</span>
            <span class="leading-tight">
              <span class="block text-[0.68rem] font-bold uppercase tracking-[0.16em] opacity-75">{when(d.data.date, { month: 'short' })} · {when(d.data.date, { weekday: 'short' })}</span>
              <span class="block whitespace-nowrap text-[0.95rem] font-semibold">{d.data.theme.replace(/\.$/, '')}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between" data-filter-bar hidden>
    <ul class="flex flex-wrap gap-2" aria-label="Filter sessions by strand">
      <li><button type="button" data-strand-filter="all" aria-pressed="true" class="chip">All strands</button></li>
      {filters.map((id) => (
        <li>
          <button type="button" data-strand-filter={id} aria-pressed="false" class="chip">
            <span class="size-2 shrink-0" style={`background:${colours[id]}`} aria-hidden="true"></span>{strandName(id)}
          </button>
        </li>
      ))}
    </ul>
    <p class="text-sm text-muted" aria-live="polite" data-filter-status>{total} sessions over {sorted.length} days</p>
  </div>

  {sorted.map((d) => {
    const list = byTime(d.data.sessions);
    const picks = list.filter((s) => s.highlight).length;
    return (
      <section id={`day-${d.id}`} class="day-panel scroll-mt-40 pt-14" data-day={d.id} aria-labelledby={`day-${d.id}-h`}>
        <header class="grid gap-8 border-b border-navy/15 pb-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <p class="eyebrow text-navy">
              {d.data.label} · <time datetime={d.data.date}>{when(d.data.date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</time>
            </p>
            <h3 id={`day-${d.id}-h`} class="display mt-4 text-[2.7rem] leading-[1.02] tracking-[-0.045em] sm:text-[3.8rem] lg:text-[4.4rem]">
              <span class="text-grad">{d.data.theme}</span>
            </h3>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{d.data.blurb}</p>
          </div>
          <div class="self-end lg:col-span-5">
            <p class="flex flex-wrap gap-x-6 gap-y-1 text-sm font-semibold text-navy">
              <span>{list.length} sessions</span><span class="text-coral-deep">★ {picks} not to miss</span>
            </p>
            {d.data.allDay.length > 0 && (
              <ul class="mt-4 border-t border-line text-[0.95rem]">
                {d.data.allDay.map((item) => (
                  <li class="flex items-start gap-3 border-b border-line py-3 text-navy">
                    <Icon name="clock" size={18} class="mt-0.5 shrink-0 text-blue-bright" />
                    {item}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </header>

        <ol class="sessions">
          {list.map((s) => (
            <li
              class:list={['session grid gap-x-10 gap-y-3 border-b border-line py-8 sm:grid-cols-[7.5rem_1fr] lg:grid-cols-[8.5rem_1fr_16.5rem]', s.highlight && 'is-pick']}
              data-strand={s.strand ?? 'none'}
            >
              <p class="flex items-baseline gap-2 sm:block">
                <span class="numeral text-[2rem] leading-none text-navy">{s.start}</span>
                <span class="text-sm text-muted sm:mt-2 sm:block">{s.end ? `to ${s.end}` : 'Evening'}</span>
              </p>
              <div class="min-w-0">
                <p class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.72rem] font-bold uppercase tracking-[0.14em]">
                  {s.strand && (
                    <span class="inline-flex items-center gap-2 text-navy">
                      <span class="size-2 shrink-0" style={`background:${colours[s.strand] ?? '#152f81'}`} aria-hidden="true"></span>
                      {strandName(s.strand)}
                    </span>
                  )}
                  {s.format && <span class="text-muted">{formats[s.format]}</span>}
                  {s.highlight && <span class="bg-coral-soft px-2 py-1 text-coral-deep">★ Don’t miss</span>}
                </p>
                <h4 class="mt-3 max-w-2xl font-display text-[1.4rem] font-semibold leading-snug tracking-[-0.025em] text-navy sm:text-[1.6rem]">{s.title}</h4>
                {s.description && <p class="mt-2 max-w-2xl leading-relaxed text-muted">{s.description}</p>}
                {s.speakers.length > 0 && (
                  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Speakers">
                    {s.speakers.map((slug) => {
                      const p = speaker(slug);
                      if (!p) return null;
                      return (
                        <li>
                          <a href={localizePath(`/speakers#${slug}`, lang)} class="group inline-flex min-h-11 items-center gap-2.5 bg-sky py-1.5 pl-1.5 pr-4 text-navy transition-colors hover:bg-navy hover:text-white">
                            <span class="grid size-8 place-items-center bg-cream font-display text-[0.72rem] font-bold text-blue transition-colors group-hover:bg-white/15 group-hover:text-white" aria-hidden="true">{initials(p.data.name)}</span>
                            <span class="text-[0.92rem] font-semibold">{p.data.name}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                )}
                {s.guests.length > 0 && (
                  <p class="mt-3 text-[0.95rem] text-muted"><span class="font-semibold text-navy">With </span>{s.guests.join(' · ')}</p>
                )}
                {s.link && (
                  <a href={localizePath(s.link.href, lang)} class="text-link mt-5 inline-flex min-h-11 items-end gap-2 font-semibold text-blue-bright hover:text-navy">
                    {s.link.label} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
              <p class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-muted sm:col-start-2 lg:col-start-auto lg:flex-col lg:items-end lg:text-right">
                <span class="inline-flex items-start gap-1.5"><Icon name="pin" size={16} class="mt-0.5 shrink-0" />{venueName(s.venue)}</span>
                {s.language && <span class="inline-flex items-start gap-1.5"><Icon name="globe" size={16} class="mt-0.5 shrink-0" />{s.language}</span>}
              </p>
            </li>
          ))}
        </ol>
        <p class="hidden py-10 text-lg text-muted" data-empty>No sessions in this strand on this day. Try another day, or all strands.</p>
      </section>
    );
  })}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-schedule]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-day]')];
    const list = root.querySelector<HTMLElement>('[data-tablist]');
    if (!list || !tabs.length) return;

    // Days as tabs.
    list.setAttribute('role', 'tablist');
    list.querySelectorAll('li').forEach((li) => li.setAttribute('role', 'presentation'));
    tabs.forEach((tab) => {
      tab.setAttribute('role', 'tab');
      tab.id = `tab-${tab.dataset.tab}`;
      tab.setAttribute('aria-controls', `day-${tab.dataset.tab}`);
    });
    panels.forEach((p) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', `tab-${p.dataset.day}`);
      p.tabIndex = -1;
    });
    const select = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on) {
          tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          if (focus) tab.focus();
        }
      });
      panels.forEach((p) => (p.hidden = p.dataset.day !== id));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        select(tab.dataset.tab!);
        history.replaceState(null, '', `#day-${tab.dataset.tab}`);
      });
      tab.addEventListener('keydown', (e) => {
        const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        const next = tabs[(to + tabs.length) % tabs.length];
        select(next.dataset.tab!, true);
        history.replaceState(null, '', `#day-${next.dataset.tab}`);
      });
    });
    // Open on the linked day, today during the festival, or the first day.
    const fromHash = location.hash.replace('#day-', '');
    const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
    const ids = tabs.map((t) => t.dataset.tab!);
    select(ids.includes(fromHash) ? fromHash : ids.includes(today) ? today : ids[0]);

    // Strand filter.
    const bar = root.querySelector<HTMLElement>('[data-filter-bar]');
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-strand-filter]')];
    if (!bar) return;
    bar.hidden = false;
    const all = status?.textContent ?? '';
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const id = chip.dataset.strandFilter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        let shown = 0;
        panels.forEach((p) => {
          let n = 0;
          p.querySelectorAll<HTMLElement>('.session').forEach((s) => {
            const on = id === 'all' || s.dataset.strand === id;
            s.hidden = !on;
            if (on) n++;
          });
          p.querySelector('[data-empty]')?.classList.toggle('hidden', n > 0);
          shown += n;
        });
        if (status) status.textContent = id === 'all' ? all : `${shown} ${chip.textContent?.trim()} sessions over the five days`;
      })
    );
  });
</script>

<style>
  .day-tab[aria-selected='true'] {
    background: var(--color-navy);
    color: #fff;
    --tw-ring-color: var(--color-navy);
  }
  .chip {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-navy) 20%, transparent);
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .chip:hover {
    background: color-mix(in oklab, var(--color-navy) 6%, transparent);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-navy);
    color: #fff;
  }
  /* The must-sees stand out: a coral rule down the left, a hint of sky. */
  .session.is-pick {
    position: relative;
    background: linear-gradient(90deg, color-mix(in oklab, var(--color-sky) 80%, transparent), transparent 70%);
    box-shadow: inset 3px 0 0 var(--color-coral);
    padding-inline-start: 1.25rem;
  }
  @media (min-width: 640px) {
    .session.is-pick {
      padding-inline-start: 1.5rem;
    }
  }
  .day-panel:not([hidden]) {
    animation: day-in 0.6s var(--ease-calm) both;
  }
  @keyframes day-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .day-panel:not([hidden]) {
      animation: none;
    }
  }
</style>
