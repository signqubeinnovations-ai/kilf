---
import Headline from '../Headline.astro';
import Form from '../Form.astro';
import Field from '../Field.astro';
import RippleField from '../motion/RippleField';
import type { Lang } from '@/i18n/ui';
/** Navy banner with a compact "Notify me" signup. */
interface Props {
  id: string;
  formName: string;
  text: string;
  accent: string;
  lead?: string;
  submitLabel?: string;
  lang?: Lang;
  extraField?: { name: string; label: string; options: string[] };
}
const { id, formName, text, accent, lead, submitLabel = 'Notify me', lang = 'en', extraField } = Astro.props;
---
<section id={id} class="bg-cream py-12 sm:py-16" aria-labelledby={`${id}-h`}>
  <div class="container-kilf">
    <div class="panel on-dark grain bg-navy px-6 py-12 text-cream sm:px-12 sm:py-14 lg:px-16">
      <RippleField client:visible tone="dark" x={10} y={85} size={460} />
      <div class="relative grid items-center gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
        <div>
          <Headline id={`${id}-h`} text={text} accent={accent} tone="dark" size="md" />
          {lead && <p class="mt-4 max-w-md text-lg text-cream/90">{lead}</p>}
        </div>
        <Form id={`${id}-form`} name={formName} lang={lang} submitLabel={submitLabel} class="on-light rounded-[1.5rem] bg-white p-5 text-navy sm:p-8" successText="We’ll let you know the moment it opens.">
          <Field formId={`${id}-form`} name="name" label="Name" autocomplete="name" required />
          <Field formId={`${id}-form`} name="contact" label="Email or WhatsApp number" autocomplete="email" required />
          {extraField && <Field formId={`${id}-form`} type="select" name={extraField.name} label={extraField.label} options={extraField.options} full />}
        </Form>
      </div>
    </div>
  </div>
</section>
