---
/** Page section with brand background tones and the faint wave pattern. */
interface Props {
  tone?: 'cream' | 'white' | 'sky' | 'navy' | 'blue' | 'lime' | 'coral';
  waves?: boolean;
  id?: string;
  class?: string;
  inner?: string;
  labelledby?: string;
  as?: 'section' | 'div';
}
const { tone = 'cream', waves = false, id, class: cls = '', inner = '', labelledby, as: Tag = 'section' } = Astro.props;
const tones = {
  cream: 'bg-cream text-navy',
  white: 'bg-white text-navy',
  sky: 'bg-sky text-navy',
  navy: 'bg-navy text-cream on-dark',
  blue: 'bg-blue-bright text-white on-dark',
  lime: 'bg-lime text-navy',
  coral: 'bg-coral text-navy',
};
const dark = tone === 'navy' || tone === 'blue';
---
<Tag id={id} aria-labelledby={labelledby} class:list={['relative overflow-hidden py-20 sm:py-28', tones[tone], waves && (dark ? 'waves-light' : 'waves'), cls]}>
  <slot name="backdrop" />
  <div class:list={['container-kilf relative', inner]}><slot /></div>
</Tag>
