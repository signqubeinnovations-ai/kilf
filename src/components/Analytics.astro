---
/**
 * Analytics slot. Set PUBLIC_GA4_ID (e.g. G-XXXXXXX) or
 * PUBLIC_PLAUSIBLE_DOMAIN (e.g. kilf.in). Nothing loads if both are empty.
 */
import { env } from '@/lib/site';
const { ga4, plausible } = env;
---
{plausible && <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js" />}
{
  !plausible && ga4 && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
      <script is:inline define:vars={{ ga4 }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', ga4, { anonymize_ip: true });
      </script>
    </>
  )
}
