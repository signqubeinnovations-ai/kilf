---
import { parsePath, isTranslated } from '@/i18n/ui';
/**
 * Headline in Plus Jakarta Sans 800 with tight tracking, in cobalt (white on
 * cobalt sections). Each headline carries one highlight: red-coral, or
 * marigold on cobalt. It is the word named by `coral`, or, when no word is
 * named, the second line (`accent`). Never both.
 */
interface Props {
  text?: string;
  accent?: string;
  as?: 'h1' | 'h2' | 'h3';
  size?: 'xl' | 'lg' | 'md' | 'sm';
  tone?: 'light' | 'dark' | 'blue' | 'coral' | 'lime';
  /** Kept for older call sites; the accent is always a calm colour now. */
  accentStyle?: 'color' | 'gradient' | 'soft';
  accentColor?: 'coral' | 'blue' | 'lime' | 'navy';
  /** One word (in `text` or `accent`) to set in red. */
  coral?: string;
  /** Keep the accent on the same line (default: its own line). */
  inline?: boolean;
  stack?: boolean;
  class?: string;
  style?: string;
  id?: string;
  lang?: string;
  [key: `data-${string}`]: unknown;
}
const { text = '', accent = '', as: Tag = 'h2', size = 'lg', tone = 'light', accentStyle = 'color', accentColor, coral, inline = false, class: cls = '', style, id, lang, stack: _stack, ...rest } = Astro.props;
const sizes = {
  xl: 'text-[2.6rem] sm:text-[3.8rem] lg:text-[4.6rem]',
  lg: 'text-[2.1rem] sm:text-[2.8rem] lg:text-[3.3rem]',
  md: 'text-[1.7rem] sm:text-[2.1rem] lg:text-[2.4rem]',
  sm: 'text-xl sm:text-2xl',
};
// Malayalam words run long: set translated Malayalam headlines a step smaller.
const page = parsePath(Astro.url.pathname);
const mlText = lang === 'ml' || (page.lang === 'ml' && isTranslated(page.path));
const mlSizes = {
  xl: 'text-[2.1rem] sm:text-[3rem] lg:text-[3.6rem]',
  lg: 'text-[1.8rem] sm:text-[2.4rem] lg:text-[2.8rem]',
  md: 'text-[1.5rem] sm:text-[1.85rem] lg:text-[2.1rem]',
  sm: 'text-xl sm:text-2xl',
};
const base = { light: 'text-cobalt', dark: 'text-white', blue: 'text-white', coral: 'text-cobalt', lime: 'text-cobalt' }[tone];
const onDark = tone === 'dark' || tone === 'blue';
// One red highlight per headline: the named word if there is one, otherwise the accent line.
const red = onDark ? 'text-marigold' : 'text-coral';
const plain = onDark ? 'text-white' : 'text-cobalt';
const accentClass = accentStyle === 'soft' ? 'font-medium opacity-90' : coral ? plain : accentColor === 'navy' ? plain : red;
// Set the one red word, if it appears.
const mark = (s: string) => {
  const i = coral ? s.indexOf(coral) : -1;
  if (!coral || i === -1) return s;
  return [s.slice(0, i), wrap(esc(coral)), s.slice(i + coral.length)];
};
// Built without literal angle brackets: the Astro parser can mistake them for markup here.
const LT = String.fromCharCode(60);
const GT = String.fromCharCode(62);
const wrap = (w: string) => LT + 'span class="coral-word"' + GT + w + LT + '/span' + GT;
function esc(s: string) {
  return s.split('&').join('&amp;').split(String.fromCharCode(60)).join('&lt;').split(String.fromCharCode(62)).join('&gt;');
}
// A closing full stop sits a touch closer: at this weight the typeface leaves a gap before it.
const STOP = LT + 'span class="stop"' + GT + '.' + LT + '/span' + GT;
const html = (s: string) => {
  const m = mark(s);
  const out = Array.isArray(m) ? esc(m[0]) + m[1] + esc(m[2]) : esc(m);
  return out.endsWith('.') && !out.endsWith('..') ? out.slice(0, -1) + STOP : out;
};
---
<Tag id={id} lang={lang} style={style} class:list={['display', (mlText ? mlSizes : sizes)[size], base, onDark && 'on-dark', cls]} {...rest}>
  {text && <Fragment set:html={html(text)} />}{text && accent ? (inline ? ' ' : <br />) : ''}{accent && <span class={accentClass} set:html={html(accent)} />}
</Tag>
