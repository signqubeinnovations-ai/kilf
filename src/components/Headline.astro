---
/**
 * Caps headline with masked line-by-line reveal.
 * lines: strings; prefix a line with "*" for bold (700), otherwise thin (300).
 */
interface Props { lines: string[]; as?: 'h1' | 'h2' | 'h3'; size?: 'hero' | '4' | '3' | '2'; class?: string; id?: string; }
const { lines, as: Tag = 'h2', size = '3', class: cls = '', id } = Astro.props;
---
<Tag id={id} class:list={[`t-${size}`, cls]} data-hl>
  {lines.map((l, i) => {
    const bold = l.startsWith('*');
    return <span class="ln" style={`--i:${i}`}><span class={bold ? 'bold' : 'thin'}>{bold ? l.slice(1) : l}</span></span>;
  })}
</Tag>
