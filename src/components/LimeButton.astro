---
/**
 * Square button with a ↗. On hover a ring spreads from it, like a drop on
 * water. `primary` (the default) is cobalt on light surfaces and cream inside
 * `.on-dark` sections; `lime` is the older name for the pale lake-blue one.
 * Renders <a> when href is set.
 */
interface Props {
  href?: string;
  label: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'lime' | 'navy' | 'ghost' | 'white' | 'outline-light' | 'coral';
  size?: 'md' | 'sm' | 'lg';
  arrow?: boolean;
  class?: string;
  external?: boolean;
  [key: string]: unknown;
}
const { href, label, type = 'button', variant = 'primary', size = 'md', arrow = true, class: cls = '', external = false, ...rest } = Astro.props;
const variants = {
  primary: 'btn-primary',
  lime: 'bg-lake text-navy hover:bg-[#bcd1ef] [--ring:var(--color-lake)]',
  navy: 'bg-navy text-white hover:bg-night [--ring:var(--color-navy)]',
  white: 'bg-cream text-navy hover:bg-white [--ring:#fff]',
  coral: 'bg-coral text-night hover:bg-[#f48a70] [--ring:var(--color-coral)]',
  ghost: 'bg-transparent text-navy ring-1 ring-inset ring-navy/55 hover:bg-navy/5 [--ring:var(--color-navy)]',
  'outline-light': 'bg-transparent text-white ring-1 ring-inset ring-white/50 hover:bg-white/10 [--ring:#fff]',
};
const sizes = { lg: 'min-h-14 px-7 text-[1rem]', md: 'min-h-13 px-6 text-[0.95rem]', sm: 'min-h-11 px-5 text-sm' };
const classes = [
  'btn group inline-flex max-w-full items-center justify-center gap-2.5 font-bold transition-colors duration-300 whitespace-nowrap max-[379px]:whitespace-normal',
  variants[variant],
  sizes[size],
  cls,
];
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---
{
  href ? (
    <a href={href} class:list={classes} {...ext} {...rest}>
      <span>{label}</span>
      {arrow && <span aria-hidden="true" class="text-[0.85em] transition-transform duration-500 ease-[var(--ease-calm)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>}
      {external && <span class="sr-only">(opens in a new tab)</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <span>{label}</span>
      {arrow && <span aria-hidden="true" class="text-[0.85em]">↗</span>}
    </button>
  )
}
