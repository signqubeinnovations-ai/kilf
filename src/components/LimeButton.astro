---
import Icon from './Icon.astro';
/** Lime pill with navy text and a ↗ arrow. Renders <a> when href is set. */
interface Props {
  href?: string;
  label: string;
  type?: 'button' | 'submit';
  variant?: 'lime' | 'navy' | 'ghost' | 'white';
  size?: 'md' | 'sm';
  arrow?: boolean;
  class?: string;
  external?: boolean;
  [key: string]: unknown;
}
const { href, label, type = 'button', variant = 'lime', size = 'md', arrow = true, class: cls = '', external = false, ...rest } = Astro.props;
const variants = {
  lime: 'bg-lime text-navy hover:bg-lime-deep',
  navy: 'bg-navy text-cream hover:bg-navy-deep',
  white: 'bg-white text-navy hover:bg-sky',
  ghost: 'bg-transparent text-navy ring-1 ring-inset ring-navy/25 hover:bg-navy/5',
};
const sizes = { md: 'min-h-12 px-6 text-[0.95rem]', sm: 'min-h-11 px-5 text-sm' };
const classes = [
  'group inline-flex items-center justify-center gap-2 rounded-full font-bold tracking-tight transition-colors duration-200 whitespace-nowrap',
  variants[variant],
  sizes[size],
  cls,
];
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---
{
  href ? (
    <a href={href} class:list={classes} {...ext} {...rest}>
      <span>{label}</span>
      {arrow && <Icon name="arrow" size={18} class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />}
      {external && <span class="sr-only">(opens in a new tab)</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <span>{label}</span>
      {arrow && <Icon name="arrow" size={18} />}
    </button>
  )
}
