---
/**
 * Square button with a ↗. On hover a ring spreads from it, like a drop on
 * water. `primary` (the default) is red-coral on light surfaces and marigold
 * inside cobalt (`.on-dark`) sections; `lime` is marigold everywhere.
 * Renders <a> when href is set.
 */
interface Props {
  href?: string;
  label: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'lime' | 'navy' | 'ghost' | 'white' | 'outline-light' | 'coral';
  size?: 'md' | 'sm' | 'lg';
  arrow?: boolean;
  class?: string;
  external?: boolean;
  [key: string]: unknown;
}
const { href, label, type = 'button', variant = 'primary', size = 'md', arrow = true, class: cls = '', external = false, ...rest } = Astro.props;
const variants = {
  primary: 'btn-primary',
  lime: 'bg-marigold text-navy hover:bg-white [--ring:var(--color-marigold)]',
  navy: 'bg-cobalt text-white hover:bg-marigold hover:text-navy [--ring:var(--color-cobalt)]',
  white: 'bg-white text-cobalt hover:bg-marigold hover:text-navy [--ring:#fff]',
  coral: 'bg-coral text-navy hover:bg-marigold [--ring:var(--color-coral)]',
  ghost: 'bg-transparent text-cobalt ring-2 ring-inset ring-cobalt hover:bg-marigold hover:text-navy hover:ring-marigold [--ring:var(--color-cobalt)]',
  'outline-light': 'bg-transparent text-white ring-2 ring-inset ring-white/70 hover:bg-marigold hover:text-navy hover:ring-marigold [--ring:#fff]',
};
const sizes = { lg: 'min-h-14 px-7 text-[1rem]', md: 'min-h-13 px-6 text-[0.95rem]', sm: 'min-h-11 px-5 text-sm' };
const classes = [
  'btn group inline-flex max-w-full items-center justify-center gap-2.5 font-bold transition-colors duration-300 whitespace-nowrap max-[379px]:whitespace-normal',
  variants[variant],
  sizes[size],
  cls,
];
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---
{
  href ? (
    <a href={href} class:list={classes} {...ext} {...rest}>
      <span>{label}</span>
      {arrow && <span aria-hidden="true" class="text-[0.85em] transition-transform duration-500 ease-[var(--ease-calm)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>}
      {external && <span class="sr-only">(opens in a new tab)</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <span>{label}</span>
      {arrow && <span aria-hidden="true" class="text-[0.85em]">↗</span>}
    </button>
  )
}
