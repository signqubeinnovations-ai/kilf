---
/**
 * Ripple rings, the system motif: a drop and one, two or three rings, as on
 * still water. Used for section dividers, wayfinding and venue codes
 * (Sree Narayana Cultural Complex 1, 8 Point Art Cafe 2). Cobalt on light
 * surfaces, marigold on cobalt (`water`/`lake`); `red` marks a highlight.
 * Decorative unless `label` is given.
 */
interface Props {
  n?: 1 | 2 | 3;
  /** Width in px; the height follows (flat rings). */
  size?: number;
  /** `water`/`lake` = marigold (for cobalt sections), `ink`/`cobalt`/`navy` = cobalt, `red`/`coral` = coral. */
  tone?: 'current' | 'water' | 'ink' | 'red' | 'lake' | 'cobalt' | 'coral' | 'navy';
  class?: string;
  label?: string;
}
const { n = 3, size = 40, tone = 'current', class: cls = '', label } = Astro.props;
// On light surfaces rings are cobalt (or coral, teal); on cobalt sections `lake`/`water` read as marigold.
const color = {
  current: 'currentColor',
  water: 'var(--color-marigold)',
  lake: 'var(--color-marigold)',
  ink: 'var(--color-cobalt)',
  cobalt: 'var(--color-cobalt)',
  navy: 'var(--color-cobalt)',
  red: 'var(--color-coral)',
  coral: 'var(--color-coral)',
}[tone];
const radii: [number, number][] = [
  [7.5, 4.2],
  [13, 7.3],
  [18.6, 10.4],
];
---
<svg
  viewBox="0 0 40 24"
  width={size}
  height={Math.round(size * 0.6)}
  class:list={['shrink-0', cls]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <ellipse cx="20" cy="12" rx="2" ry="1.2" fill={color} />
  {radii.slice(0, n).map(([rx, ry]) => (
    <ellipse cx="20" cy="12" rx={rx} ry={ry} fill="none" stroke={color} stroke-width="1.5" vector-effect="non-scaling-stroke" />
  ))}
</svg>
