---
/** Small pill label, e.g. "Proposed" or "Subject to confirmation". */
interface Props { tone?: 'coral' | 'lime' | 'sky' | 'outline' | 'dark'; class?: string }
const { tone = 'coral', class: cls = '' } = Astro.props;
const tones = {
  coral: 'bg-coral/15 text-coral-ink',
  lime: 'bg-lime text-navy',
  sky: 'bg-sky text-navy',
  outline: 'ring-1 ring-inset ring-current text-muted',
  dark: 'bg-white/10 text-lime ring-1 ring-inset ring-white/20',
};
---
<span class:list={['inline-flex items-center gap-1 rounded-full px-3 py-1 text-[0.7rem] font-bold uppercase tracking-[0.14em]', tones[tone], cls]}><slot /></span>
