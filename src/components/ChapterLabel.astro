---
/** Section label in the print style: "01 / THE CITY OPENS ITS PAGES". */
interface Props {
  n: number;
  label: string;
  tone?: 'light' | 'dark' | 'lime' | 'coral';
  class?: string;
}
const { n, label, tone = 'light', class: cls = '' } = Astro.props;
const num = String(n).padStart(2, '0');
const color = { light: 'text-navy', dark: 'text-white/85', lime: 'text-navy', coral: 'text-navy' }[tone];
---
<p class:list={['eyebrow', color, cls]}><span lang="en">{num}</span> <span aria-hidden="true">/</span> {label}</p>
