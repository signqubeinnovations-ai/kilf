---
/** Small uppercase chapter label: "CHAPTER 03 · VOICES" with a short rule. */
interface Props {
  n: number;
  label: string;
  tone?: 'light' | 'dark' | 'lime';
  class?: string;
}
const { n, label, tone = 'light', class: cls = '' } = Astro.props;
const num = String(n).padStart(2, '0');
const dark = tone === 'dark';
---
<p class:list={['flex items-center gap-3 text-[0.75rem] font-bold uppercase tracking-[0.18em]', cls]}>
  <span class:list={[dark ? 'text-mist' : 'text-muted']}>
    Chapter <span class:list={[dark ? 'text-coral' : tone === 'lime' ? 'text-coral-deep' : 'text-coral-ink']}>{num}</span>
    <span aria-hidden="true"> · </span>{label}
  </span>
  <span aria-hidden="true" class:list={['h-px w-10', dark ? 'bg-mist/60' : 'bg-line']}></span>
</p>
