---
import Illustration from './Illustration.astro';
import LakeWaves from './motion/LakeWaves';
import { asset } from '@/lib/images';
/**
 * Full-width lake band. Uses kilf-assets/illustrations/lake-band.jpg when it
 * exists; until then, layered water drifting slowly (Motion).
 */
interface Props { src?: string; alt?: string; class?: string; height?: string }
const {
  src = 'illustrations/lake-band.jpg',
  alt = '',
  class: cls = '',
  height = 'h-40 sm:h-56 lg:h-72',
} = Astro.props;
const real = !asset(src).placeholder;
---
<div class:list={['relative w-full overflow-hidden', real && 'fade-top', height, cls]} aria-hidden={alt ? undefined : 'true'}>
  {real ? <Illustration src={src} alt={alt} class="h-full w-full object-cover object-bottom" /> : <LakeWaves client:visible />}
</div>
