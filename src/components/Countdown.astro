---
import { site } from '@/lib/site';
import { useTranslations, type Lang } from '@/i18n/ui';
/** Live countdown to 31 Dec 2026, 00:00 IST. Server-renders a sensible value. */
interface Props { lang: Lang; tone?: 'light' | 'dark' }
const { lang, tone = 'dark' } = Astro.props;
const t = useTranslations(lang);
const diff = Math.max(0, new Date(site.startISO).getTime() - Date.now());
const d = Math.floor(diff / 86400000);
const h = Math.floor((diff % 86400000) / 3600000);
const m = Math.floor((diff % 3600000) / 60000);
const units = [
  ['days', d, t('countdown.days')],
  ['hours', h, t('countdown.hours')],
  ['minutes', m, t('countdown.minutes')],
] as const;
const dark = tone === 'dark';
---
<div data-countdown={site.startISO} data-live-text={t('countdown.live')} class="text-center">
  <p class:list={['text-xs font-bold uppercase tracking-[0.2em]', dark ? 'text-mist' : 'text-muted']}>{t('countdown.title')}</p>
  <div class="mt-4 flex items-stretch justify-center gap-2.5 sm:gap-4" role="timer" aria-live="off" aria-atomic="true">
    {units.map(([key, val, label], i) => (
      <>
        {i > 0 && <span aria-hidden="true" class:list={['self-center pb-6 text-3xl font-light', dark ? 'text-coral' : 'text-coral-dark']}>:</span>}
        <div class:list={['min-w-[5.5rem] rounded-2xl px-3 py-4 sm:min-w-[7.5rem] sm:px-5', dark ? 'bg-white/8 ring-1 ring-inset ring-white/15' : 'card']}>
          <span data-unit={key} class:list={['block text-[2.6rem] font-light leading-none tabular-nums sm:text-6xl', dark ? 'text-lime' : 'text-blue']}>{String(val).padStart(2, '0')}</span>
          <span class:list={['mt-2 block text-[0.7rem] font-bold uppercase tracking-[0.16em]', dark ? 'text-cream/85' : 'text-muted']}>{label}</span>
        </div>
      </>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
    const target = new Date(root.dataset.countdown!).getTime();
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-unit="${k}"]`)!;
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        const timer = root.querySelector('[role="timer"]');
        if (timer) timer.outerHTML = `<p class="mt-4 font-display text-2xl font-extrabold">${root.dataset.liveText}</p>`;
        return false;
      }
      out('days').textContent = String(Math.floor(diff / 86400000)).padStart(2, '0');
      out('hours').textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2, '0');
      out('minutes').textContent = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
      return true;
    };
    if (tick()) {
      const id = setInterval(() => !tick() && clearInterval(id), 15000);
    }
  });
</script>
