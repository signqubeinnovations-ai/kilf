---
/** Lime stat card with a big light number that counts up when it scrolls in. */
interface Props { value: string; label: string; note?: string; lang?: string }
const { value, label, note, lang } = Astro.props;
const m = value.match(/^([\d,]+)(.*)$/);
const count = m ? Number(m[1].replace(/,/g, '')) : undefined;
---
<div class="flex h-full flex-col justify-between rounded-[1.5rem] bg-lime p-6 text-navy sm:p-7">
  <span class="numeral text-[3.6rem] sm:text-[5rem]" data-count={count} data-suffix={m?.[2]}>{value}</span>
  <span class="mt-6 flex items-baseline justify-between gap-2">
    <span class="eyebrow text-navy" lang={lang}>{label}</span>
    {note && <span class="font-[family-name:var(--font-serif)] text-lg italic text-navy/80" lang={lang}>{note}</span>}
  </span>
</div>
