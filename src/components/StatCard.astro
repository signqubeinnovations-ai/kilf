---
/** A big number over a hairline, counting up when it scrolls in. */
interface Props { value: string; label: string; note?: string; lang?: string }
const { value, label, note, lang } = Astro.props;
const m = value.match(/^([\d,]+)(.*)$/);
const count = m ? Number(m[1].replace(/,/g, '')) : undefined;
---
<div class="flex h-full flex-col-reverse justify-end gap-3 border-t border-line pt-6">
  <span class="flex items-baseline justify-between gap-2">
    <span class="eyebrow text-navy" lang={lang}>{label}</span>
    {note && <span class="text-sm font-medium text-muted" lang={lang}>{note}</span>}
  </span>
  <span class="numeral text-[3.4rem] text-blue-bright sm:text-[4.2rem]">
    <span data-count={count}>{m ? m[1] : value}</span>{m?.[2] && <span>{m[2]}</span>}
  </span>
</div>
