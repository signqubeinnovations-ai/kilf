---
/** A big light number over a hairline, counting up when it scrolls in. */
interface Props { value: string; label: string; note?: string; lang?: string }
const { value, label, note, lang } = Astro.props;
const m = value.match(/^([\d,]+)(.*)$/);
const count = m ? Number(m[1].replace(/,/g, '')) : undefined;
---
<div class="flex h-full flex-col-reverse justify-end gap-2 border-t border-navy/15 pt-6">
  <span class="flex items-baseline justify-between gap-2">
    <span class="eyebrow text-muted" lang={lang}>{label}</span>
    {note && <span class="font-[family-name:var(--font-serif)] text-lg italic text-navy/70" lang={lang}>{note}</span>}
  </span>
  <span class="numeral text-[3.4rem] text-navy sm:text-[4.4rem]">
    <span data-count={count}>{m ? m[1] : value}</span>{m?.[2] && <span class="text-coral-dark">{m[2]}</span>}
  </span>
</div>
