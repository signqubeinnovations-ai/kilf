---
import { Image } from 'astro:assets';
import { asset } from '@/lib/images';
/**
 * A speaker portrait in a large rounded rectangle (4:5). Until the real
 * duotone photo is in kilf-assets/speakers/, a blue duotone stand-in shows
 * the speaker's initials in live type (no fonts needed at build time).
 */
interface Props {
  name: string;
  photo: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  eager?: boolean;
}
const { name, photo, sizes = '(min-width: 1024px) 280px, (min-width: 640px) 33vw, 50vw', widths = [320, 480, 640], class: cls = '', eager = false } = Astro.props;
const { src, placeholder } = asset(`speakers/${photo}`);
const initials = name
  .replace(/\./g, ' ')
  .split(/\s+/)
  .filter((w) => w.length > 1 || /[A-Z]/.test(w))
  .slice(-2)
  .map((w) => w[0].toUpperCase())
  .join('');
// Three close, quiet tints so a grid of stand-ins doesn't look cloned.
const moods = [
  'linear-gradient(165deg, #F1F4FC 0%, #D9E1F8 55%, #BCC8F1 100%)',
  'linear-gradient(200deg, #F4F6FC 0%, #DDE4F8 50%, #C6D0F3 100%)',
  'linear-gradient(145deg, #EDF1FB 0%, #D2DBF6 60%, #B3C0EF 100%)',
];
let hash = 0;
for (const c of name) hash = (hash * 31 + c.charCodeAt(0)) >>> 0;
const mood = moods[hash % moods.length];
---
<div class:list={['relative aspect-[4/5] overflow-hidden rounded-[1.5rem] bg-sky', cls]}>
  {
    placeholder ? (
      <div class="absolute inset-0" style={`background:${mood}`} role="img" aria-label={`Portrait of ${name} (photo to come)`}>
        <svg class="absolute -right-10 -top-10 size-56 text-white/70 transition-transform duration-[1.4s] ease-[var(--ease-calm)] group-hover:scale-110" viewBox="0 0 200 200" fill="none" stroke="currentColor" aria-hidden="true">
          <circle cx="100" cy="100" r="30" stroke-width="1.5" />
          <circle cx="100" cy="100" r="58" stroke-width="1.2" />
          <circle cx="100" cy="100" r="86" stroke-width="1" />
        </svg>
        <span class="absolute bottom-4 left-5 font-[family-name:var(--font-serif)] text-[4.2rem] italic leading-none text-navy/80 sm:text-[4.8rem]" aria-hidden="true">{initials}</span>
      </div>
    ) : (
      <Image
        src={src}
        alt={`Portrait of ${name}`}
        widths={widths.filter((w) => w <= src.width).length ? widths.filter((w) => w <= src.width) : [src.width]}
        sizes={sizes}
        class="size-full object-cover transition-transform duration-700 ease-[var(--ease-calm)] group-hover:scale-[1.04]"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )
  }
  <slot />
</div>
