---
import Illustration from '@/components/Illustration.astro';
/**
 * Khasakkinte Ithihasam as a book that opens into a stage. The cover swings
 * open around the spine, a few pages turn after it, and the spread shows the
 * title page and the stage. How far it is open comes from `--p` (0 closed,
 * 1 open) on an ancestor: the home page ties it to scrolling. Without that
 * (no script, reduced motion) the book is shown open.
 */
interface Props {
  novel: string;
  staged: string;
  when: string;
  class?: string;
}
const { novel, staged, when, class: cls = '' } = Astro.props;
---
<div class:list={['book', cls]} data-book>
  <div class="book-shadow" aria-hidden="true"></div>
  <div class="book-3d">
    <!-- The right-hand page: the stage -->
    <div class="page page-right">
      <div class="plate">
        <Illustration src="illustrations/p4_stage.jpg" alt="" sizes="(min-width: 1024px) 24vw, 70vw" class="absolute inset-0 h-full w-full object-cover object-[64%_center]" />
        <div class="plate-light" aria-hidden="true"></div>
      </div>
      <p class="plate-caption">{when}</p>
    </div>

    <!-- Pages that turn after the cover; the last one carries the title page -->
    <div class="leaf" style="--i:3">
      <div class="face face-front lines" aria-hidden="true"></div>
      <div class="face face-back title-page">
        <p class="tp-kicker">{novel}</p>
        <p class="tp-ml" lang="ml">ഖസാക്കിന്റെ<br />ഇതിഹാസം</p>
        <p class="tp-en">Khasakkinte Ithihasam</p>
        <span class="tp-rule" aria-hidden="true"></span>
        <p class="tp-staged">{staged}</p>
      </div>
    </div>
    <div class="leaf" style="--i:2" aria-hidden="true">
      <div class="face face-front lines"></div>
      <div class="face face-back lines"></div>
    </div>
    <div class="leaf" style="--i:1" aria-hidden="true">
      <div class="face face-front lines"></div>
      <div class="face face-back lines"></div>
    </div>

    <!-- The cover -->
    <div class="leaf cover" style="--i:0">
      <div class="face face-front cover-front">
        <div class="cover-frame">
          <p class="cv-author">O. V. VIJAYAN</p>
          <svg class="cv-emblem" viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="50" r="30" fill="#ff8870" />
            <g fill="#f7cf97">
              <path d="M58 108c2-22 3-40 2-58h3c1 18 0 36-2 58z" />
              <path d="M61 50c-10-8-24-9-34-3 10-1 22 1 34 5zM61 50c-6-11-18-17-30-16 10 3 20 9 30 16zM61 50c1-12-4-24-12-30 5 9 8 19 12 30zM61 50c7-10 19-14 31-12-10 2-21 6-31 12zM61 50c11-5 25-4 34 3-10-2-22-2-34-3zM61 50c9 3 18 11 21 21-6-8-13-14-21-21zM61 50c-9 4-16 12-18 22 5-8 11-15 18-22z" />
            </g>
          </svg>
          <p class="cv-ml" lang="ml">ഖസാക്കിന്റെ<br />ഇതിഹാസം</p>
          <p class="cv-en">Khasakkinte Ithihasam</p>
          <p class="cv-foot">KILF 2027 · On stage</p>
        </div>
      </div>
      <div class="face face-back endpaper" aria-hidden="true"></div>
    </div>
  </div>
</div>

<style>
  /* The spread is the box; one page is half of it. Sizes use its width (cqw). */
  .book {
    --travel: 1;
    position: relative;
    aspect-ratio: 2 / 1.42;
    container-type: inline-size;
    perspective: 2600px;
  }
  /* Phones: the right-hand page is centred and large; the cover swings out to the left. */
  @media (max-width: 1023px) {
    .book {
      --travel: 0;
      --pw: min(72vw, 21rem);
      width: calc(2 * var(--pw));
      margin-left: calc(50% - 1.5 * var(--pw));
    }
  }
  @media (min-width: 1024px) {
    .book {
      width: min(100%, calc((100svh - 14rem) * 2 / 1.42));
      margin-inline: auto;
    }
  }
  .book-3d {
    /* Closed, the cover sits centred; open, the spread does. */
    --s: clamp(0, calc((var(--p, 1) - 0.06) / 0.5), 1);
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateX(calc((1 - var(--s)) * -25% * var(--travel))) rotateX(calc(14deg - var(--s) * 6deg));
  }
  .page,
  .leaf {
    position: absolute;
    top: 1.2%;
    left: 50%;
    width: 48.8%;
    height: 97.6%;
  }
  .page-right {
    display: flex;
    flex-direction: column;
    padding: 3.2cqw 3cqw 2.4cqw;
    background: linear-gradient(90deg, #e9e2cc 0%, #fbf8ee 7%, #fffdf4 60%, #f6f1e2 100%);
    box-shadow:
      1px 0 0 #e7dfc8,
      3px 0 0 #fffdf4,
      4px 0 0 #e2d9c0,
      6px 0 0 #fbf8ee,
      7px 0 0 #ddd3b8;
  }
  .plate {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: #0a1250;
  }
  /* The stage lights up once the book is open. */
  .plate-light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 38% at 46% 88%, rgb(255 227 216 / 0.55), transparent 70%),
      linear-gradient(180deg, rgb(255 227 216 / 0.28), transparent 60%);
    mix-blend-mode: screen;
    opacity: clamp(0, calc((var(--p, 1) - 0.62) / 0.3), 1);
  }
  .plate-caption {
    margin-top: 1.6cqw;
    font-size: 1.35cqw;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4b5573;
    text-align: center;
  }

  .leaf {
    transform-origin: left center;
    transform-style: preserve-3d;
    /* Each turns a moment after the one above it, then lies on the left. */
    --start: calc(0.06 + var(--i) * 0.09);
    --t: clamp(0, calc((var(--p, 1) - var(--start)) / 0.44), 1);
    --e: calc(var(--t) * var(--t) * (3 - 2 * var(--t)));
    transform: rotateY(calc(var(--e) * -180deg)) translateZ(calc((4 - var(--i)) * 1px));
  }
  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: #fffdf4;
  }
  .face-back {
    transform: rotateY(180deg);
  }
  /* Blank pages suggest lines of text. */
  .lines {
    background:
      linear-gradient(90deg, rgb(16 27 70 / 0.05), transparent 12%),
      repeating-linear-gradient(180deg, transparent 0 1.25cqw, rgb(16 27 70 / 0.09) 1.25cqw 1.42cqw) 3.4cqw 4.4cqw / calc(100% - 6.8cqw) calc(100% - 8.8cqw) no-repeat,
      #fcf9ef;
  }
  .face-back.lines {
    background:
      linear-gradient(270deg, rgb(16 27 70 / 0.06), transparent 12%),
      repeating-linear-gradient(180deg, transparent 0 1.25cqw, rgb(16 27 70 / 0.09) 1.25cqw 1.42cqw) 3.4cqw 4.4cqw / calc(100% - 6.8cqw) calc(100% - 8.8cqw) no-repeat,
      #fcf9ef;
  }
  .title-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4cqw;
    text-align: center;
    color: var(--color-navy);
    background: linear-gradient(270deg, rgb(16 27 70 / 0.07), transparent 14%), #fffdf4;
  }
  .tp-kicker {
    font-size: 1.3cqw;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #a3391f;
  }
  .tp-ml {
    margin-top: 2.6cqw;
    font-family: var(--font-ml, 'Anek Malayalam'), sans-serif;
    font-size: 4.6cqw;
    font-weight: 700;
    line-height: 1.15;
  }
  .tp-en {
    margin-top: 1.4cqw;
    font-family: var(--font-display);
    font-size: 2.2cqw;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tp-rule {
    display: block;
    width: 6cqw;
    height: 2px;
    margin: 2.6cqw auto;
    background: #ff8870;
  }
  .tp-staged {
    font-size: 1.55cqw;
    line-height: 1.5;
    color: #4b5573;
  }

  .cover {
    top: 0;
    height: 100%;
    width: 50%;
  }
  .cover-front {
    padding: 2.2cqw;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.35), rgb(255 255 255 / 0.06) 3%, transparent 7%),
      radial-gradient(ellipse at 70% 20%, rgb(255 255 255 / 0.08), transparent 60%),
      linear-gradient(160deg, #1b3a9e, #152f81 45%, #0e1d5c);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .cover-frame {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding: 3.2cqw 2.4cqw 2.4cqw;
    text-align: center;
    color: #f7cf97;
    border: 1px solid rgb(247 207 151 / 0.55);
    outline: 1px solid rgb(247 207 151 / 0.25);
    outline-offset: -0.9cqw;
  }
  .cv-author {
    font-size: 1.35cqw;
    font-weight: 700;
    letter-spacing: 0.3em;
  }
  .cv-emblem {
    width: 16cqw;
    margin-top: 3cqw;
  }
  .cv-ml {
    margin-top: auto;
    font-family: var(--font-ml, 'Anek Malayalam'), sans-serif;
    font-size: 5cqw;
    font-weight: 700;
    line-height: 1.12;
    color: #fbe2bd;
  }
  .cv-en {
    margin-top: 1.2cqw;
    font-family: var(--font-display);
    font-size: 1.9cqw;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .cv-foot {
    margin-top: 3cqw;
    font-size: 1.1cqw;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(247 207 151 / 0.7);
  }
  /* Inside the cover: a patterned endpaper, as in a cloth-bound book. */
  .endpaper {
    background:
      linear-gradient(270deg, rgb(0 0 0 / 0.3), transparent 8%),
      repeating-linear-gradient(45deg, rgb(247 207 151 / 0.1) 0 0.35cqw, transparent 0.35cqw 1.6cqw),
      repeating-linear-gradient(-45deg, rgb(247 207 151 / 0.1) 0 0.35cqw, transparent 0.35cqw 1.6cqw),
      #152f81;
  }
  .book-shadow {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -6%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.55), transparent 70%);
    filter: blur(6px);
    transform: translateX(calc((1 - clamp(0, calc((var(--p, 1) - 0.06) / 0.5), 1)) * -12% * var(--travel))) scaleX(calc(0.55 + clamp(0, calc((var(--p, 1) - 0.06) / 0.5), 1) * 0.45));
  }
</style>
