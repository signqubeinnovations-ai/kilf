---
/**
 * Pauses or resumes every looping animation on the site (WCAG 2.2.2).
 * The choice is remembered on this device. All toggles on a page stay in sync.
 */
interface Props { tone?: 'light' | 'dark'; class?: string; lang?: 'en' | 'ml' }
const { tone = 'dark', class: cls = '', lang = 'en' } = Astro.props;
const labels = lang === 'ml' ? { pause: 'ചലനം നിർത്തുക', play: 'ചലനം തുടരുക' } : { pause: 'Pause motion', play: 'Play motion' };
---
<button
  type="button"
  data-motion-toggle
  data-pause={labels.pause}
  data-play={labels.play}
  aria-pressed="false"
  class:list={[
    'inline-flex min-h-11 shrink-0 items-center gap-2.5 whitespace-nowrap px-4 text-sm font-medium transition-colors',
    tone === 'dark' ? 'text-white ring-1 ring-inset ring-white/35 hover:bg-white/10' : 'text-navy ring-1 ring-inset ring-navy/30 hover:bg-navy/5',
    cls,
  ]}
>
  <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
    <path data-icon-pause d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor" />
    <path data-icon-play d="M8 5.5v13l10.5-6.5Z" fill="currentColor" class="hidden" />
  </svg>
  <span data-label>{labels.pause}</span>
</button>

<script>
  const root = document.documentElement;
  const sync = () => {
    const paused = root.dataset.motion === 'paused';
    document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(paused));
      b.querySelector('[data-label]')!.textContent = paused ? b.dataset.play! : b.dataset.pause!;
      b.querySelector('[data-icon-pause]')!.classList.toggle('hidden', paused);
      b.querySelector('[data-icon-play]')!.classList.toggle('hidden', !paused);
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const paused = root.dataset.motion !== 'paused';
      if (paused) root.dataset.motion = 'paused';
      else delete root.dataset.motion;
      try {
        localStorage.setItem('kilf-motion', paused ? 'paused' : 'on');
      } catch {}
      window.dispatchEvent(new Event('kilf:motion'));
    }),
  );
  window.addEventListener('kilf:motion', sync);
  sync();
</script>
