---
import Icon from './Icon.astro';
import Fill from './Fill.astro';
import { site, addressLine, telUrl, waFor, directionsUrl, real } from '@/lib/site';
import { getCollection } from 'astro:content';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="site-footer s-charcoal">
  <div class="wrap">
    <div class="grid-12 top">
      <div class="col-brand">
        <img src="/brand/wordmark-cream.svg" alt="FACADO" width="2000" height="430" loading="lazy" class="f-logo" />
        <img src="/brand/tagline-cream.svg" alt="Exterior Design Studio" width="2000" height="98" loading="lazy" class="f-tag" />
        <p class="body-copy f-entity">{site.entity}. We design, 3D-visualise, fabricate and install ACP facades across Kerala.</p>
      </div>
      <div class="col">
        <h2 class="f-h">Services</h2>
        <ul>{services.map((s) => <li><a href={`/${s.id}`}>{s.data.navLabel}</a></li>)}</ul>
      </div>
      <div class="col">
        <h2 class="f-h">Studio</h2>
        <ul>
          <li><a href="/about">About & process</a></li>
          <li><a href="/journal">Journal</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="col col-nap">
        <h2 class="f-h">Visit</h2>
        <address>
          <strong>{site.name}</strong><br />
          <span><Fill value={site.address.street} />, {site.address.locality}, {site.address.district}, {site.address.region} <Fill value={site.address.postalCode} /></span>
        </address>
        <p><a href={telUrl} data-track="call_click">{site.phoneDisplay}</a></p>
        <p><a href={waFor('building')} target="_blank" rel="noopener" data-track="whatsapp_click">WhatsApp {site.phoneDisplay}</a></p>
        {site.officePhones.map((ph) => <p><a href={`tel:${ph.e164}`} data-track="call_click">Office {ph.display}</a></p>)}
        <p>{real(site.email) ? <a href={`mailto:${site.email}`}>{site.email}</a> : <Fill value={site.email} />}</p>
        <p class="muted"><Fill value={site.hoursDisplay} /></p>
        <p><a href={directionsUrl()} target="_blank" rel="noopener" class="link-arrow">Directions</a></p>
        <div class="social">
          {real(site.social.instagram) && <a href={site.social.instagram} aria-label="FACADO on Instagram" rel="noopener" target="_blank"><Icon name="insta" /></a>}
          {real(site.social.facebook) && <a href={site.social.facebook} aria-label="FACADO on Facebook" rel="noopener" target="_blank"><Icon name="fb" /></a>}
        </div>
      </div>
    </div>
    <div class="bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Areas we serve: {site.areasServed.join(', ')} <Fill value={site.areasNote} /></p>
      <p><a href="/privacy">Privacy</a> · <button type="button" class="linkish" data-consent-open>Cookie settings</button></p>
    </div>
  </div>
</footer>
<style>
  .site-footer { padding: clamp(4rem, 8vw, 7rem) 0 calc(2rem + var(--mbar, 0px)); }
  .top { row-gap: 3rem; }
  .col-brand { grid-column: span 12; }
  .col { grid-column: span 6; }
  .col-nap { grid-column: span 12; }
  @media (min-width: 64rem) { .col-brand { grid-column: 1 / span 4; } .col { grid-column: span 2; } .col:first-of-type { grid-column: 6 / span 2; } .col-nap { grid-column: 10 / span 3; } }
  .f-logo { width: 11rem; }
  .f-tag { width: 11rem; margin-top: 0.6rem; }
  .f-entity { margin-top: 1.5rem; max-width: 34ch; font-size: 0.98rem; }
  .f-h { font-size: 0.85rem; letter-spacing: 0.22em; color: var(--accent); margin-bottom: 1.1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; }
  a { text-decoration: none; }
  ul a { display: inline-flex; min-height: 40px; align-items: center; font-weight: 600; letter-spacing: 0.06em; }
  ul a:hover, .col-nap a:hover { color: var(--accent); }
  address { font-style: normal; margin-bottom: 0.75rem; line-height: 1.45; }
  .col-nap p { min-height: 32px; display: flex; align-items: center; }
  .social { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
  .social a { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--rule); }
  .social :global(svg) { width: 20px; }
  .bottom { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; justify-content: space-between; font-size: 0.9rem; color: var(--muted); }
  .linkish { background: none; border: 0; padding: 0; color: inherit; font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 0.2em; min-height: 32px; }
</style>
