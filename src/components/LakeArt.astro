---
import { Picture } from 'astro:assets';
import { arts } from '@/lib/lake-art';
/**
 * One of the festival's lake illustrations, still: a responsive <picture>.
 * (The home hero adds its one ripple and the karimeen in HeroLake.astro.)
 */
interface Props {
  art: 'hero' | 'jetty';
  class?: string;
  sizes?: string;
  priority?: boolean;
  /** object-position, 0–1 on each axis. */
  focus?: [number, number];
  /** Classes for the <img>, e.g. responsive object-position; replaces `focus` for the picture. */
  imgClass?: string;
  alt?: string;
}
const { art, class: cls = '', sizes = '100vw', priority = false, focus = [0.5, 0.5], alt, imgClass } = Astro.props;
const a = arts[art];
---
<div class:list={['relative isolate overflow-hidden bg-lake-soft', cls]}>
  <Picture
    src={a.img}
    alt={alt ?? a.alt}
    formats={['avif', 'webp']}
    widths={[...a.widths]}
    sizes={sizes}
    class:list={['absolute inset-0 size-full object-cover', imgClass]}
    style={imgClass ? undefined : `object-position:${focus[0] * 100}% ${focus[1] * 100}%`}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
  <slot />
</div>
