---
import Logo from './Logo.astro';
import LimeButton from './LimeButton.astro';
import Icon from './Icon.astro';
import { site } from '@/lib/site';
import { useTranslations, localizePath, languages, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  /** Float over a dark hero, turning solid once the page scrolls. */
  overlay?: boolean;
}
const { lang, path, overlay = false } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);

const nav = [
  { href: '/about', label: t('nav.about') },
  { href: '/speakers', label: t('nav.speakers') },
  { href: '/programme', label: t('nav.programme') },
  { href: '/get-involved', label: t('nav.involved') },
  { href: '/passes', label: t('nav.passes') },
  { href: '/visit', label: t('nav.visit') },
];
const more = [
  { href: '/khasak', label: t('nav.khasak') },
  { href: '/youth', label: t('nav.youth') },
  { href: '/partners', label: t('nav.partners') },
  { href: '/faq', label: t('nav.faq') },
  { href: '/contact', label: t('nav.contact') },
];
const other: Lang = lang === 'en' ? 'ml' : 'en';
const toggleHref = localizePath(path, other);
// Malayalam labels are longer, so the full nav needs more room.
const wide = lang === 'ml';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header class="site-header" data-header data-overlay={overlay ? '' : undefined}>
  <div class="bar">
    <div class="container-kilf flex h-[var(--hh)] items-center justify-between gap-4">
      <a href={lp('/')} class="-ml-1 flex min-h-11 items-center gap-3.5 rounded-md px-1">
        <Logo decorative class="h-9 lg:h-10" />
        <span class="desc hidden border-l pl-3.5 text-[0.66rem] font-bold uppercase leading-[1.3] tracking-[0.16em] xl:block" lang="en">
          Kollam International<br />Literature Festival
        </span>
        <span class="sr-only">KILF 2027 — {t('nav.home')}</span>
      </a>

      <nav aria-label={t('nav.primary')} class:list={['hidden', wide ? 'xl:block' : 'lg:block']}>
        <ul class="flex items-center gap-0.5 xl:gap-1.5">
          {nav.map((item) => (
            <li>
              <a href={lp(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined} class="nav-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href={toggleHref} hreflang={other} lang={other} class="lang inline-flex min-h-11 items-center rounded-full px-3.5 text-sm font-bold ring-1 ring-inset transition-colors">
          {languages[other]}
        </a>
        <span class="hidden sm:contents"><LimeButton href={lp('/get-involved#register')} label={t('cta.register')} size="sm" /></span>
        <button
          type="button"
          class:list={['menu-btn inline-grid size-11 place-items-center rounded-full ring-1 ring-inset', wide ? 'xl:hidden' : 'lg:hidden']}
          aria-controls="mobile-menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <span class="sr-only" data-open-label>{t('nav.menu')}</span>
          <span class="sr-only hidden" data-close-label>{t('nav.close')}</span>
          <Icon name="menu" size={22} class="menu-icon" />
          <Icon name="close" size={22} class="close-icon hidden" />
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class:list={['menu on-dark', wide ? 'xl:hidden' : 'lg:hidden']} data-menu data-wide={wide ? '' : undefined}>
    <nav aria-label={t('nav.primary')} class="container-kilf flex min-h-full flex-col pb-10 pt-[calc(var(--hh)+1.5rem)]">
      <ul class="flex-1">
        {[...nav, ...more].map((item, i) => (
          <li style={`--i:${i}`}>
            <a
              href={lp(item.href)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="menu-link flex min-h-12 items-center justify-between border-b border-white/10 py-2.5 font-display text-[1.7rem] font-semibold tracking-tight text-cream aria-[current=page]:text-lime"
            >
              {item.label}
              <Icon name="arrow" size={22} class="text-coral" />
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-col gap-4">
        <LimeButton href={lp('/get-involved#register')} label={t('cta.register')} class="w-full" />
        <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center justify-center gap-2 text-sm text-mist">
          <Icon name="mail" size={18} class="text-lime" />{site.email}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --fg: var(--color-navy);
    --bg: color-mix(in oklab, var(--color-cream) 93%, transparent);
    --edge: color-mix(in oklab, var(--color-line) 80%, transparent);
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--fg);
  }
  .site-header[data-overlay] {
    position: fixed;
    inset-inline: 0;
  }
  :global(.has-js) .site-header[data-overlay]:not([data-solid]),
  .site-header[data-menu-open] {
    --fg: #fff;
    --bg: transparent;
    --edge: transparent;
  }
  .bar {
    position: relative;
    z-index: 2;
    background: var(--bg);
    border-bottom: 1px solid var(--edge);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    transition: background-color 0.5s var(--ease-calm), border-color 0.5s var(--ease-calm), color 0.5s var(--ease-calm);
  }
  :global(.has-js) .site-header[data-overlay]:not([data-solid]) .bar,
  .site-header[data-menu-open] .bar {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .desc {
    border-color: color-mix(in oklab, currentColor 30%, transparent);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.55rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-coral);
    transform: scaleX(0);
    transition: transform 0.5s var(--ease-calm);
  }
  .nav-link:hover {
    opacity: 1;
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .lang,
  .menu-btn {
    --tw-ring-color: color-mix(in oklab, currentColor 30%, transparent);
  }
  .lang:hover,
  .menu-btn:hover {
    background: color-mix(in oklab, currentColor 8%, transparent);
  }

  /* Mobile menu opens like a ripple from the menu button */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    background: var(--color-navy);
    clip-path: circle(0% at calc(100% - 2.6rem) 2.1rem);
    visibility: hidden;
    transition: clip-path 0.7s var(--ease-calm), visibility 0s linear 0.7s;
  }
  .menu[data-open] {
    clip-path: circle(150% at calc(100% - 2.6rem) 2.1rem);
    visibility: visible;
    transition: clip-path 0.9s var(--ease-calm);
  }
  .menu li {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.6s var(--ease-calm);
  }
  .menu[data-open] li {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.12s + var(--i) * 0.035s);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header?.hasAttribute('data-overlay')) {
    const solid = () => header.toggleAttribute('data-solid', window.scrollY > 24);
    solid();
    window.addEventListener('scroll', solid, { passive: true });
  }

  if (header && btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
      header.toggleAttribute('data-menu-open', open);
      btn.querySelector('.menu-icon')?.classList.toggle('hidden', open);
      btn.querySelector('.close-icon')?.classList.toggle('hidden', !open);
      btn.querySelector('[data-open-label]')?.classList.toggle('hidden', open);
      btn.querySelector('[data-close-label]')?.classList.toggle('hidden', !open);
      document.documentElement.classList.toggle('overflow-hidden', open);
      if (open) setTimeout(() => menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true }), 250);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    matchMedia(menu.hasAttribute('data-wide') ? '(min-width: 1280px)' : '(min-width: 1024px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>
