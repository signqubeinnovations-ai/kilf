---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, waFor, telUrl, site } from '@/lib/site';
interface Props { animateLogo?: boolean; waContext?: string; }
const { animateLogo = false, waContext = 'building' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href !== '/#what-we-build' && (path === href || path.startsWith(href + '/'));
---
<header class="site-header s-rust" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="FACADO LLP home"><Logo animate={animateLogo} class="brand-logo" /></a>
    <nav class="nav-desk" aria-label="Main">
      <ul>{nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
    </nav>
    <a class="btn btn-primary head-wa" href={waFor(waContext)} target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="wa" class="wa-ic" /><span>WhatsApp</span></a>
    <button class="menu-btn" popovertarget="menu" aria-label="Open menu"><Icon name="menu" /></button>
  </div>
  <div id="menu" popover class="menu s-charcoal">
    <div class="menu-top wrap">
      <Logo class="brand-logo" />
      <button class="menu-btn" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu"><Icon name="close" /></button>
    </div>
    <nav class="wrap" aria-label="Mobile">
      <ol class="menu-list">
        {nav.map((n, i) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}><span class="num">{String(i + 1).padStart(2, '0')}</span>{n.label}</a></li>)}
      </ol>
      <div class="menu-cta">
        <a class="btn btn-primary" href={waFor(waContext)} target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="wa" class="wa-ic" /><span>WhatsApp us</span></a>
        <a class="btn btn-ghost" href={telUrl} data-track="call_click"><Icon name="phone" class="arrow" /><span>{site.phoneDisplay}</span></a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; transition: transform 0.5s var(--ease); view-transition-name: site-header; }
  .site-header[data-hidden] { transform: translateY(-100%); }
  .site-header[data-scrolled]::after { content: ''; position: absolute; inset: auto 0 0; height: 1px; background: var(--rule); }
  .bar { display: flex; align-items: center; gap: 2rem; height: 4.5rem; }
  .brand { display: inline-flex; align-items: center; min-height: 44px; margin-right: auto; }
  :global(.brand-logo) { width: clamp(7.5rem, 10vw, 9.5rem); }
  .nav-desk ul { display: flex; gap: clamp(1rem, 2vw, 2.25rem); list-style: none; margin: 0; padding: 0; }
  .nav-desk a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; font-size: 0.9rem; position: relative; }
  .nav-desk a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 8px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease); }
  .nav-desk a:hover::after, .nav-desk a[aria-current]::after { transform: none; }
  .head-wa { --h: 2.75rem; padding: 0 1.1rem; font-size: 0.9rem; }
  .menu-btn { display: none; width: 48px; height: 48px; place-items: center; background: none; border: 1px solid var(--rule); color: var(--fg); cursor: pointer; }
  .menu-btn :global(svg) { width: 22px; height: 22px; }
  @media (max-width: 64rem) {
    .nav-desk, .head-wa { display: none; }
    .menu-btn { display: grid; }
  }
  .menu { position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0 0 2rem; border: 0; overflow-y: auto; }
  .menu:popover-open { display: flex; flex-direction: column; gap: 2rem; }
  .menu-top { display: flex; align-items: center; justify-content: space-between; height: 4.5rem; }
  .menu-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .menu-list li { border-bottom: 1px solid var(--rule); }
  .menu-list a { display: flex; align-items: baseline; gap: 1.25rem; padding: 1rem 0; font-size: var(--step-2); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; }
  .menu-list .num { font-size: 0.9rem; }
  .menu-cta { display: grid; gap: 0.75rem; margin-top: 2rem; }
  @media (prefers-reduced-motion: no-preference) {
    .menu { opacity: 0; transform: translateY(-12px); transition: opacity 0.4s var(--ease), transform 0.5s var(--ease), display 0.5s allow-discrete, overlay 0.5s allow-discrete; }
    .menu:popover-open { opacity: 1; transform: none; }
    @starting-style { .menu:popover-open { opacity: 0; transform: translateY(-12px); } }
  }
</style>
