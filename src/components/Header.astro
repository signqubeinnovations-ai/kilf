---
import Logo from './Logo.astro';
import LimeButton from './LimeButton.astro';
import Icon from './Icon.astro';
import Rings from './Rings.astro';
import { site } from '@/lib/site';
import { useTranslations, localizePath, languages, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  /** Float over the illustrated hero, turning solid once the page scrolls. */
  overlay?: boolean;
}
const { lang, path, overlay = false } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);

// Five in the bar; everything else lives in the menu (and the footer).
const nav = [
  { href: '/about', label: t('nav.about') },
  { href: '/programme', label: t('nav.programme') },
  { href: '/speakers', label: t('nav.speakers') },
  { href: '/visit', label: t('nav.visit') },
  { href: '/passes', label: t('nav.passes') },
];
const more = [
  { href: '/khasak', label: t('nav.theatre') },
  { href: '/youth', label: t('nav.youth') },
  { href: '/cause', label: t('nav.cause') },
  { href: '/get-involved', label: t('nav.involved') },
  { href: '/partners', label: t('nav.partners') },
  { href: '/faq', label: t('nav.faq') },
  { href: '/contact', label: t('nav.contact') },
];
const other: Lang = lang === 'en' ? 'ml' : 'en';
const toggleHref = localizePath(path, other);
// The full logo is wide, so the links show from xl (Malayalam labels run longer: 2xl).
const wide = lang === 'ml';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header class="site-header" data-header data-overlay={overlay ? '' : undefined}>
  <div class="bar">
    <div class="container-kilf flex h-[var(--hh)] items-center justify-between gap-4">
      <a href={lp('/')} class="-ml-1 flex min-h-11 shrink-0 items-center px-1">
        <Logo decorative class="[--h:2.5rem] lg:[--h:2.85rem]" />
        <span class="sr-only">Kollam International Literature Festival 2027 — {t('nav.home')}</span>
      </a>

      <nav aria-label={t('nav.primary')} class:list={['hidden', wide ? '2xl:block' : 'xl:block']}>
        <ul class="flex items-center gap-0.5 xl:gap-1.5">
          {nav.map((item) => (
            <li>
              <a href={lp(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined} class="nav-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href={toggleHref} hreflang={other} lang={other} class="lang hidden min-h-11 items-center px-3.5 text-sm font-semibold ring-1 ring-inset transition-colors sm:inline-flex">
          {languages[other]}
        </a>
        <span class="hidden sm:contents"><LimeButton href={lp('/get-involved#register')} label={t('cta.register')} size="sm" class="hdr-cta" /></span>
        <button
          type="button"
          class="menu-btn inline-flex min-h-11 min-w-11 items-center justify-center gap-2 px-3 text-sm font-semibold ring-1 ring-inset"
          aria-controls="site-menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <span class="hidden lg:inline" aria-hidden="true" data-open-text>{t('nav.menu')}</span>
          <span class="sr-only" data-open-label>{t('nav.menu')}</span>
          <span class="sr-only hidden" data-close-label>{t('nav.close')}</span>
          <Icon name="menu" size={20} class="menu-icon" />
          <Icon name="close" size={20} class="close-icon hidden" />
        </button>
      </div>
    </div>
  </div>

  <div id="site-menu" class="menu on-dark" data-menu>
    <div class="container-kilf flex min-h-full flex-col pb-10 pt-[calc(var(--hh)+1.5rem)]">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <nav aria-label={t('nav.festival')} class="lg:col-span-6">
          <p class="eyebrow flex items-center gap-3 text-white/70"><Rings n={1} size={26} tone="water" />{t('nav.festival')}</p>
          <ul class="mt-4">
            {nav.map((item) => (
              <li>
                <a href={lp(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined} class="menu-link big">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label={t('nav.more')} class="lg:col-span-6">
          <p class="eyebrow flex items-center gap-3 text-white/70"><Rings n={2} size={26} tone="water" />{t('nav.more')}</p>
          <ul class="mt-4">
            {more.map((item) => (
              <li>
                <a href={lp(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined} class="menu-link">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="mt-auto flex flex-col gap-5 pt-12 sm:flex-row sm:items-center sm:justify-between">
        <div class="grid grid-cols-2 gap-3 sm:flex">
          <LimeButton href={lp('/get-involved#register')} label={t('cta.register')} />
          <LimeButton href={lp('/get-involved#volunteer')} label={t('cta.volunteer')} variant="outline-light" />
        </div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href={toggleHref} hreflang={other} lang={other} class="inline-flex min-h-11 items-center px-3.5 text-sm font-semibold text-white ring-1 ring-inset ring-white/40 hover:bg-white/10 sm:hidden">
            {languages[other]}
          </a>
          <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center gap-2 text-sm text-white/80 hover:text-white">
            <Icon name="mail" size={18} class="text-water-light" />{site.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    --fg: var(--color-ink);
    --bg: color-mix(in oklab, var(--color-canvas) 94%, transparent);
    --edge: var(--color-line);
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--fg);
  }
  .site-header[data-overlay] {
    position: fixed;
    inset-inline: 0;
  }
  /* Over the hero: no bar, the sky shows through */
  :global(.has-js) .site-header[data-overlay]:not([data-solid]) {
    --bg: transparent;
    --edge: transparent;
  }
  .site-header[data-menu-open] {
    --fg: #fff;
    --bg: transparent;
    --edge: rgb(255 255 255 / 0.14);
  }
  .bar {
    position: relative;
    z-index: 2;
    background: var(--bg);
    border-bottom: 1px solid var(--edge);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
  }
  :global(.has-js) .site-header[data-overlay]:not([data-solid]) .bar,
  .site-header[data-menu-open] .bar {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.7rem;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.5rem;
    height: 1.5px;
    background: var(--color-red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-calm);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .lang,
  .menu-btn {
    --tw-ring-color: color-mix(in oklab, currentColor 32%, transparent);
  }
  .lang:hover,
  .menu-btn:hover {
    background: color-mix(in oklab, currentColor 8%, transparent);
  }
  .site-header[data-menu-open] :global(.hdr-cta) {
    background: var(--color-canvas);
    color: var(--color-ink);
  }
  /* The logo turns canvas over the menu's ink. */
  .site-header[data-menu-open] :global(.kilf-logo) {
    --ink: var(--color-canvas);
    --sun: var(--color-red-bright);
  }

  /* The menu: ink, calm; it simply fades in. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    background: var(--color-night);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
  }
  .menu[data-open] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease;
  }
  .menu-link {
    display: flex;
    min-height: 3rem;
    align-items: center;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    padding-block: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .menu-link.big {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .menu-link:hover,
  .menu-link[aria-current='page'] {
    color: var(--color-water-light);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header?.hasAttribute('data-overlay')) {
    const solid = () => header.toggleAttribute('data-solid', window.scrollY > 24);
    solid();
    window.addEventListener('scroll', solid, { passive: true });
  }

  if (header && btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
      header.toggleAttribute('data-menu-open', open);
      btn.querySelector('.menu-icon')?.classList.toggle('hidden', open);
      btn.querySelector('.close-icon')?.classList.toggle('hidden', !open);
      btn.querySelector('[data-open-text]')?.classList.toggle('lg:inline', !open);
      btn.querySelector('[data-open-label]')?.classList.toggle('hidden', open);
      btn.querySelector('[data-close-label]')?.classList.toggle('hidden', !open);
      document.documentElement.classList.toggle('overflow-hidden', open);
      if (open) setTimeout(() => menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true }), 150);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
  }
</script>
