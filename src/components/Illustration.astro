---
import { Picture } from 'astro:assets';
import { asset } from '@/lib/images';
/**
 * Responsive illustration from kilf-assets/ (or its generated stand-in),
 * served as AVIF/WebP via <picture>. Lazy-loaded unless `priority`.
 */
interface Props {
  src: string; // path inside kilf-assets, e.g. "illustrations/cover.jpg"
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  pictureClass?: string;
  priority?: boolean;
}
const {
  src,
  alt,
  widths = [480, 768, 1024, 1440, 1920],
  sizes = '100vw',
  class: cls = '',
  pictureClass = '',
  priority = false,
} = Astro.props;
const { src: img } = asset(src);
const usable = widths.filter((w) => w <= img.width);
if (!usable.length) usable.push(img.width);
---
<Picture
  src={img}
  alt={alt}
  formats={['avif', 'webp']}
  widths={usable}
  sizes={sizes}
  class={cls}
  pictureAttributes={{ class: pictureClass }}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
/>
