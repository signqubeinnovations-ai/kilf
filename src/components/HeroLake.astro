---
import { Picture } from 'astro:assets';
import Karimeen from './Karimeen.astro';
import { arts } from '@/lib/lake-art';
/**
 * The home hero's lake: still. One orchestrated moment, all CSS:
 * - a karimeen surfaces once, soon after the page opens;
 * - every six seconds a single ripple spreads from the open book, over the
 *   water only (clipped to the water's outline, so it never crosses the book).
 * A "stage" box is cropped exactly like the picture (object-fit: cover at the
 * same object-position, via --px/--py), so both stay pinned to the artwork at
 * every screen size. "Pause the lake" and reduced motion stop them.
 */
interface Props {
  class?: string;
  /** Classes for the <img>: object-position per breakpoint. */
  imgClass?: string;
  /** Classes setting --px/--py (0–1) to match the <img>'s object-position. */
  stageClass?: string;
  sizes?: string;
}
const { class: cls = '', imgClass = '', stageClass = '', sizes = '100vw' } = Astro.props;
const a = arts.hero;
const W = 3600;
const H = 1857;
// The water outline, pulled a touch away from the jetty's edge so no ring ever touches the planks.
const water = a.mask.map(([x, y]) => `${Math.round(x * W)},${Math.round((x > 0.74 && y > 0.4 && y < 0.6 ? y - 0.018 : y) * H)}`).join(' ');
// Where the ripple starts: the water just behind the open book, where the karimeen surfaced.
const ripple = { x: 0.705 * W, y: 0.492 * H };
// Where the karimeen breaks the surface (as fractions of the picture). Its
// jump is drawn in picture units (1/3600 of the picture's width) around
// that point, and scaled a little larger on small screens.
const fish = { x: 0.7, y: 0.47 };
const splash = [
  { x: 34, d: 1.9 },
  { x: 280, d: 3.1 },
];
---
<div class:list={['hero-lake relative isolate overflow-hidden bg-lake-soft', cls]}>
  <Picture
    src={a.img}
    alt={a.alt}
    formats={['avif', 'webp']}
    widths={[...a.widths]}
    sizes={sizes}
    class:list={['absolute inset-0 size-full object-cover', imgClass]}
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />
  <div class:list={['hero-stage', stageClass]} aria-hidden="true">
    <svg class="absolute inset-0 size-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
      <defs>
        <clipPath id="hero-water"><polygon points={water} /></clipPath>
      </defs>
      <g clip-path="url(#hero-water)" fill="none" stroke="#fcfaf3" stroke-linecap="round">
        {[0, 1, 2].map((i) => (
          <ellipse class="hero-ring" cx={ripple.x} cy={ripple.y} rx="520" ry="100" style={`--i:${i}`} />
        ))}
      </g>
    </svg>
    <div class="fish-at" style={`left:${fish.x * 100}%;top:${fish.y * 100}%`}>
      <svg class="fish-splash" viewBox="-300 -60 900 120">
        <g fill="none" stroke="#fcfaf3" stroke-linecap="round">
          {splash.map((s) => (
            <ellipse class="fish-ring" cx={s.x} cy="0" rx="230" ry="46" style={`--d:${s.d}s`} />
          ))}
        </g>
      </svg>
      <div class="fish-wrap">
        <div class="fish"><Karimeen uid="hero" class="block h-auto w-full" /></div>
      </div>
    </div>
  </div>
  <slot />
</div>

<style>
  .hero-lake {
    container-type: size;
  }
  /* The picture's own box, cropped like object-fit: cover at --px/--py. */
  .hero-stage {
    --a: 1.938611;
    /* One picture unit: 1/3600 of the picture's width. */
    --u: calc(max(100cqw, 100cqh * var(--a)) / 3600);
    /* The karimeen's size: larger where the picture is small. */
    --fs: 1.3;
    position: absolute;
    width: max(100cqw, 100cqh * var(--a));
    height: max(100cqh, 100cqw / var(--a));
    /* --px/--py come from the page (utility classes), 0.5 when not set. */
    left: calc((100cqw - max(100cqw, 100cqh * var(--a))) * var(--px, 0.5));
    top: calc((100cqh - max(100cqh, 100cqw / var(--a))) * var(--py, 0.5));
    pointer-events: none;
  }
  .hero-ring,
  .fish-ring {
    transform-box: fill-box;
    transform-origin: center;
    vector-effect: non-scaling-stroke;
    stroke-width: 1.6;
    opacity: 0;
  }
  /* One ripple every six seconds; three rings, a breath apart. */
  .hero-ring {
    animation: hero-ripple 6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    animation-delay: calc(3.8s + var(--i) * 0.42s);
  }
  @keyframes hero-ripple {
    0% {
      transform: scale(0.03);
      opacity: 0;
    }
    5% {
      opacity: 0.95;
    }
    60% {
      transform: scale(1);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }
  @media (max-width: 639px) {
    .hero-stage {
      --fs: 2;
    }
  }
  /* The karimeen: out of the water, a small arc, back in. Once.
     .fish-at is the point where it breaks the surface; everything inside is
     measured from there, so it scales as one. */
  .fish-at {
    position: absolute;
    width: 0;
    height: 0;
    transform: scale(var(--fs));
    transform-origin: 0 0;
  }
  .fish-splash {
    position: absolute;
    left: calc(-300 * var(--u));
    top: calc(-60 * var(--u));
    width: calc(900 * var(--u));
    height: calc(120 * var(--u));
    overflow: visible;
  }
  /* The water's surface is the bottom edge of this box: below it, the fish is hidden. */
  .fish-wrap {
    position: absolute;
    left: calc(-60 * var(--u));
    top: calc(-230 * var(--u));
    width: calc(420 * var(--u));
    height: calc(230 * var(--u));
    overflow: hidden;
  }
  .fish {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 44%;
    transform: translate(0, 120%) rotate(-38deg);
    animation: karimeen 2.1s cubic-bezier(0.45, 0, 0.35, 1) 1.5s 1 both;
  }
  @keyframes karimeen {
    0% {
      transform: translate(0, 120%) rotate(-38deg);
    }
    38% {
      transform: translate(45%, -55%) rotate(-14deg);
    }
    52% {
      transform: translate(78%, -80%) rotate(4deg);
    }
    72% {
      transform: translate(108%, -40%) rotate(26deg);
    }
    100% {
      transform: translate(128%, 125%) rotate(44deg);
    }
  }
  .fish-ring {
    animation: fish-ripple 2.6s cubic-bezier(0.22, 1, 0.36, 1) var(--d) 1 both;
  }
  @keyframes fish-ripple {
    0% {
      transform: scale(0.05);
      opacity: 0;
    }
    8% {
      opacity: 0.9;
    }
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }
</style>
