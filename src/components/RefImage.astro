---
/** Brochure reference image with an "Illustrative" tag (not a FACADO project photo). */
import { Picture } from 'astro:assets';
import { ref, type RefName } from '@/lib/images';
interface Props { name: RefName; sizes?: string; class?: string; eager?: boolean; contain?: boolean; tag?: boolean; }
const { name, sizes = '(min-width: 64rem) 50vw, 100vw', class: cls = '', eager = false, contain = false, tag = true } = Astro.props;
const img = ref[name];
---
<span class:list={['ref', cls, { contain }]}>
  <Picture src={img.src} alt={img.alt} widths={[480, 800, 1200, 1600].filter((w) => w <= img.src.width)} sizes={sizes} formats={['avif', 'webp']} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  {tag && <span class="ref-tag">Illustrative</span>}
</span>
<style>
  .ref { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; }
  .ref :global(picture) { display: contents; }
  .ref :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s var(--ease); }
  .contain :global(img) { object-fit: contain; }
  .ref-tag { position: absolute; left: 0.6rem; bottom: 0.6rem; z-index: 1; font: 700 0.75rem/1 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; padding: 0.35rem 0.5rem; background: color-mix(in oklab, var(--color-charcoal) 78%, transparent); color: var(--color-cream); }
</style>
