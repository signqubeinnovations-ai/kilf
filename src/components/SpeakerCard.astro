---
import Portrait from './Portrait.astro';
/** Speaker in a rounded portrait, name and role beneath. */
interface Props {
  name: string;
  role: string;
  photo: string;
  href?: string;
  categories?: string[];
  size?: 'md' | 'sm';
  lang?: string;
  tone?: 'light' | 'dark';
}
const { name, role, photo, href, categories = [], lang, tone = 'light' } = Astro.props;
const Tag = href ? 'a' : 'div';
const dark = tone === 'dark';
---
<li class="list-none" data-categories={categories.join(' ')}>
  <Tag href={href} class="group block rounded-[1.25rem]">
    <Portrait name={name} photo={photo} tone={tone}>
      {href && (
        <span class="absolute right-3 top-3 inline-grid size-10 place-items-center bg-cream text-navy opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">↗</span>
      )}
    </Portrait>
    <span class:list={['mt-4 block font-display text-[1.12rem] font-semibold leading-tight tracking-[-0.02em] sm:text-[1.2rem]', dark ? 'text-white' : 'text-navy', href && 'group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4']}>{name}</span>
    <span class:list={['mt-1 block text-[0.9rem] leading-snug', dark ? 'text-mist' : 'text-muted']} lang={lang}>{role}</span>
  </Tag>
</li>
