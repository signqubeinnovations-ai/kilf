---
import Portrait from './Portrait.astro';
import Icon from './Icon.astro';
/** Speaker in a large rounded portrait, name and role beneath. */
interface Props {
  name: string;
  role: string;
  photo: string;
  href?: string;
  categories?: string[];
  size?: 'md' | 'sm';
  lang?: string;
}
const { name, role, photo, href, categories = [], lang } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<li class="list-none" data-categories={categories.join(' ')}>
  <Tag href={href} class="group block rounded-[1.5rem]">
    <Portrait name={name} photo={photo}>
      {href && (
        <span class="glass absolute right-3 top-3 inline-grid size-10 place-items-center rounded-full opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">
          <Icon name="arrow" size={18} />
        </span>
      )}
    </Portrait>
    <span class="mt-4 block font-display text-[1.15rem] font-semibold leading-tight tracking-tight text-navy sm:text-[1.25rem]">{name}</span>
    <span class="mt-1 block text-[0.9rem] leading-snug text-muted" lang={lang}>{role}</span>
  </Tag>
</li>
