---
import { Image } from 'astro:assets';
import { asset } from '@/lib/images';
interface Props {
  name: string;
  role: string;
  photo: string;
  href?: string;
  categories?: string[];
  size?: 'md' | 'sm';
  lang?: string;
}
const { name, role, photo, href, categories = [], size = 'md', lang } = Astro.props;
const { src } = asset(`speakers/${photo}`);
const Tag = href ? 'a' : 'div';
---
<li class="list-none" data-categories={categories.join(' ')}>
  <Tag
    href={href}
    class:list={[
      'group flex h-full flex-col items-center rounded-2xl px-3 pb-5 pt-5 text-center',
      href && 'lift card hover:border-blue/40',
    ]}
  >
    <span class:list={['relative block overflow-hidden rounded-full bg-sky ring-4 ring-white shadow-[0_0_0_1px_var(--color-line)]', size === 'sm' ? 'size-24 sm:size-28' : 'size-28 sm:size-36']}>
      <Image
        src={src}
        alt={`Portrait of ${name}`}
        widths={[160, 288]}
        sizes={size === 'sm' ? '112px' : '(min-width: 640px) 144px, 112px'}
        class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    </span>
    <span class="mt-4 font-display text-[1.05rem] font-extrabold leading-tight tracking-tight text-navy">{name}</span>
    <span class="mt-1 text-[0.8rem] leading-snug text-muted" lang={lang}>{role}</span>
  </Tag>
</li>
