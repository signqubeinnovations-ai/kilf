---
/** The FACADO wordmark, vector-traced from the brand logo. Never recolour beyond cream/rust. */
import paths from '@/assets/brand/logo-paths.json';
interface Props { tone?: 'cream' | 'rust'; animate?: boolean; class?: string; label?: string; }
const { tone = 'cream', animate = false, class: cls = '', label = 'FACADO' } = Astro.props;
const color = tone === 'cream' ? '#F2F0DA' : '#6B3022';
const { w, h, letters } = paths.wordmark;
---
<svg class:list={['logo', cls, { 'logo-anim': animate }]} viewBox={`0 0 ${w} ${h}`} role="img" aria-label={label} fill={color}>
  {letters.map((d, i) => <path class="lt" style={`--i:${i}`} fill-rule="evenodd" d={d} />)}
</svg>
<style>
  .logo { height: auto; overflow: visible; }
  .lt { transform-box: fill-box; }
  :global(.m) .logo-anim .lt { animation: lt-in 0.85s var(--ease) both; animation-delay: calc(var(--i) * 70ms + 80ms); }
  @keyframes lt-in { from { clip-path: inset(100% 0 0 0); transform: translateY(18%); } to { clip-path: inset(0 0 0 0); transform: none; } }
</style>
