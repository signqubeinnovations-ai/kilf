---
import { logoUrl } from '@/lib/images';
/**
 * KILF logo. Drop the real file at kilf-assets/logos/kilf-logo.svg (and
 * kilf-logo-white.svg for dark backgrounds) and it replaces this wordmark.
 */
interface Props { tone?: 'light' | 'dark'; class?: string; /** Hide from AT when the parent link supplies the name. */ decorative?: boolean }
const { tone = 'light', class: cls = '', decorative = false } = Astro.props;
const file = logoUrl(tone === 'dark' ? 'kilf-logo-white' : 'kilf-logo');
const main = tone === 'dark' ? '#FCFAF3' : '#0047AB';
const accent = tone === 'dark' ? '#F47A5E' : '#D4553A';
---
{
  file ? (
    <img src={file} alt={decorative ? '' : 'KILF 2027'} class:list={['h-10 w-auto', cls]} width="120" height="40" />
  ) : (
    <svg viewBox="0 0 132 44" class:list={['h-10 w-auto', cls]} role={decorative ? undefined : 'img'} aria-hidden={decorative ? 'true' : undefined} aria-label={decorative ? undefined : 'KILF 2027, Kollam International Literature Festival'}>
      <text x="0" y="31" font-family="Plus Jakarta Sans Variable, Plus Jakarta Sans, sans-serif" font-weight="800" font-size="34" letter-spacing="-1.4" fill={main}>KILF</text>
      <path d="M2 39c6-3.2 12-3.2 18 0s12 3.2 18 0 12-3.2 18 0 12 3.2 18 0" fill="none" stroke={accent} stroke-width="2.4" stroke-linecap="round" />
      <text x="88" y="16" font-family="Manrope Variable, Manrope, sans-serif" font-weight="700" font-size="11" letter-spacing="1.5" fill={main}>2027</text>
      <circle cx="94" cy="28" r="5" fill={accent} />
    </svg>
  )
}
