---
import ChapterLabel from './ChapterLabel.astro';
import Headline from './Headline.astro';
import WordStack from './WordStack.astro';
import RippleField from './motion/RippleField';
/** Standard header for inner pages: a big headline over slowly spreading rings. */
interface Props {
  chapter: number;
  label: string;
  text?: string;
  accent: string;
  lead?: string;
  tone?: 'cream' | 'navy' | 'blue';
}
const { chapter, label, text, accent, lead, tone = 'cream' } = Astro.props;
const dark = tone !== 'cream';
const bg = { cream: 'bg-cream', navy: 'bg-navy text-cream on-dark', blue: 'bg-blue-bright text-white on-dark' }[tone];
---
<section class:list={['relative overflow-hidden pb-16 pt-12 sm:pb-24 sm:pt-20', bg]}>
  <RippleField client:idle tone={dark ? 'dark' : 'light'} x={84} y={58} size={560} follow waves />
  <div class="container-kilf relative">
    <div class="flex items-start justify-between gap-6">
      <ChapterLabel n={chapter} label={label} tone={dark ? 'dark' : 'light'} />
      <WordStack tone={dark ? 'dark' : 'light'} class="hidden sm:block" />
    </div>
    <Headline as="h1" size="xl" text={text} accent={accent} tone={tone === 'cream' ? 'light' : tone === 'navy' ? 'dark' : 'blue'} class="mt-7 max-w-5xl" />
    {lead && <p class:list={['mt-7 max-w-2xl text-lg leading-relaxed sm:text-xl', dark ? 'text-cream/90' : 'text-muted']}>{lead}</p>}
    <slot />
  </div>
</section>
