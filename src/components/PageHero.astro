---
import ChapterLabel from './ChapterLabel.astro';
import Headline from './Headline.astro';
/**
 * Header for inner pages: a label beside a ripple ring, one calm headline
 * (the second line in cobalt, at most one coral word), and a short lead.
 * Still: three faint rings on the water to the right, nothing moving.
 */
interface Props {
  chapter?: number;
  label: string;
  text?: string;
  accent: string;
  lead?: string;
  /** One word in the headline to set in coral. */
  coral?: string;
  tone?: 'cream' | 'blue' | 'lime';
  /** Language of the headline, when it differs from the page (translated headlines on /ml/). */
  lang?: string;
}
const { label, text, accent, lead, coral, tone = 'cream', lang } = Astro.props;
const dark = tone === 'blue';
const bg = { cream: 'bg-cream text-navy', blue: 'bg-night text-white on-dark', lime: 'bg-lake-soft text-navy' }[tone];
---
<section class:list={['relative overflow-hidden pb-14 pt-14 sm:pb-20 sm:pt-20 lg:pb-24 lg:pt-24', bg]}>
  <svg class="pointer-events-none absolute -right-24 top-1/2 hidden w-[34rem] -translate-y-1/2 md:block" viewBox="0 0 400 240" aria-hidden="true">
    <g fill="none" stroke="#8e9ea8" stroke-opacity={dark ? 0.5 : 0.7} stroke-width="1.2">
      <ellipse cx="200" cy="120" rx="46" ry="26" />
      <ellipse cx="200" cy="120" rx="104" ry="58" />
      <ellipse cx="200" cy="120" rx="170" ry="96" />
    </g>
  </svg>
  <div class="container-kilf relative">
    <ChapterLabel label={label} lang={lang} tone={dark ? 'dark' : 'light'} />
    <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
      <Headline as="h1" size="xl" text={text} accent={accent} coral={coral} lang={lang} tone={dark ? 'blue' : 'light'} class="lg:col-span-8" />
      {lead && <p class:list={['max-w-md text-lg leading-relaxed lg:col-span-4 lg:pb-3', dark ? 'text-white/85' : 'text-muted']}>{lead}</p>}
    </div>
    <slot />
  </div>
</section>
