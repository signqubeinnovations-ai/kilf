---
/**
 * Nine-step process on a vertical line that fills as you scroll.
 * Each step has a line icon that draws itself when the step comes into view,
 * and its circle fills once the scroll line reaches it.
 */
import { process } from '@/lib/content';
interface Props { detailed?: boolean; }
const { detailed = false } = Astro.props;

/** 24×24 line icons, one per step (by step number). Every shape uses pathLength="1" so it can draw. */
const icons: Record<number, string> = {
  // Site survey: target / measuring crosshair
  1: '<circle cx="12" cy="12" r="7" pathLength="1"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" pathLength="1"/><circle cx="12" cy="12" r="1.6" pathLength="1"/>',
  // Architectural consultation: two speech bubbles
  2: '<path d="M3.5 4.5h11v8H8.5l-3 3v-3h-2z" pathLength="1"/><path d="M14.5 8.5h6v7h-2v3l-3-3h-4v-3" pathLength="1"/>',
  // Design development: 3D cube
  3: '<path d="M12 2.8l8 4.5v9.4L12 21.2l-8-4.5V7.3z" pathLength="1"/><path d="M4 7.3l8 4.6 8-4.6M12 11.9v9.3" pathLength="1"/>',
  // Detailed shop drawings: set square and scale
  4: '<path d="M4 20V4l16 16z" pathLength="1"/><path d="M8 16v-3.5l3.5 3.5z" pathLength="1"/><path d="M4 8h2.2M4 12h2.2" pathLength="1"/>',
  // Structural framework planning: frame grid
  5: '<rect x="4" y="3" width="16" height="18" pathLength="1"/><path d="M9.3 3v18M14.7 3v18M4 9h16M4 15h16" pathLength="1"/>',
  // ACP fabrication: panel folded into a tray
  6: '<path d="M3 9l9-4.5L21 9l-9 4.5z" pathLength="1"/><path d="M3 9v6.5l9 4.5 9-4.5V9" pathLength="1"/><path d="M12 13.5V20" pathLength="1"/>',
  // Quality inspection: magnifier with tick
  7: '<circle cx="10.5" cy="10.5" r="6.5" pathLength="1"/><path d="M15.4 15.4L21 21" pathLength="1"/><path d="M7.6 10.6l2 2 3.8-3.9" pathLength="1"/>',
  // Professional installation: crane with hook and panel
  8: '<path d="M6 21V3.5M6 3.5h14M6 7.5l4-4M3 21h7" pathLength="1"/><path d="M17.5 3.5v4.5" pathLength="1"/><rect x="15.5" y="8.5" width="4" height="4" pathLength="1"/>',
  // Final handover: key
  9: '<circle cx="8" cy="15.5" r="4" pathLength="1"/><path d="M10.9 12.6L20 3.5M16 7.5l2.2 2.2M18.2 5.3l2 2" pathLength="1"/>',
};
---
<div class="proc" data-proc>
  <div class="proc-line" aria-hidden="true"><span data-proc-fill /></div>
  {process.map((g) => (
    <div class="proc-group">
      <p class="proc-g caps num">{g.group}</p>
      <ol class="proc-steps" start={g.steps[0].n}>
        {g.steps.map((s) => (
          <li class="proc-step" data-stamp>
            <span class="proc-dot" aria-hidden="true">
              <svg class="proc-ic" viewBox="0 0 24 24" set:html={icons[s.n]} />
            </span>
            <div>
              <span class="proc-n num">{String(s.n).padStart(2, '0')}</span>
              <h3 class="t-1">{s.title}</h3>
              <p class="body-copy">{detailed ? s.detail : s.short}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  ))}
</div>
<style>
  .proc { position: relative; padding-left: 0; }
  .proc-line { position: absolute; left: 1.75rem; top: 0.5rem; bottom: 0.5rem; width: 1px; background: var(--rule); }
  .proc-line span { position: absolute; inset: 0; background: var(--accent); transform-origin: top; transform: scaleY(var(--p, 1)); }
  .proc-group + .proc-group { margin-top: 3.5rem; }
  .proc-g { padding-left: 5rem; margin-bottom: 1.5rem; font-size: 0.95rem; }
  .proc-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.25rem; }
  .proc-step { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1.5rem; align-items: start; }
  .proc-n { display: block; margin-top: 0.35rem; font-size: 0.8rem; letter-spacing: 0.2em; }
  .proc-step h3 { margin-top: 0.3rem; letter-spacing: 0.05em; }
  .proc-step .body-copy { margin-top: 0.6rem; }

  .proc-dot { position: relative; z-index: 1; width: 3.5rem; height: 3.5rem; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--accent); background: var(--bg); color: var(--accent); transition: background-color 0.5s var(--ease), color 0.5s var(--ease), box-shadow 0.6s var(--ease); }
  .proc-ic { width: 1.6rem; height: 1.6rem; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }
  /* The scroll line has reached this step: circle fills, icon turns cream. */
  .proc-step.is-done .proc-dot { background: var(--accent); color: var(--bg); box-shadow: 0 0 0 6px color-mix(in oklab, var(--accent) 16%, transparent); }

  /* Motion: circle stamps in, then each stroke of the icon draws, one after another. */
  :global(.m) .proc-dot { transform: scale(1.6); opacity: 0; transition: transform 0.55s var(--ease), opacity 0.3s linear, background-color 0.5s var(--ease), color 0.5s var(--ease), box-shadow 0.6s var(--ease); }
  :global(.m) .proc-step.is-in .proc-dot { transform: none; opacity: 1; }
  :global(.m) .proc-ic :global(*) { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.9s var(--ease); }
  :global(.m) .proc-ic :global(*:nth-child(2)) { transition-delay: 0.15s; }
  :global(.m) .proc-ic :global(*:nth-child(3)) { transition-delay: 0.3s; }
  :global(.m) .proc-step.is-in .proc-ic :global(*) { stroke-dashoffset: 0; transition-delay: 0.25s; }
  :global(.m) .proc-step.is-in .proc-ic :global(*:nth-child(2)) { transition-delay: 0.45s; }
  :global(.m) .proc-step.is-in .proc-ic :global(*:nth-child(3)) { transition-delay: 0.65s; }
  :global(.m) .proc-step:hover .proc-ic { animation: ic-nudge 0.6s var(--ease); }
  @keyframes ic-nudge { 40% { transform: translateY(-2px) rotate(-4deg); } }
  :global(.rm) .proc-dot { opacity: 0; transition: opacity 0.4s; }
  :global(.rm) .proc-step.is-in .proc-dot { opacity: 1; }
</style>
