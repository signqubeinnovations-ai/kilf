---
import Icon from './Icon.astro';
/** Text link with an underline that draws itself in on hover. */
interface Props { href: string; label: string; tone?: 'light' | 'dark' | 'navy'; class?: string }
const { href, label, tone = 'light', class: cls = '' } = Astro.props;
const tones = {
  light: 'text-blue [--line:var(--color-blue)]',
  dark: 'text-cream [--line:var(--color-coral)] hover:text-lime',
  navy: 'text-navy [--line:var(--color-navy)]',
};
---
<a href={href} class:list={['text-link group inline-flex min-h-11 items-center gap-1.5 font-bold', tones[tone], cls]}>
  <span class="relative">{label}</span><Icon name="arrow-right" size={18} class="transition-transform duration-500 ease-[var(--ease-calm)] group-hover:translate-x-1" />
</a>
