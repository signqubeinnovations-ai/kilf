---
import Icon from './Icon.astro';
interface Props { href: string; label: string; tone?: 'light' | 'dark'; class?: string }
const { href, label, tone = 'light', class: cls = '' } = Astro.props;
---
<a
  href={href}
  class:list={[
    'group inline-flex min-h-11 items-center gap-1.5 font-bold underline decoration-2 underline-offset-[6px] transition-colors',
    tone === 'dark' ? 'text-cream decoration-coral hover:text-lime' : 'text-blue decoration-blue/30 hover:decoration-blue',
    cls,
  ]}
>
  {label}<Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" />
</a>
