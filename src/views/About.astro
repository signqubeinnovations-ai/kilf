---
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import Icon from '@/components/Icon.astro';
import LakeArt from '@/components/LakeArt.astro';
import LimeButton from '@/components/LimeButton.astro';
import Rings from '@/components/Rings.astro';
import TextLink from '@/components/TextLink.astro';
import { aboutQA } from '@/i18n/about-qa';
import { site } from '@/lib/site';
import { useTranslations, localizePath, type Lang, type UIKey } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const expect = [
  ['chat', 'about.e1'],
  ['books', 'about.e2'],
  ['mic', 'about.e3'],
  ['mask', 'about.e4'],
  ['bowl', 'about.e5'],
  ['moon', 'about.e6'],
] as const;
const values = ['about.v1', 'about.v2', 'about.v3', 'about.v4'] as const;
const matters = [
  ['anchor', 'about.m1'],
  ['calendar', 'about.m2'],
  ['scroll', 'about.m3'],
  ['leaf', 'about.m4'],
] as const;
---
<PageHero label={t('about.chapter')} text={t('about.h')} accent={t('about.accent')}>
  <div class="mt-12 grid gap-6 border-t border-line pt-10 text-lg leading-relaxed md:grid-cols-2 md:gap-12">
    <p class="text-navy">{t('about.p1')}</p>
    <p class="text-muted">{t('about.p2')}</p>
  </div>
</PageHero>

<!-- Why KILF: one idea, on still water -->
<section class="bg-lake-soft py-24 sm:py-28 lg:py-36" aria-labelledby="vision-h">
  <div class="container-kilf">
    <div class="mx-auto max-w-3xl text-center">
      <ChapterLabel label={t('about.vision.chapter')} />
      <Headline id="vision-h" text={t('about.vision.h')} accent={t('about.vision.accent')} class="mt-8" />
      <p class="mx-auto mt-8 max-w-2xl text-xl leading-relaxed text-navy/85">{t('about.vision.p')}</p>
      <Rings n={3} size={96} tone="cobalt" class="mx-auto mt-14" />
    </div>
  </div>
</section>

<Section tone="cream" labelledby="why-h">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
    <div class="lg:col-span-6">
      <ChapterLabel label={t('about.why.chapter')} />
      <Headline id="why-h" text={t('about.why.h')} accent={t('about.why.accent')} class="mt-6" />
    </div>
    <p class="max-w-xl text-lg leading-relaxed text-muted lg:col-span-6 lg:pb-2">{t('about.why.p')}</p>
  </div>
  <figure class="mt-12">
    <LakeArt art="jetty" sizes="(min-width: 1280px) 1120px, 100vw" focus={[0.62, 0.5]} class="aspect-[4/3] w-full rounded-[1.25rem] sm:aspect-[2/1] lg:aspect-[2.4/1]" />
    <figcaption class="mt-4 flex items-center gap-3 text-sm text-muted"><Rings n={1} size={24} tone="cobalt" />{t('home.hero.lakeCaption')}</figcaption>
  </figure>
</Section>

<Section tone="cream" rule labelledby="matters-h">
  <ChapterLabel label={lang === 'ml' ? 'കൊല്ലം' : 'Kollam'} />
  <Headline id="matters-h" text={t('about.matters.h')} accent={t('about.matters.accent')} class="mt-6" />
  <ul class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {matters.map(([icon, key]) => (
      <li class="border-t border-line pt-6">
        <Icon name={icon} size={28} class="text-cobalt" />
        <h3 class="mt-6 font-display text-[1.3rem] leading-tight tracking-[-0.03em] text-navy">{t(`${key}.t` as UIKey)}</h3>
        <p class="mt-2 text-muted">{t(`${key}.d` as UIKey)}</p>
      </li>
    ))}
  </ul>
</Section>

<!-- What to expect -->
<Section tone="cream" rule labelledby="expect-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <ChapterLabel label={t('about.expect.chapter')} />
      <Headline id="expect-h" text={t('about.expect.h')} accent={t('about.expect.accent')} class="mt-6" />
    </div>
    <TextLink href={lp('/programme')} label={t('day.link')} />
  </div>
  <ul class="mt-14 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
    {expect.map(([icon, key]) => (
      <li class="flex gap-5 border-t border-line py-7">
        <Icon name={icon} size={28} class="mt-0.5 shrink-0 text-cobalt" />
        <div>
          <h3 class="font-display text-[1.25rem] tracking-[-0.03em]">{t(`${key}.t` as UIKey)}</h3>
          <p class="mt-1.5 text-muted">{t(`${key}.d` as UIKey)}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>

<!-- What we believe -->
<Section tone="cream" rule labelledby="values-h">
  <ChapterLabel label={t('about.values.chapter')} />
  <Headline id="values-h" text={t('about.values.h')} accent={t('about.values.accent')} class="mt-6" />
  <ul class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {values.map((key) => (
      <li class="border-t border-line pt-6">
        <Rings n={1} size={30} tone="cobalt" />
        <h3 class="mt-5 font-display text-[1.3rem] leading-tight tracking-[-0.03em]">{t(`${key}.t` as UIKey)}</h3>
        <p class="mt-2 text-muted">{t(`${key}.d` as UIKey)}</p>
        {key === 'about.v4' && <TextLink href={lp('/cause')} label={t('home.cause.link')} class="mt-4" />}
      </li>
    ))}
  </ul>
</Section>

<Section tone="sky" labelledby="qa-h">
  <ChapterLabel label={t('about.qa.chapter')} />
  <h2 id="qa-h" class="display mt-6 text-[2.1rem] text-navy sm:text-[2.8rem] lg:text-[3.3rem]">
    KILF, <span class="text-cobalt" lang="ml">ചുരുക്കത്തിൽ.</span>
  </h2>
  <dl class="mt-12 grid gap-x-12 border-t border-navy/15 md:grid-cols-2" lang="ml">
    {aboutQA.map((item, i) => (
      <div class:list={['border-b border-navy/15 py-7', i === 0 && 'md:col-span-2']}>
        <dt class="text-xl font-bold text-cobalt">{item.q}</dt>
        <dd class="mt-2 max-w-3xl text-lg leading-relaxed text-navy">{item.a}</dd>
      </div>
    ))}
  </dl>
</Section>

<section class="bg-cream py-16 sm:py-20">
  <div class="container-kilf">
    <div class="flex flex-col items-start justify-between gap-6 border-y border-line py-8 sm:flex-row sm:items-center">
      <p class="text-lg">
        <span class="text-muted">{t('about.organised')}</span>
        <strong class="font-display text-2xl font-extrabold tracking-[-0.03em]"> {site.organiser}.</strong>
      </p>
      <LimeButton href={lp('/contact')} label={t('nav.contact')} />
    </div>
  </div>
</section>
