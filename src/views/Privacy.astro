---
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import { site, env } from '@/lib/site';
import { headings, type Lang } from '@/i18n/ui';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const h = headings(lang);
const analytics = env.plausible ? 'Plausible Analytics (cookie-free, aggregate statistics)' : env.ga4 ? 'Google Analytics 4 (aggregate statistics; IP anonymised)' : null;
---
<PageHero
  label={h('Privacy', 'സ്വകാര്യത')}
  text={h('Your details,', 'നിങ്ങളുടെ വിവരങ്ങൾ,')}
  accent={h('looked after.', 'സുരക്ഷിതം.')}
  lang={h.lang}
  lead="Plain-language privacy for the KILF 2027 website."
/>
<Section tone="cream" class="!pt-0">
  <div class="max-w-3xl space-y-10 text-lg leading-relaxed text-navy/90 [&_a]:font-bold [&_a]:text-cobalt [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-4 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:tracking-[-0.02em] [&_h2]:text-navy">
    <div><h2 lang={h.lang}>{h('Who we are', 'ഞങ്ങൾ ആര്')}</h2><p class="mt-2">The Kollam International Literature Festival (KILF) 2027 is organised by {site.organiser}. You can reach us at <a href={`mailto:${site.email}`}>{site.email}</a>.</p></div>
    <div><h2 lang={h.lang}>{h('What we collect', 'ഞങ്ങൾ ശേഖരിക്കുന്നത്')}</h2><p class="mt-2">Only what you type into our forms: typically your name, email, phone number, organisation and message, plus the form you used and when. We don’t ask for anything we don’t need.</p></div>
    <div><h2 lang={h.lang}>{h('Why we use it', 'എന്തിന് ഉപയോഗിക്കുന്നു')}</h2><p class="mt-2">To reply to you, to send the updates you asked for (passes, programme, seats), and to organise volunteers, exhibitors and partners. We never sell your details or share them for marketing by others.</p></div>
    <div><h2 lang={h.lang}>{h('Where it goes', 'വിവരങ്ങൾ എവിടേക്ക്')}</h2><p class="mt-2">Form submissions are delivered through a third-party form service to the festival team’s inbox or spreadsheet. Maps load from Google only when you choose “Show map”.</p></div>
    <div><h2 lang={h.lang}>{h('Analytics', 'അനലിറ്റിക്സ്')}</h2><p class="mt-2">{analytics ? `We use ${analytics} to understand which pages are useful.` : 'This site does not currently use analytics or tracking cookies.'}</p></div>
    <div><h2 lang={h.lang}>{h('How long we keep it', 'എത്ര കാലം സൂക്ഷിക്കും')}</h2><p class="mt-2">Until the end of the 2027 festival cycle, unless you ask us to keep you updated about future editions.</p></div>
    <div><h2 lang={h.lang}>{h('Your choices', 'നിങ്ങളുടെ തീരുമാനങ്ങൾ')}</h2><p class="mt-2">Ask us at any time to see, correct or delete your details, or to stop sending updates: just email <a href={`mailto:${site.email}`}>{site.email}</a>.</p></div>
    <p class="text-sm text-muted">Last updated: September 2026.</p>
  </div>
</Section>
