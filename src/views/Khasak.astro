---
import Section from '@/components/Section.astro';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import Badge from '@/components/Badge.astro';
import Illustration from '@/components/Illustration.astro';
import IconCircle from '@/components/IconCircle.astro';
import WordStack from '@/components/WordStack.astro';
import NotifyBanner from '@/components/blocks/NotifyBanner.astro';
import type { Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tags = [
  ['star', 'Epic scale'],
  ['compass', 'Immersive staging'],
  ['sparkle', 'Not to be missed'],
];
---
<section class="on-dark relative overflow-hidden bg-navy text-cream" aria-labelledby="khasak-h">
  <div class="container-kilf relative z-10 pb-10 pt-10 sm:pt-16">
    <div class="flex items-start justify-between gap-6">
      <div class="flex flex-wrap items-center gap-3">
        <ChapterLabel n={1} label="Signature live theatre" tone="dark" />
        <Badge tone="dark">Proposed</Badge>
      </div>
      <WordStack tone="dark" class="hidden sm:block" />
    </div>
    <Headline as="h1" size="xl" id="khasak-h" text="Khasakkinte" accent="Ithihasam." tone="dark" class="mt-6" />
    <p class="mt-3 text-2xl text-mist" lang="ml">ഖസാക്കിന്റെ ഇതിഹാസം</p>
  </div>
  <div class="relative">
    <Illustration
      src="illustrations/p4_stage.jpg"
      alt="An open theatre stage under a spotlight: two figures, a village house and a great tree, with an audience in the foreground."
      priority
      class="h-[20rem] w-full object-cover sm:h-[30rem] lg:h-[40rem]"
    />
    <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-navy to-transparent" aria-hidden="true"></div>
  </div>
</section>

<Section tone="cream" waves labelledby="about-play-h">
  <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <div>
      <ChapterLabel n={2} label="The experience" />
      <Headline id="about-play-h" text="Not a play you watch —" accent="a world you walk into." class="mt-5" />
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy/90">
        O. V. Vijayan’s legendary 1969 novel, staged by director Deepan Sivaraman. The village of Khasak, its legends
        and its restless teacher Ravi, brought to life around you rather than in front of you.
      </p>
      <p class="mt-4 text-sm font-semibold text-muted">Proposed for KILF 2027 · details subject to confirmation.</p>
    </div>
    <ul class="grid content-start gap-3">
      {tags.map(([icon, label]) => (
        <li class="card flex items-center gap-4 p-5">
          <IconCircle name={icon} tone="lime" />
          <span class="font-display text-xl font-extrabold tracking-tight">{label}</span>
        </li>
      ))}
    </ul>
  </div>
</Section>

<NotifyBanner
  id="seats"
  formName="khasak-seats"
  text="Get notified when seats"
  accent="open."
  lead="Seating for the signature theatre experience will be limited."
  lang={lang}
/>
