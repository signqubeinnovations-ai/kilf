---
import Section from '@/components/Section.astro';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import Badge from '@/components/Badge.astro';
import IconCircle from '@/components/IconCircle.astro';
import WordStack from '@/components/WordStack.astro';
import Form from '@/components/Form.astro';
import Field from '@/components/Field.astro';
import LimeButton from '@/components/LimeButton.astro';
import type { Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const activities = [
  ['mic', 'Poetry Slam', 'Three minutes, one mic, no mercy.'],
  ['megaphone', 'Open Mic Nights', 'Stories, songs and stand-up by the lake.'],
  ['camera', 'Reels & Short-Film Challenge', 'Tell a Kollam story in under a minute.'],
  ['music', 'Indie & Rap Night', 'New sounds in Malayalam and beyond.'],
  ['book', 'Meet Your Favourite Authors', 'Up close, questions welcome.'],
  ['graduation', 'Campus Ambassadors', 'Bring KILF to your college.'],
];
---
<section class="on-dark waves-light relative overflow-hidden bg-blue-bright pb-16 pt-10 text-white sm:pb-24 sm:pt-16" aria-labelledby="youth-h">
  <div class="container-kilf">
    <div class="flex items-start justify-between gap-6">
      <ChapterLabel n={1} label="Youth" tone="dark" />
      <WordStack tone="dark" class="hidden sm:block" />
    </div>
    <Headline as="h1" size="xl" id="youth-h" text="Youth." accent="This stage is yours." tone="blue" class="mt-6 max-w-4xl" />
    <p class="mt-6 max-w-xl text-xl text-white/90">Slams, open mics, reels, rap and your favourite authors up close. Loud, young and entirely yours.</p>
    <ul class="mt-8 flex flex-wrap gap-2.5" aria-label="Activities">
      {activities.map(([, a], i) => (
        <li class:list={['rounded-full px-4 py-2.5 text-sm font-bold sm:text-base', i % 2 ? 'bg-coral text-navy' : 'bg-lime text-navy']}>{a}</li>
      ))}
    </ul>
    <LimeButton href="#college" label="Register your college" class="mt-10" />
  </div>
</section>

<Section tone="cream" waves labelledby="activities-h">
  <div class="flex flex-wrap items-center gap-3">
    <ChapterLabel n={2} label="Activities" />
    <Badge>Proposed</Badge>
  </div>
  <Headline id="activities-h" text="Six ways to take the" accent="stage." class="mt-5" />
  <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-4">
    {activities.map(([icon, title, line], i) => (
      <li data-reveal style={`transition-delay:${(i % 3) * 60}ms`} class="card lift p-6">
        <div class="flex items-center justify-between">
          <IconCircle name={icon} tone={i % 2 ? 'coral' : 'lime'} />
          <span class="text-4xl font-light text-blue">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <h3 class="mt-5 font-display text-xl font-extrabold tracking-tight">{title}</h3>
        <p class="mt-1.5 text-muted">{line}</p>
      </li>
    ))}
  </ul>
  <p class="mt-6 text-sm font-semibold text-muted">All youth activities are proposed and subject to confirmation.</p>
</Section>

<Section tone="lime" id="college" labelledby="college-h">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
    <div>
      <ChapterLabel n={3} label="Colleges" tone="lime" />
      <Headline id="college-h" text="Register your" accent="college." class="mt-5" />
      <p class="mt-5 max-w-md text-lg text-navy/85">Tell us about your campus. We’ll share ambassador details, group passes for students and early access to the youth stage.</p>
    </div>
    <Form id="college-form" name="college" lang={lang} class="rounded-2xl bg-white p-5 sm:p-7" successText="Your college is on our list. We’ll be in touch soon.">
      <Field formId="college-form" name="name" label="Your name" autocomplete="name" required />
      <Field formId="college-form" name="email" type="email" label="Email" autocomplete="email" required />
      <Field formId="college-form" name="phone" type="tel" label="Phone" autocomplete="tel" inputmode="tel" required />
      <Field formId="college-form" name="organisation" label="College / institution" autocomplete="organization" required />
      <Field formId="college-form" name="role" type="select" label="You are" options={['Student', 'Faculty', 'Student body / club', 'Other']} />
      <Field formId="college-form" name="interest" type="select" label="Most interested in" options={['Poetry Slam', 'Open Mic Nights', 'Reels & Short-Film Challenge', 'Indie & Rap Night', 'Meet Your Favourite Authors', 'Campus Ambassadors']} />
      <Field formId="college-form" name="message" type="textarea" label="Message" full rows={3} />
    </Form>
  </div>
</Section>
