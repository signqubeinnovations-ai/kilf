---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Section from '@/components/Section.astro';
import Badge from '@/components/Badge.astro';
import TextLink from '@/components/TextLink.astro';
import Portrait from '@/components/Portrait.astro';
import { localizePath, type Lang } from '@/i18n/ui';

interface Props { lang: Lang; entry: CollectionEntry<'speakers'> }
const { lang, entry } = Astro.props;
const { Content } = await render(entry);
---
<Section tone="cream" waves>
  <TextLink href={localizePath('/speakers', lang)} label="All speakers" />
  <div class="mt-8 grid items-start gap-10 md:grid-cols-[20rem_1fr] lg:gap-16">
    <Portrait name={entry.data.name} photo={entry.data.photo} sizes="(min-width: 768px) 320px, 100vw" widths={[320, 640]} class="w-full max-w-sm" eager />
    <div>
      {entry.data.status === 'proposed' && <Badge>Proposed · subject to confirmation</Badge>}
      <h1 class="display mt-5 text-5xl text-navy sm:text-7xl">{entry.data.name}</h1>
      <p class="mt-3 text-xl text-muted">{entry.data.role}</p>
      <div class="mt-8 max-w-2xl space-y-4 border-t border-line pt-8 text-lg leading-relaxed text-navy/90 [&_a]:text-blue [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-4"><Content /></div>
    </div>
  </div>
</Section>
