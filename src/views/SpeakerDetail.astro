---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Section from '@/components/Section.astro';
import Badge from '@/components/Badge.astro';
import TextLink from '@/components/TextLink.astro';
import { asset } from '@/lib/images';
import { localizePath, type Lang } from '@/i18n/ui';

interface Props { lang: Lang; entry: CollectionEntry<'speakers'> }
const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const { src } = asset(`speakers/${entry.data.photo}`);
---
<Section tone="cream" waves>
  <TextLink href={localizePath('/speakers', lang)} label="All speakers" />
  <div class="mt-8 grid items-start gap-10 md:grid-cols-[18rem_1fr]">
    <Image src={src} alt={`Portrait of ${entry.data.name}`} widths={[288, 576]} sizes="288px" class="aspect-square w-56 rounded-full object-cover ring-4 ring-white md:w-72" loading="eager" />
    <div>
      {entry.data.status === 'proposed' && <Badge>Proposed · subject to confirmation</Badge>}
      <h1 class="display mt-4 text-5xl text-navy sm:text-6xl">{entry.data.name}</h1>
      <p class="mt-3 text-xl text-muted">{entry.data.role}</p>
      <div class="mt-8 max-w-2xl space-y-4 text-lg leading-relaxed [&_a]:text-blue [&_a]:underline"><Content /></div>
    </div>
  </div>
</Section>
