---
import { getCollection } from 'astro:content';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import LimeButton from '@/components/LimeButton.astro';
import TextLink from '@/components/TextLink.astro';
import SpeakerCard from '@/components/SpeakerCard.astro';
import Badge from '@/components/Badge.astro';
import MotionToggle from '@/components/MotionToggle.astro';
import HeroLake from '@/components/HeroLake.astro';
import MiniCountdown from '@/components/MiniCountdown.astro';
import Illustration from '@/components/Illustration.astro';
import Placeholder from '@/components/Placeholder.astro';
import Rings from '@/components/Rings.astro';
import Stopped from '@/components/Stopped.astro';
import CauseArt from '@/components/CauseArt.astro';
import EveningStage from '@/components/EveningStage.astro';
import { site } from '@/lib/site';
import { hasBio } from '@/lib/speakers';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const ml = lang === 'ml';

// "Pause. Turn a page." in two lines; the first, with its red word, ends at the first full stop.
const heroH = t('home.hero.h');
const cut = heroH.indexOf('. ');
const [line1, line2] = cut === -1 ? [heroH, ''] : [heroH.slice(0, cut + 1), heroH.slice(cut + 2)];
const word = t('home.hero.coral');
const at = line1.indexOf(word);
const [pre, redPart] = at === -1 ? ['', line1] : [line1.slice(0, at), line1.slice(at)];

// Eight featured voices, in three groups.
const speakers = await getCollection('speakers');
const bySlug = (slug: string) => speakers.find((s) => s.id === slug)!;
const groups = [
  { label: t('home.voices.lit'), slugs: ['m-mukundan', 'sara-joseph', 's-hareesh'] },
  { label: t('home.voices.ideas'), slugs: ['manu-s-pillai', 'sri-m', 'santhosh-george-kulangara'] },
  { label: t('home.voices.screen'), slugs: ['lijo-jose-pellissery', 'vairamuthu'] },
].map((g) => ({ ...g, people: g.slugs.map(bySlug) }));

// New Year's Eve, as it runs on the night (the programme has the details).
const venue = (id: string) => site.venues.find((v) => v.id === id)!;
const eve = [
  { time: '17:00', what: t('home.nye.r1'), at: venue('sngcc') },
  { time: '18:15', what: t('home.nye.r2'), at: venue('sngcc') },
  { time: '19:00', what: t('home.nye.r3'), at: venue('8point') },
  { time: '20:30', what: t('home.nye.r4'), at: venue('sngcc'), star: true },
  { time: '23:45', what: t('home.nye.r5'), at: venue('sngcc') },
  { time: '00:00', what: t('home.nye.r6'), at: venue('sngcc') },
];
const commitments = [t('home.cause.c1'), t('home.cause.c2'), t('home.cause.c3')];
---

<!-- 1 · Hero: a still lake, a red sun, an open book on the jetty. One ripple ring spreads from the book. -->
<section class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-cream text-navy lg:min-h-[min(100svh,64rem)]" data-hero aria-labelledby="hero-h">
  <div class="hero-art relative order-2 h-[22rem] sm:h-[30rem] lg:absolute lg:inset-0 lg:top-[var(--hh)] lg:-z-10 lg:h-auto">
    <HeroLake
      sizes="(max-width: 639px) 194vw, (max-width: 1023px) 160vw, (max-aspect-ratio: 97/50) 194vh, 100vw"
      imgClass="object-[74%_100%] sm:object-[82%_100%] lg:object-[100%_100%]"
      stageClass="[--px:0.74] [--py:1] sm:[--px:0.82] lg:[--px:1]"
      class="size-full"
    />
    <div class="hero-mist pointer-events-none absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="container-kilf relative order-1 flex flex-col justify-center pb-8 pt-[calc(var(--hh)+2.5rem)] lg:flex-1 lg:pb-28 lg:pt-[calc(var(--hh)+3rem)]">
    <div class="max-w-[46rem]">
      <p class="eyebrow flex items-center gap-3 text-ink"><Rings n={1} size={26} tone="red" />{t('home.hero.chapter')}</p>
      <h1 id="hero-h" class="mt-6">
        <span class:list={['display block', ml ? 'text-[2.5rem] leading-[1.15] sm:text-[3.5rem] lg:text-[4.1rem]' : 'text-[3.3rem] leading-[0.98] sm:text-[4.6rem] lg:text-[5.6rem]']}>
          {pre}<span class="accent-word">{redPart.endsWith('.') ? <>{redPart.slice(0, -1)}<span class="stop">.</span></> : redPart}</span>
          {line2 && <><br />{line2.endsWith('.') ? <>{line2.slice(0, -1)}<span class="stop">.</span></> : line2}</>}
        </span>
        <span class="sr-only"> — {t('home.hero.name')} 2027</span>
      </h1>
      <p class="mt-6 max-w-xl text-[1.3rem] font-medium leading-snug text-ink sm:text-[1.5rem]">{t('home.hero.sub')}</p>
      <p class="mt-3 text-lg text-navy"><span class="date-mark">{t('site.dates')}</span> · {t('site.city')}</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <LimeButton href={lp('/passes')} label={t('cta.getPass')} size="lg" />
        <TextLink href={lp('/programme')} label={t('cta.explore')} />
      </div>
      <MiniCountdown lang={lang} class="mt-9" />
    </div>
  </div>

  <div class="container-kilf pointer-events-none absolute inset-x-0 bottom-0 z-10 flex justify-end pb-4 sm:pb-7">
    <div class="pointer-events-auto flex items-center gap-3 bg-cream/90 py-1.5 pl-4 pr-1.5 backdrop-blur-sm">
      <span class="eyebrow hidden text-[0.66rem] sm:inline">{t('home.hero.lakeCaption')}</span>
      <MotionToggle lang={lang} tone="light" />
    </div>
  </div>
</section>

<!-- 2 · The Pause: the first cobalt band -->
<section class="on-dark bg-cobalt py-24 text-white sm:py-32 lg:py-36" aria-labelledby="pause-h">
  <div class="container-kilf">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow inline-flex items-center gap-3 text-white"><Rings n={1} size={26} tone="water" />{t('home.pause.label')}</p>
      <h2 id="pause-h" class:list={['display mt-8 text-white', ml ? 'text-[2.1rem] sm:text-[2.8rem] lg:text-[3.3rem]' : 'text-[2.4rem] sm:text-[3.4rem] lg:text-[4rem]']}><Stopped text={t('home.pause.h')} /></h2>
      <p class="mx-auto mt-8 max-w-2xl text-xl leading-relaxed text-white/90 sm:text-[1.4rem]">{t('home.pause.body')}</p>
      <Rings n={3} size={96} tone="water" class="mx-auto mt-14" />
      <p class="mx-auto mt-8 max-w-xl text-[1.05rem] leading-relaxed text-white">
        <span class="eyebrow mb-2 block text-white">{t('home.pause.whyLabel')}</span>
        {t('home.pause.why')}
      </p>
    </div>
  </div>
</section>

<!-- 3 · New Year’s Eve: a new year by the lake, on the lit stage -->
<section class="relative overflow-hidden bg-warm text-navy" aria-labelledby="nye-h">
  <div class="container-kilf relative py-24 sm:py-28 lg:py-32">
    <div class="overflow-hidden rounded-[1.25rem]">
      <EveningStage />
    </div>
    <div class="mt-14 grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="flex flex-wrap items-center gap-3">
          <ChapterLabel label={t('home.nye.chapter')} />
          <Badge>{t('home.khasak.proposed')}</Badge>
        </div>
        <Headline id="nye-h" text={t('home.nye.turn')} coral={t('home.nye.turnCoral')} size="xl" class="mt-6" />
        <p class="mt-6 max-w-md text-lg leading-relaxed text-navy">{t('home.nye.story')}</p>
        <p class="mt-6 max-w-md text-[0.98rem] text-muted">{t('home.nye.included')}</p>
        <p class="mt-2 max-w-md text-[0.9rem] text-muted">{t('home.nye.proposed')}</p>
        <TextLink href={lp('/programme#day-2026-12-31')} label={t('home.nye.link')} class="mt-8" />
      </div>
      <div class="lg:col-span-7 lg:pt-4">
        <p class="eyebrow text-navy">{t('home.nye.run')} · <span class="date-mark">31.12.2026</span></p>
        <ol class="mt-4 border-t-2 border-cobalt">
          {eve.map((e) => (
            <li class="grid grid-cols-[4.5rem_1fr] items-baseline gap-x-5 gap-y-1 border-b border-navy/15 py-4 sm:grid-cols-[5rem_1fr_auto]">
              <span class:list={['font-display text-[1.25rem] font-extrabold tabular-nums tracking-[-0.02em]', e.star ? 'text-coral' : 'text-cobalt']}>{e.time}</span>
              <span class:list={['text-[1.05rem]', e.star ? 'font-bold text-navy' : 'text-navy']}>{e.what}</span>
              <span class="col-start-2 flex items-center gap-2 text-sm text-muted sm:col-start-auto" lang="en">
                <Rings n={e.at.rings as 1 | 2 | 3} size={30} tone="cobalt" label={`${t('home.plan.ringLabel')} ${e.at.rings}`} />{e.at.name}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<!-- 4 · Voices: cobalt -->
<section class="on-dark bg-cobalt py-24 text-white sm:py-28 lg:py-32" aria-labelledby="voices-h">
  <div class="container-kilf">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <ChapterLabel label={t('home.voices.label')} tone="dark" />
        <Headline id="voices-h" text={t('home.voices.h')} coral={t('home.voices.coral')} tone="dark" class="mt-6" />
      </div>
      <p class="flex max-w-sm flex-wrap items-center gap-3 text-sm text-white/85"><Badge>{t('home.khasak.proposed')}</Badge>{t('home.voices.proposed')}</p>
    </div>
    <div class="mt-14 space-y-14 lg:space-y-16">
      {groups.map((g) => (
        <div class="grid gap-6 border-t border-white/25 pt-8 lg:grid-cols-12 lg:gap-10">
          <h3 class="eyebrow flex items-center gap-3 self-start text-white lg:col-span-3"><Rings n={1} size={24} tone="water" />{g.label}</h3>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:col-span-9 lg:gap-x-6">
            {g.people.map((s) => (
              <SpeakerCard
                id={`voice-${s.id}`}
                name={s.data.name}
                role={s.data.role}
                photo={s.data.photo}
                categories={s.data.categories}
                href={hasBio(s.body) ? lp(`/speakers/${s.id}`) : lp(`/speakers#${s.id}`)}
                lang="en"
                tone="dark"
              />
            ))}
          </ul>
        </div>
      ))}
    </div>
    <TextLink href={lp('/speakers')} label={t('cta.seeSpeakers')} tone="dark" class="mt-14" />
  </div>
</section>

<!-- 5 · Khasakkinte Ithihasam: light -->
<section class="bg-cream py-24 sm:py-28 lg:py-32" aria-labelledby="khasak-h">
  <div class="container-kilf grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="relative aspect-[4/3] overflow-hidden rounded-[1.25rem] bg-cobalt lg:col-span-6">
      <Illustration src="illustrations/p4_stage.jpg" alt="A theatre stage under a warm spotlight, a palm against a glowing coral moon." sizes="(min-width: 1024px) 45vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
    </div>
    <div class="lg:col-span-6">
      <div class="flex flex-wrap items-center gap-3">
        <ChapterLabel label={t('home.khasak.chapter')} />
        <Badge>{t('home.khasak.proposed')}</Badge>
      </div>
      <Headline id="khasak-h" text={t('home.khasak.h')} accent={t('home.khasak.accent')} class="mt-6" />
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">{t('home.khasak.short')}</p>
      <p class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 font-bold text-navy">
        <Rings n={1} size={36} tone="cobalt" label={`${t('home.plan.ringLabel')} 1`} />{t('home.khasak.where')} · <span class="date-mark">{t('home.khasak.when')}</span>
      </p>
      <p class="mt-2 text-[1.02rem] text-muted">{t('home.khasak.priceLine')}</p>
      <LimeButton href={lp('/khasak#tickets')} label={t('home.khasak.tickets')} size="lg" class="mt-9" />
    </div>
  </div>
</section>

<!-- 6 · Our cause: Keep the waters alive. Cobalt, with the teal lake card. -->
<section class="on-dark bg-cobalt py-24 text-white sm:py-28 lg:py-32" aria-labelledby="cause-h">
  <div class="container-kilf grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <ChapterLabel label={t('home.cause.label')} tone="dark" />
      <Headline id="cause-h" text={t('home.cause.h')} coral={t('home.cause.coral')} tone="dark" size="xl" class="mt-6" />
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/90">{t('home.cause.body')}</p>
      <ul class="mt-10 max-w-xl border-t border-white/25">
        {commitments.map((c) => (
          <li class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-white/25 py-4">
            <Rings n={1} size={24} tone="water" />
            <span class="font-display text-[1.15rem] font-bold tracking-[-0.02em] text-white">{c}</span>
            <Placeholder value="[CONFIRM]" />
          </li>
        ))}
      </ul>
      <TextLink href={lp('/cause')} label={t('home.cause.link')} tone="dark" class="mt-8" />
    </div>
    <div class="lg:col-span-5">
      <CauseArt class="mx-auto max-w-md" />
    </div>
  </div>
</section>

<!-- 7 · Plan and join -->
<section class="bg-cream pb-24 sm:pb-28 lg:pb-36" aria-labelledby="plan-h">
  <div class="container-kilf pt-24 sm:pt-28 lg:pt-32">
    <ChapterLabel label={t('home.plan.label')} />
    <Headline id="plan-h" text={t('home.plan.h')} accent={t('home.plan.accent')} class="mt-6" />
    <ul class="mt-12 grid border-l border-t border-line sm:grid-cols-2">
      {site.venues.map((v) => (
        <li class="flex flex-col gap-5 border-b border-r border-line p-7 sm:p-8">
          <Rings n={v.rings as 1 | 2 | 3} size={72} tone="cobalt" label={`${t('home.plan.ringLabel')} ${v.rings}`} />
          <div lang="en">
            <h3 class="font-display text-[1.3rem] font-extrabold leading-tight tracking-[-0.03em]">{v.name}</h3>
            <p class="mt-1 text-muted">{v.area}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-5 max-w-2xl text-[0.98rem] text-muted">{t('home.plan.venues')} <a href={lp('/visit')} class="font-bold text-cobalt underline decoration-1 underline-offset-4 hover:text-navy">{t('cta.visit')}</a></p>

    <div class="mt-16 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="border-t border-line pt-8">
        <h3 class="font-display text-[1.6rem] font-extrabold tracking-[-0.03em]">{t('home.plan.passes')}</h3>
        <p class="mt-2 text-muted">{t('home.plan.passesLine')}</p>
        <TextLink href={lp('/passes')} label={t('home.plan.passesLink')} class="mt-5" />
      </div>
      <div class="border-t border-line pt-8">
        <h3 class="font-display text-[1.6rem] font-extrabold tracking-[-0.03em]">{t('home.plan.join')}</h3>
        <p class="mt-2 text-muted">{t('home.plan.joinLine')}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <LimeButton href={lp('/get-involved#register')} label={t('cta.register')} />
          <LimeButton href={lp('/get-involved#volunteer')} label={t('cta.volunteer')} variant="ghost" />
        </div>
      </div>
    </div>

    <p class:list={['display mx-auto mt-28 max-w-4xl text-center text-cobalt', ml ? 'text-[1.7rem] min-[380px]:text-[2rem] sm:text-[2.8rem] lg:text-[3.3rem]' : 'text-[2.4rem] sm:text-[3.4rem] lg:text-[4.2rem]']}>
      <Stopped text={t('footer.closing.h')} /><br /><span class="text-red"><Stopped text={t('footer.closing.accent')} /></span>
    </p>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    /* Morning mist over the lake, behind the words only: keeps them legible, lets the water and the sun show */
    .hero-mist {
      background: radial-gradient(ellipse 60% 76% at 16% 54%, rgb(255 248 238 / 0.94) 0%, rgb(255 248 238 / 0.74) 44%, rgb(255 248 238 / 0) 78%);
    }
  }
</style>
