---
import { getCollection } from 'astro:content';
import Illustration from '@/components/Illustration.astro';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import LimeButton from '@/components/LimeButton.astro';
import TextLink from '@/components/TextLink.astro';
import Icon from '@/components/Icon.astro';
import SpeakerCard from '@/components/SpeakerCard.astro';
import Section from '@/components/Section.astro';
import Badge from '@/components/Badge.astro';
import MotionToggle from '@/components/MotionToggle.astro';
import LakeWindow from '@/components/LakeWindow.astro';
import StrandGrid from '@/components/blocks/StrandGrid.astro';
import InvolvedCards from '@/components/blocks/InvolvedCards.astro';
import SignupBlock from '@/components/blocks/SignupBlock.astro';
import RippleField from '@/components/motion/RippleField';
import Marquee from '@/components/motion/Marquee';
import Countdown from '@/components/motion/Countdown';
import { asset } from '@/lib/images';
import { site } from '@/lib/site';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const ml = lang === 'ml';

const speakers = (await getCollection('speakers'))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 8);
const strands = (await getCollection('strands')).sort((a, b) => a.data.order - b.data.order);

const youthChips = ['Poetry Slam', 'Open Mic Nights', 'Reels & Short-Film Challenge', 'Indie & Rap Night', 'Meet Your Favourite Authors', 'Campus Ambassadors'];

// Real artwork from kilf-assets/ wins; otherwise live water stands in.
const realCover = !asset('illustrations/cover.jpg').placeholder;
const realNye = !asset('illustrations/nye.jpg').placeholder;

// Build-time countdown values (the client takes over after hydration).
const left = Math.max(0, new Date(site.startISO).getTime() - Date.now());
const initial: [number, number, number] = [Math.floor(left / 86400000), Math.floor((left % 86400000) / 3600000), Math.floor((left % 3600000) / 60000)];

const facts = [
  { value: 5, pad: 2, suffix: '', label: t('home.facts.days') },
  { value: 100, pad: 0, suffix: '+', label: t('home.stats.speakers') },
  { value: 10000, pad: 0, suffix: '+', label: t('home.stats.audience') },
  { value: site.venues.length, pad: 2, suffix: '', label: t('home.facts.venues') },
];
---

<!-- 1 · Hero -->
<section class="relative overflow-hidden bg-cream" aria-labelledby="hero-h">
  <div class="pointer-events-none absolute -right-40 -top-40 size-[46rem] rounded-full bg-[radial-gradient(closest-side,rgb(228_236_249/0.9),transparent)]" aria-hidden="true"></div>
  <div class="container-kilf relative grid items-center gap-12 pb-16 pt-10 sm:pb-20 sm:pt-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:pb-24 lg:pt-16">
    <div>
      <p class="hero-in flex flex-wrap items-center gap-3" style="--d:0s">
        <span class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-[0.8rem] font-semibold text-navy ring-1 ring-inset ring-line">
          <span class="size-1.5 rounded-full bg-coral"></span>{t('home.kicker')}
        </span>
        <span class="eyebrow text-muted">{t('site.city')}</span>
      </p>
      <h1 id="hero-h" class:list={['display hero-in mt-7 text-navy', ml ? 'text-[2.5rem] sm:text-[3.6rem] lg:text-[4rem] xl:text-[4.6rem]' : 'text-[3.3rem] sm:text-[5rem] lg:text-[5.2rem] xl:text-[6.1rem]']} style="--d:0.1s">
        <span class="sr-only">{t('home.h1')}: </span>{t('home.tagline')} <em class="serif-accent text-blue">{t('home.taglineAccent')}</em>
      </h1>
      <p class="hero-in mt-7 max-w-xl text-lg leading-relaxed text-navy/75 sm:text-xl" style="--d:0.2s">{t('home.hero.lead')}</p>
      <div class="hero-in mt-9 flex flex-wrap items-center gap-3" style="--d:0.28s">
        <LimeButton href={lp('/get-involved#register')} label={t('cta.register')} size="lg" />
        <LimeButton href={lp('/programme')} label={t('cta.explore')} variant="ghost" size="lg" />
      </div>
      <dl class="hero-in mt-12 grid max-w-xl grid-cols-2 border-t border-navy/10 pt-6 sm:grid-cols-3" style="--d:0.36s">
        <div class="pr-4">
          <dt class="eyebrow text-muted">{t('home.hero.when')}</dt>
          <dd class="mt-1.5 font-semibold leading-snug">{ml ? '2026 ഡിസം. 31 – 2027 ജനു. 4' : '31 Dec – 4 Jan'}</dd>
        </div>
        <div class="border-l border-navy/10 pl-4 sm:pr-4">
          <dt class="eyebrow text-muted">{t('home.hero.where')}</dt>
          <dd class="mt-1.5 font-semibold leading-snug">{t('home.hero.place')}</dd>
        </div>
        <div class="col-span-2 mt-5 border-navy/10 sm:col-span-1 sm:mt-0 sm:border-l sm:pl-4">
          <dt class="eyebrow text-muted">{t('home.hero.edition')}</dt>
          <dd class="mt-1.5 font-semibold leading-snug">{t('home.hero.editionValue')}</dd>
        </div>
      </dl>
    </div>

    <figure class="hero-in relative" style="--d:0.15s">
      {
        realCover ? (
          <div class="panel aspect-[4/3] bg-sky lg:aspect-[4/5]">
            <Illustration src="illustrations/cover.jpg" alt="" priority sizes="(min-width: 1024px) 46vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[60%_100%]" />
          </div>
        ) : (
          <LakeWindow palette="day" hydrate="load" class="aspect-[4/3] shadow-[0_50px_90px_-50px_rgb(15_28_116/0.75)] lg:aspect-[4/5]">
            <p class="glass pointer-events-none absolute left-4 top-4 z-10 inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold">
              <span class="size-2 rounded-full bg-lime"></span><span data-days-left={site.startISO}>{initial[0]}</span> {t('home.hero.daysToGo')}
            </p>
            <p class="pointer-events-none absolute bottom-5 left-5 z-10 max-w-[14rem] font-[family-name:var(--font-serif)] text-2xl italic leading-tight text-white/95">{t('home.hero.touch')}</p>
          </LakeWindow>
        )
      }
      <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-muted">
        <span>{t('home.hero.caption')}</span>
        <MotionToggle lang={lang} tone="light" />
      </figcaption>
    </figure>
  </div>
</section>

<!-- 2 · The nine strands, drifting past -->
<div class="border-y border-navy/10 bg-cream py-5 text-navy sm:py-6">
  <div class="container-kilf">
    <Marquee
      client:visible
      items={strands.map((s) => (ml ? s.data.name_ml : s.data.name))}
      listLabel={t('home.marquee.label')}
      pauseLabel={t('home.marquee.pause')}
      playLabel={t('home.marquee.play')}
      lang={lang}
    />
  </div>
</div>

<!-- 3 · The festival -->
<Section tone="cream" labelledby="intro-h">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-6">
      <ChapterLabel n={1} label={t('home.intro.chapter')} />
      <Headline id="intro-h" text={t('home.intro.h')} accent={t('home.intro.accent')} accentColor="blue" stack class="mt-6" data-reveal />
    </div>
    <div class="lg:col-span-5 lg:col-start-8 lg:pt-14">
      <p class="text-lg leading-relaxed text-navy/85 sm:text-xl" data-reveal>{t('about.p1')}</p>
      <p class="mt-4 text-lg leading-relaxed text-muted" data-reveal>{t('about.p2')}</p>
      <TextLink href={lp('/about')} label={t('home.intro.link')} class="mt-5" />
    </div>
  </div>
  <dl class="mt-16 grid grid-cols-2 border-t border-navy/10 lg:grid-cols-4" data-reveal-group>
    {facts.map((f, i) => (
      <div class:list={['flex flex-col-reverse gap-2 pb-2 pt-7', i % 2 === 1 && 'border-l border-navy/10 pl-5', i >= 2 && 'border-t border-navy/10 lg:border-t-0', i === 2 && 'lg:border-l lg:pl-5', i > 0 && 'lg:pl-6']}>
        <dt class="eyebrow text-muted">{f.label}</dt>
        <dd class="numeral text-[2.9rem] text-navy sm:text-[3.6rem] xl:text-[4.2rem]">
          <span data-count={f.value} data-pad={f.pad || undefined}>{String(f.value.toLocaleString('en-IN')).padStart(f.pad, '0')}</span>{f.suffix && <span class="text-coral-dark">{f.suffix}</span>}
        </dd>
      </div>
    ))}
  </dl>
</Section>

<!-- 4 · New Year's Eve -->
<section class="bg-cream pb-6 sm:pb-10" aria-labelledby="nye-h">
  <div class="container-kilf">
    <div class="panel on-dark grain grid bg-navy-deep text-cream lg:grid-cols-2">
      <div class="relative px-7 py-14 sm:px-12 sm:py-16 lg:px-16 lg:py-20">
        <ChapterLabel n={2} label={t('home.nye.chapter')} tone="dark" />
        <Headline id="nye-h" text={t('home.nye.h')} accent={t('home.nye.accent')} tone="dark" accentColor="lime" size="xl" class="mt-6" />
        <p class="mt-6 max-w-md text-xl leading-snug text-cream/85">{t('home.nye.lead')}</p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {[['moon', t('home.nye.1')], ['music', t('home.nye.2')], ['sparkle', t('home.nye.3')]].map(([icon, label]) => (
            <li class="inline-flex items-center gap-2 rounded-full py-2 pl-3 pr-4 text-[0.92rem] font-semibold ring-1 ring-inset ring-white/20">
              <Icon name={icon} size={18} class="text-lime" />
              {label}
            </li>
          ))}
        </ul>
        <div class="mt-12 border-t border-white/10 pt-8">
          <Countdown
            client:visible
            target={site.startISO}
            initial={initial}
            labels={{ title: t('countdown.title'), days: t('countdown.days'), hours: t('countdown.hours'), minutes: t('countdown.minutes'), live: t('countdown.live') }}
          />
        </div>
      </div>
      <div class="relative min-h-[20rem] sm:min-h-[26rem] lg:min-h-full">
        {
          realNye ? (
            <Illustration src="illustrations/nye.jpg" alt="" sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
          ) : (
            <div class="absolute inset-0"><LakeWindow palette="night" rounded={false} class="size-full" rain={1.8} /></div>
          )
        }
      </div>
    </div>
  </div>
</section>

<!-- 5 · Voices -->
<Section tone="cream" labelledby="voices-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <ChapterLabel n={3} label={t('home.voices.chapter')} />
      <Headline id="voices-h" text={t('home.voices.h')} accent={t('home.voices.accent')} class="mt-6" />
      <p class="mt-4 text-sm font-medium text-muted">{t('home.voices.note')}</p>
    </div>
    <TextLink href={lp('/speakers')} label={t('cta.seeSpeakers')} />
  </div>
  <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-9 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-6 lg:gap-y-12" data-reveal-group>
    {speakers.map((s) => <SpeakerCard name={s.data.name} role={s.data.role} photo={s.data.photo} lang="en" />)}
  </ul>
</Section>

<!-- 6 · Strands -->
<Section tone="white" labelledby="strands-h" class="border-y border-navy/5">
  <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <ChapterLabel n={4} label={t('home.strands.chapter')} />
      <Headline id="strands-h" text={t('home.strands.h')} accent={t('home.strands.accent')} class="mt-6" />
    </div>
    <p class="max-w-md text-lg text-muted lg:col-span-5 lg:justify-self-end">{t('home.strands.lead')}</p>
  </div>
  <div class="mt-12"><StrandGrid lang={lang} /></div>
</Section>

<!-- 7 · Khasakkinte Ithihasam -->
<Section tone="cream" labelledby="khasak-h">
  <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="panel aspect-[4/3] bg-navy lg:col-span-6 lg:aspect-[5/6]">
      <Illustration src="illustrations/p4_stage.jpg" alt="A theatre stage under a single spotlight." sizes="(min-width: 1024px) 45vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
    </div>
    <div class="lg:col-span-6">
      <div class="flex flex-wrap items-center gap-3">
        <ChapterLabel n={5} label={t('home.khasak.chapter')} />
        <Badge>{t('home.khasak.proposed')}</Badge>
      </div>
      <Headline id="khasak-h" text={t('home.khasak.h')} accent={t('home.khasak.accent')} class="mt-6" stack />
      <p class="mt-6 max-w-lg text-lg text-navy/80">{t('home.khasak.lead')}</p>
      <blockquote class="mt-8 max-w-lg border-l-2 border-coral pl-5 font-[family-name:var(--font-serif)] text-[1.9rem] italic leading-tight text-navy">
        {t('home.khasak.quote')}
      </blockquote>
      <LimeButton href={lp('/khasak')} label={t('cta.learnMore')} class="mt-9" />
    </div>
  </div>
</Section>

<!-- 8 · Youth -->
<section class="bg-cream pb-6 sm:pb-10" aria-labelledby="youth-h">
  <div class="container-kilf">
    <div class="panel on-dark grain bg-blue-bright px-7 py-14 text-white sm:px-12 sm:py-16 lg:px-16 lg:py-20">
      <RippleField client:visible tone="lime" x={90} y={24} size={520} />
      <div class="relative grid items-center gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <ChapterLabel n={6} label={t('home.youth.chapter')} tone="dark" />
          <Headline id="youth-h" text={t('home.youth.h')} accent={t('home.youth.accent')} tone="blue" size="xl" class="mt-6" />
          <p class="mt-6 max-w-lg text-lg text-white/90">{t('home.youth.lead')}</p>
          <LimeButton href={lp('/youth')} label={t('home.youth.cta')} size="lg" class="mt-9" />
        </div>
        <ul class="flex flex-wrap gap-2.5" lang="en" aria-label="Youth activities (proposed)" data-reveal-group>
          {youthChips.map((c) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2.5 text-base font-semibold ring-1 ring-inset ring-white/25 sm:text-lg">
              <span class="size-1.5 rounded-full bg-lime"></span>{c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 9 · Statement -->
<section class="relative overflow-hidden bg-cream py-24 text-navy sm:py-32" aria-labelledby="statement-h">
  <RippleField client:visible tone="light" x={50} y={55} size={760} squash={0.34} follow />
  <div class="container-kilf relative text-center">
    <p class="eyebrow text-coral-ink" data-reveal>{t('home.statement.kicker')}</p>
    <h2 id="statement-h" class:list={['display mx-auto mt-6 max-w-5xl', ml ? 'text-[2.2rem] sm:text-[3.4rem] lg:text-[4.4rem]' : 'text-[2.7rem] sm:text-[4.4rem] lg:text-[5.8rem]']} data-reveal>
      {t('home.statement.h')} <em class="serif-accent text-coral-dark">{t('home.statement.accent')}</em>
    </h2>
    <p class="mx-auto mt-7 max-w-xl text-lg text-muted sm:text-xl" data-reveal>{t('home.statement.lead')}</p>
    <TextLink href={lp('/about')} label={t('home.statement.link')} class="mt-5" />
  </div>
</section>

<!-- 10 · Be part of KILF -->
<Section tone="white" labelledby="involved-h" class="border-y border-navy/5">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <ChapterLabel n={7} label={t('home.involved.chapter')} />
      <Headline id="involved-h" text={t('home.involved.h')} accent={t('home.involved.accent')} class="mt-6" />
      <p class="mt-6 max-w-sm text-lg text-muted">{t('home.involved.lead')}</p>
    </div>
    <div class="lg:col-span-8"><InvolvedCards lang={lang} /></div>
  </div>
</Section>

<!-- 11 · Newsletter / WhatsApp -->
<section class="bg-cream py-14 sm:py-20" aria-labelledby="newsletter-h">
  <div class="container-kilf">
    <div class="panel bg-sky px-6 py-12 sm:px-12 sm:py-14 lg:px-16 lg:py-16">
      <RippleField client:visible tone="light" x={4} y={90} size={460} waves />
      <div class="relative"><SignupBlock lang={lang} chapter={8} tone="light" /></div>
    </div>
  </div>
</section>

<script>
  // Keep the "days to go" chip current (the build may be days old).
  document.querySelectorAll<HTMLElement>('[data-days-left]').forEach((el) => {
    const days = Math.max(0, Math.floor((new Date(el.dataset.daysLeft!).getTime() - Date.now()) / 86400000));
    el.textContent = String(days);
  });
</script>
