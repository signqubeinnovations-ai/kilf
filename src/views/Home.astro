---
import { getCollection } from 'astro:content';
import Illustration from '@/components/Illustration.astro';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import LimeButton from '@/components/LimeButton.astro';
import TextLink from '@/components/TextLink.astro';
import SpeakerCard from '@/components/SpeakerCard.astro';
import Section from '@/components/Section.astro';
import Badge from '@/components/Badge.astro';
import MotionToggle from '@/components/MotionToggle.astro';
import LakeArt from '@/components/LakeArt.astro';
import WaysIn from '@/components/blocks/WaysIn.astro';
import InvolvedCards from '@/components/blocks/InvolvedCards.astro';
import SignupBlock from '@/components/blocks/SignupBlock.astro';
import RippleField from '@/components/motion/RippleField';
import Marquee from '@/components/motion/Marquee';
import Countdown from '@/components/motion/Countdown';
import { site } from '@/lib/site';
import { useTranslations, localizePath, type Lang, type UIKey } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const ml = lang === 'ml';

const speakers = (await getCollection('speakers'))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 8);
const strands = (await getCollection('strands')).sort((a, b) => a.data.order - b.data.order);

const youthChips = ['Poetry Slam', 'Open Mic Nights', 'Reels & Short-Film Challenge', 'Indie & Rap Night', 'Meet Your Favourite Authors', 'Campus Ambassadors'];

// Build-time countdown values (the client takes over after hydration).
const left = Math.max(0, new Date(site.startISO).getTime() - Date.now());
const initial: [number, number, number] = [Math.floor(left / 86400000), Math.floor((left % 86400000) / 3600000), Math.floor((left % 3600000) / 60000)];

const facts = [
  { value: 100, pad: 0, suffix: '+', label: t('home.stats.speakers') },
  { value: 10000, pad: 0, suffix: '+', label: t('home.stats.audience') },
  { value: strands.length, pad: 2, suffix: '', label: t('home.facts.strands') },
  { value: site.venues.length, pad: 2, suffix: '', label: t('home.facts.venues') },
];
const nyeDetails = [
  [t('home.hero.when'), t('home.nye.whenValue')],
  [t('home.hero.where'), t('home.hero.place')],
  [t('home.nye.onNight'), [t('home.nye.1'), t('home.nye.2'), t('home.nye.3')].join(' · ')],
];
---

<!-- Hero: the lake illustration covers the whole section, and its water is live -->
<section class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-cream text-navy lg:min-h-[min(100svh,66rem)]" data-hero aria-labelledby="hero-h">
  <div class="hero-art relative order-2 h-[24rem] sm:h-[32rem] lg:absolute lg:inset-0 lg:-z-10 lg:h-auto" data-hero-art>
    <LakeArt
      art="hero"
      priority
      sizes="(max-width: 639px) 194vw, (max-width: 1023px) 160vw, (max-aspect-ratio: 97/50) 194vh, 100vw"
      imgClass="object-[74%_100%] sm:object-[82%_100%] lg:object-[100%_100%]"
      class="art-settle size-full"
    />
    <div class="hero-mist pointer-events-none absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="container-kilf pointer-events-none relative order-1 flex flex-col justify-center pb-6 pt-[calc(var(--hh)+2rem)] lg:flex-1 lg:pb-24 lg:pt-[calc(var(--hh)+2.5rem)]" data-hero-copy>
    <div class="max-w-[52rem] [&_a]:pointer-events-auto">
      <p class="eyebrow hero-in">{t('home.kicker')}</p>
      <h1 id="hero-h" class:list={['display hero-in mt-5 font-bold tracking-[-0.045em]', ml ? 'text-[clamp(2.1rem,10vw,2.6rem)] sm:text-[3.2rem] lg:text-[3.7rem] xl:text-[4.2rem]' : 'text-[clamp(2.3rem,11.4vw,3.2rem)] leading-[1.02] sm:text-[3.6rem] lg:text-[4.2rem] xl:text-[4.9rem]']} style="--d:0.08s">
        {t('home.title')}<br /> <span class="text-grad">{t('home.titleAccent')}</span>
      </h1>
      <p class="hero-in mt-6 font-display text-[1.4rem] font-semibold leading-snug tracking-[-0.025em] text-navy sm:text-[1.7rem]" style="--d:0.16s">{t('home.tagline')} {t('home.taglineAccent')}</p>
      <p class="hero-in mt-2 max-w-md text-lg leading-relaxed text-navy/75" style="--d:0.22s">{t('home.water')}</p>
      <div class="hero-in mt-9 flex flex-wrap items-center gap-x-8 gap-y-5" style="--d:0.28s">
        <LimeButton href={lp('/programme')} label={t('cta.explore')} size="lg" class="min-w-[15.5rem] justify-between !gap-10" />
        <TextLink href={lp('/passes')} label={t('home.hero.passLink')} />
      </div>
      <p class="hero-in mt-10 flex flex-wrap items-baseline gap-x-3 gap-y-1" style="--d:0.36s">
        <span class="eyebrow">{t('site.dates')}</span><span class="text-navy/75">{t('site.city')}</span>
      </p>
    </div>
  </div>

  <div class="container-kilf pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 pb-4 sm:pb-7">
    <a href="#festival" class="eyebrow pointer-events-auto inline-flex min-h-11 items-center gap-2 bg-cream/85 px-3 backdrop-blur-sm hover:text-blue-bright sm:bg-transparent sm:px-0 sm:backdrop-blur-none">{t('home.hero.turn')} <span aria-hidden="true" class="turn">↓</span></a>
    <div class="pointer-events-auto flex items-center gap-3 bg-cream/90 py-1.5 pl-4 pr-1.5 backdrop-blur-sm">
      <span class="eyebrow hidden text-[0.66rem] sm:inline">{t('home.hero.caption')}</span>
      <MotionToggle lang={lang} tone="light" />
    </div>
  </div>
</section>

<!-- The nine strands, drifting past on the coral band -->
<div class="bg-coral py-4 text-ink sm:py-5">
  <div class="container-kilf">
    <Marquee
      client:visible
      items={strands.map((s) => (ml ? s.data.name_ml : s.data.name))}
      listLabel={t('home.marquee.label')}
      pauseLabel={t('home.marquee.pause')}
      playLabel={t('home.marquee.play')}
      lang={lang}
    />
  </div>
</div>

<!-- 01 · The festival -->
<Section tone="cream" id="festival" labelledby="intro-h">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <ChapterLabel n={1} label={t('home.intro.chapter')} />
      <p class="mt-14 flex items-center gap-5 text-blue-bright" data-reveal>
        <span class="numeral text-[6.5rem] sm:text-[8rem]" data-count={site.days} data-pad="2">0{site.days}</span>
        <span class="eyebrow max-w-[7rem] leading-snug">{t('home.facts.days')}</span>
      </p>
    </div>
    <div class="lg:col-span-7">
      <Headline id="intro-h" text={t('home.live.h')} accent={t('home.live.accent')} size="xl" accentStyle="gradient" data-reveal />
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted" data-reveal>{t('about.p1')}</p>
      <TextLink href={lp('/about')} label={t('home.intro.link')} class="mt-6" />
    </div>
  </div>
  <dl class="mt-20 grid grid-cols-2 border-t border-line lg:grid-cols-4" data-reveal-group>
    {facts.map((f, i) => (
      <div class:list={['flex flex-col-reverse gap-2 pb-2 pt-7', i % 2 === 1 && 'border-l border-line pl-5', i >= 2 && 'border-t border-line lg:border-t-0', i === 2 && 'lg:border-l lg:pl-5', i > 0 && 'lg:pl-6']}>
        <dt class="eyebrow text-navy">{f.label}</dt>
        <dd class="numeral text-[2.8rem] text-navy sm:text-[3.4rem] xl:text-[4rem]">
          <span data-count={f.value} data-pad={f.pad || undefined}>{String(f.value.toLocaleString('en-IN')).padStart(f.pad, '0')}</span>{f.suffix && <span class="text-blue-bright">{f.suffix}</span>}
        </dd>
      </div>
    ))}
  </dl>
</Section>

<!-- 02 · Voices -->
<Section tone="ink" labelledby="voices-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <ChapterLabel n={2} label={t('home.voices.chapter')} tone="dark" />
      <Headline id="voices-h" text={t('home.voices.h')} accent={t('home.voices.accent')} tone="dark" class="mt-6" />
      <p class="mt-4 text-sm font-medium text-mist">{t('home.voices.note')}</p>
    </div>
    <TextLink href={lp('/speakers')} label={t('cta.seeSpeakers')} tone="dark" />
  </div>
  <ul class="mt-14 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-6 lg:gap-y-12" data-reveal-group>
    {speakers.map((s) => <SpeakerCard name={s.data.name} role={s.data.role} photo={s.data.photo} lang="en" tone="dark" />)}
  </ul>
</Section>

<!-- 03 · Ways in -->
<Section tone="cream" labelledby="ways-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <ChapterLabel n={3} label={t('home.ways.chapter')} />
      <Headline id="ways-h" text={t('home.ways.h')} accent={t('home.ways.accent')} class="mt-6" />
    </div>
    <TextLink href={lp('/programme')} label={t('home.ways.link')} />
  </div>
  <div class="mt-12"><WaysIn lang={lang} /></div>
</Section>

<!-- Statement -->
<section class="relative overflow-hidden bg-coral py-24 text-ink sm:py-32" aria-labelledby="statement-h">
  <RippleField client:visible tone="coral" x={50} y={56} size={760} squash={0.34} follow />
  <div class="container-kilf relative text-center">
    <p class="eyebrow" data-reveal>{t('home.statement.kicker')}</p>
    <h2 id="statement-h" class:list={['display mx-auto mt-7 max-w-5xl', ml ? 'text-[2.2rem] sm:text-[3.2rem] lg:text-[4.2rem]' : 'text-[2.6rem] sm:text-[4.2rem] lg:text-[5.4rem]']} data-reveal>
      {t('home.statement.h')}<br /><span class="text-grad-ink">{t('home.statement.accent')}</span>
    </h2>
    <div class="mx-auto mt-10 flex max-w-3xl flex-col items-center gap-6 sm:flex-row sm:justify-center sm:gap-10" data-reveal>
      <p class="max-w-md text-[1.02rem] leading-relaxed sm:text-left">{t('home.statement.lead')}</p>
      <TextLink href={lp('/about')} label={t('home.statement.link')} tone="navy" class="shrink-0" />
    </div>
  </div>
</section>

<!-- 04 · A day at KILF -->
<Section tone="cream" labelledby="day-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <ChapterLabel n={4} label={t('home.day.chapter')} />
      <Headline id="day-h" text={t('home.day.h')} accent={t('home.day.accent')} class="mt-6" />
    </div>
    <div class="max-w-sm">
      <p class="text-[0.98rem] leading-relaxed text-muted">{t('home.day.note')}</p>
      <TextLink href={lp('/programme')} label={t('home.day.link')} class="mt-4" />
    </div>
  </div>
  <ol class="mt-12 grid border-t border-line sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {([1, 2, 3, 4] as const).map((n, i) => (
      <li class:list={['relative border-b border-line py-8 sm:px-6', i % 2 === 1 && 'sm:border-l', i > 0 && 'lg:border-l', 'lg:first:pl-0']}>
        <p class="eyebrow text-blue-bright"><span lang="en">{String(n).padStart(2, '0')}</span> / {t(`home.day.${n}.t` as UIKey)}</p>
        <h3 class="mt-10 font-display text-[1.45rem] font-semibold leading-tight tracking-[-0.03em] text-navy">{t(`home.day.${n}.h` as UIKey)}</h3>
        <p class="mt-2 text-[0.98rem] leading-relaxed text-muted">{t(`home.day.${n}.d` as UIKey)}</p>
      </li>
    ))}
  </ol>
</Section>

<!-- 05 · New Year's Eve -->
<section class="on-dark waves-light relative overflow-hidden bg-blue text-white" aria-labelledby="nye-h">
  <RippleField client:visible tone="dark" x={34} y={50} size={900} squash={1} rings={3} />
  <div class="container-kilf relative grid gap-14 py-20 sm:py-28 lg:grid-cols-[1.3fr_1fr] lg:gap-16 lg:py-32">
    <div>
      <ChapterLabel n={5} label={t('home.nye.chapter')} tone="dark" />
      <Headline id="nye-h" text={t('home.nye.h')} accent={t('home.nye.accent')} tone="blue" size="xl" accentStyle="gradient" class="mt-6" inline />
      <p class="mt-6 max-w-md text-xl leading-snug text-white/85">{t('home.nye.lead')}</p>
      <div class="mt-12">
        <Countdown
          client:visible
          target={site.startISO}
          initial={initial}
          labels={{ title: t('countdown.title'), days: t('countdown.days'), hours: t('countdown.hours'), minutes: t('countdown.minutes'), live: t('countdown.live') }}
        />
      </div>
    </div>
    <dl class="space-y-8 self-center border-white/25 lg:border-l lg:pl-12">
      {nyeDetails.map(([label, value]) => (
        <div>
          <dt class="text-sm font-medium text-white/75">{label}</dt>
          <dd class="mt-1.5 text-lg font-medium text-white">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- 06 · Khasakkinte Ithihasam -->
<Section tone="cream" labelledby="khasak-h">
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="relative aspect-[4/3] overflow-hidden bg-navy lg:col-span-6 lg:aspect-square">
      <Illustration src="illustrations/p4_stage.jpg" alt="A theatre stage under a single spotlight." sizes="(min-width: 1024px) 45vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
    </div>
    <div class="lg:col-span-6">
      <div class="flex flex-wrap items-center gap-3">
        <ChapterLabel n={6} label={t('home.khasak.chapter')} />
        <Badge>{t('home.khasak.proposed')}</Badge>
      </div>
      <Headline id="khasak-h" text={t('home.khasak.h')} accent={t('home.khasak.accent')} accentStyle="gradient" class="mt-6" />
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">{t('home.khasak.lead')}</p>
      <blockquote class="mt-8 max-w-lg border-l-2 border-coral pl-5 font-display text-[1.6rem] font-medium leading-snug tracking-[-0.02em] text-navy">
        {t('home.khasak.quote')}
      </blockquote>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <LimeButton href={lp('/khasak#tickets')} label={t('home.khasak.tickets')} size="lg" />
        <TextLink href={lp('/khasak')} label={t('cta.learnMore')} />
      </div>
    </div>
  </div>
</Section>

<!-- 07 · Youth -->
<Section tone="cream" rule labelledby="youth-h">
  <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <ChapterLabel n={7} label={t('home.youth.chapter')} />
      <Headline id="youth-h" text={t('home.youth.h')} accent={t('home.youth.accent')} class="mt-6" />
      <p class="mt-6 max-w-md text-lg leading-relaxed text-muted">{t('home.youth.lead')}</p>
    </div>
    <div class="bg-lime p-8 text-ink sm:p-12" data-reveal>
      <p class="eyebrow">{t('home.youth.box')}</p>
      <ul class="mt-6 border-t border-ink/15" lang="en" aria-label="Youth activities (proposed)">
        {youthChips.map((c) => (
          <li class="flex items-center justify-between gap-4 border-b border-ink/15 py-3.5 font-display text-[1.15rem] font-semibold tracking-[-0.02em] sm:text-[1.3rem]">
            {c}<span aria-hidden="true" class="size-1.5 shrink-0 bg-blue"></span>
          </li>
        ))}
      </ul>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <LimeButton href={lp('/youth#college')} label={t('home.youth.cta')} />
        <TextLink href={lp('/youth')} label={t('home.youth.link')} tone="navy" />
      </div>
    </div>
  </div>
</Section>

<!-- 08 · Join in -->
<Section tone="cream" rule labelledby="involved-h">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <ChapterLabel n={8} label={t('home.involved.chapter')} />
      <Headline id="involved-h" text={t('home.involved.h')} accent={t('home.involved.accent')} size="xl" class="mt-6" />
      <p class="mt-6 max-w-sm text-lg leading-relaxed text-muted">{t('home.involved.lead')}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <LimeButton href={lp('/get-involved#register')} label={t('cta.register')} />
        <LimeButton href={lp('/get-involved#volunteer')} label={t('cta.volunteer')} variant="ghost" />
      </div>
    </div>
    <div class="lg:col-span-7"><InvolvedCards lang={lang} /></div>
  </div>
</Section>

<!-- Dates -->
<section class="bg-lime text-ink" aria-labelledby="dates-h">
  <div class="container-kilf py-16 sm:py-20">
    <h2 id="dates-h" class="sr-only">{t('site.dates')}</h2>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="eyebrow">{t('home.dates.kicker')}</p>
      <p class="eyebrow">{t('site.city')}</p>
    </div>
    <div class="mt-10 grid grid-cols-[1fr_auto_1fr] items-end gap-4 sm:gap-8" aria-hidden="true">
      <div>
        <p class="numeral text-grad-ink text-[clamp(2.5rem,13vw,3.4rem)] sm:text-[6.5rem] lg:text-[8.4rem]">31.12</p>
        <p class="mt-3 text-sm font-semibold tracking-[0.24em] sm:text-lg">2026</p>
      </div>
      <span class="arrow pb-9 text-3xl sm:pb-14 sm:text-5xl">→</span>
      <div class="text-right">
        <p class="numeral text-grad-ink text-[clamp(2.5rem,13vw,3.4rem)] sm:text-[6.5rem] lg:text-[8.4rem]">04.01</p>
        <p class="mt-3 text-sm font-semibold tracking-[0.24em] sm:text-lg">2027</p>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-6 border-t border-ink/15 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <ul class="text-[0.98rem] leading-relaxed" lang="en">
        {site.venues.map((v) => <li>{v.name}</li>)}
      </ul>
      <LimeButton href={lp('/visit')} label={t('cta.visit')} class="self-start sm:self-auto" />
    </div>
  </div>
</section>

<!-- 09 · Stay close -->
<Section tone="cream" labelledby="newsletter-h">
  <SignupBlock lang={lang} chapter={9} tone="light" />
</Section>

<script>
  // The picture drifts slower than the page, and the words lift away, as you scroll past.
  import { animate, scroll } from 'motion';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const art = hero?.querySelector<HTMLElement>('[data-hero-art]');
  const copy = hero?.querySelector<HTMLElement>('[data-hero-copy]');
  if (hero && art && copy && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const range = { target: hero, offset: ['start start', 'end start'] as ['start start', 'end start'] };
    scroll(animate(art, { transform: ['translateY(0px)', 'translateY(18vh)'] }, { ease: 'linear' }), range);
    scroll(animate(copy, { transform: ['translateY(0px)', 'translateY(-8vh)'], opacity: [1, 0.2] }, { ease: 'linear' }), range);
  }
</script>

<style>
  /* Phones and tablets: the picture sits under the words, its cream sky
     fading into the page. Desktop: it covers the whole hero. */
  .hero-art {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 24%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 24%);
  }
  @media (min-width: 1024px) {
    .hero-art {
      -webkit-mask-image: none;
      mask-image: none;
    }
    /* Morning mist over the lake: keeps the words legible, lets the water show */
    .hero-mist {
      background:
        linear-gradient(180deg, rgb(255 253 244 / 0.85) 0%, rgb(255 253 244 / 0) 22%),
        radial-gradient(ellipse 60% 76% at 16% 54%, rgb(255 253 244 / 0.92) 0%, rgb(255 253 244 / 0.72) 44%, rgb(255 253 244 / 0) 78%);
    }
  }
  /* The picture settles, like a camera coming to rest */
  .art-settle {
    animation: settle 2.6s var(--ease-calm) both;
  }
  @keyframes settle {
    from { transform: scale(1.06); }
    to { transform: none; }
  }
  .turn {
    display: inline-block;
    animation: bob 2.6s ease-in-out infinite;
  }
  .arrow {
    display: inline-block;
    animation: drift 3.2s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
  @keyframes drift {
    0%, 100% { transform: translateX(-4px); }
    50% { transform: translateX(6px); }
  }
</style>
