---
import { getCollection } from 'astro:content';
import Illustration from '@/components/Illustration.astro';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import LimeButton from '@/components/LimeButton.astro';
import TextLink from '@/components/TextLink.astro';
import Icon from '@/components/Icon.astro';
import SpeakerCard from '@/components/SpeakerCard.astro';
import Section from '@/components/Section.astro';
import Badge from '@/components/Badge.astro';
import MotionToggle from '@/components/MotionToggle.astro';
import StrandGrid from '@/components/blocks/StrandGrid.astro';
import InvolvedCards from '@/components/blocks/InvolvedCards.astro';
import SignupBlock from '@/components/blocks/SignupBlock.astro';
import LakeScene from '@/components/motion/LakeScene';
import NightLake from '@/components/motion/NightLake';
import RippleField from '@/components/motion/RippleField';
import Marquee from '@/components/motion/Marquee';
import Countdown from '@/components/motion/Countdown';
import { asset } from '@/lib/images';
import { site } from '@/lib/site';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const ml = lang === 'ml';

const speakers = (await getCollection('speakers'))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 12);
const strands = (await getCollection('strands')).sort((a, b) => a.data.order - b.data.order);

const youthChips = ['Poetry Slam', 'Open Mic Nights', 'Reels & Short-Film Challenge', 'Indie & Rap Night', 'Meet Your Favourite Authors', 'Campus Ambassadors'];

// Real artwork from kilf-assets/ wins; otherwise the animated scenes stand in.
const realCover = !asset('illustrations/cover.jpg').placeholder;
const realNye = !asset('illustrations/nye.jpg').placeholder;

// Build-time countdown values (the client takes over after hydration).
const left = Math.max(0, new Date(site.startISO).getTime() - Date.now());
const initial: [number, number, number] = [Math.floor(left / 86400000), Math.floor((left % 86400000) / 3600000), Math.floor((left % 3600000) / 60000)];

const facts = [
  { value: 5, pad: 2, suffix: '', label: t('home.facts.days') },
  { value: 100, pad: 0, suffix: '+', label: t('home.stats.speakers') },
  { value: 10000, pad: 0, suffix: '+', label: t('home.stats.audience') },
  { value: site.venues.length, pad: 2, suffix: '', label: t('home.facts.venues') },
];
---

<!-- 1 · Hero: the lake at first light -->
<section class="on-dark relative isolate overflow-hidden bg-blue-bright text-white" aria-labelledby="hero-h">
  <RippleField client:idle tone="dark" x={72} y={62} size={720} squash={0.36} follow />
  <div class="container-kilf relative grid items-center gap-12 pb-16 pt-[calc(var(--hh)+2.25rem)] sm:pb-20 lg:grid-cols-[1.08fr_1fr] lg:gap-14 lg:pb-24 lg:pt-[calc(var(--hh)+3.5rem)]">
    <div>
      <p class="eyebrow text-white/85 hero-in" style="--d:0s">{t('home.h1')}</p>
      <p class="mt-2 font-[family-name:var(--font-serif)] text-xl italic text-lime sm:text-2xl hero-in" style="--d:0.08s">{t('home.kicker')}</p>
      <h1 id="hero-h" class:list={['display mt-6 hero-in', ml ? 'text-[2.6rem] sm:text-[3.8rem] lg:text-[4.2rem] xl:text-[4.8rem]' : 'text-[3.3rem] sm:text-[5.2rem] lg:text-[5.6rem] xl:text-[6.6rem]']} style="--d:0.15s">
        <span class="sr-only">{t('home.h1')}: </span>{t('home.tagline')} <em class="serif-accent text-lime">{t('home.taglineAccent')}</em>
      </h1>
      <p class="mt-7 max-w-lg text-lg leading-relaxed text-white/90 sm:text-xl hero-in" style="--d:0.25s">{t('home.hero.lead')}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3 hero-in" style="--d:0.32s">
        <LimeButton href={lp('/get-involved#register')} label={t('cta.register')} size="lg" />
        <LimeButton href={lp('/programme')} label={t('cta.explore')} variant="outline-light" size="lg" />
      </div>
      <dl class="mt-11 grid max-w-lg grid-cols-2 gap-6 border-t border-white/20 pt-6 hero-in" style="--d:0.4s">
        <div>
          <dt class="eyebrow text-white/80">{t('home.hero.when')}</dt>
          <dd class="mt-1.5 font-semibold leading-snug"><time datetime={site.startDate}>{ml ? '2026 ഡിസം. 31' : '31 Dec 2026'}</time> – <time datetime={site.endDate}>{ml ? '2027 ജനു. 4' : '4 Jan 2027'}</time></dd>
        </div>
        <div>
          <dt class="eyebrow text-white/80">{t('home.hero.where')}</dt>
          <dd class="mt-1.5 font-semibold leading-snug">{t('home.hero.place')}</dd>
        </div>
      </dl>
    </div>

    <figure class="relative hero-in" style="--d:0.2s">
      <div class="relative aspect-square overflow-hidden rounded-[2rem] bg-sky shadow-[0_40px_80px_-40px_rgb(10_20_84/0.8)] ring-1 ring-white/25 sm:aspect-[5/4] lg:aspect-[4/5]">
        {
          realCover ? (
            <>
              <Illustration src="illustrations/cover.jpg" alt="" priority sizes="(min-width: 1024px) 46vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[60%_100%]" />
              <RippleField client:visible tone="dark" x={50} y={82} size={320} squash={0.22} />
            </>
          ) : (
            <LakeScene client:load />
          )
        }
        <p class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-navy/85 px-4 py-2 text-sm font-semibold text-cream backdrop-blur-sm">
          <span class="size-2 rounded-full bg-lime"></span><span data-days-left={site.startISO}>{initial[0]}</span> {t('home.hero.daysToGo')}
        </p>
      </div>
      <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-white/85">
        <span><em class="font-[family-name:var(--font-serif)] text-lg text-lime">{t('home.hero.touch')}</em> {t('home.hero.caption')}</span>
        <MotionToggle lang={lang} />
      </figcaption>
    </figure>
  </div>
</section>

<!-- 2 · The nine strands, drifting past -->
<div class="relative bg-coral py-4 text-navy sm:py-5">
  <Marquee
    client:visible
    items={strands.map((s) => (ml ? s.data.name_ml : s.data.name))}
    listLabel={t('home.marquee.label')}
    pauseLabel={t('home.marquee.pause')}
    playLabel={t('home.marquee.play')}
    lang={lang}
  />
</div>

<!-- 3 · The festival, in numbers -->
<Section tone="cream" waves labelledby="intro-h">
  <div class="grid gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:gap-20">
    <div>
      <ChapterLabel n={1} label={t('home.intro.chapter')} />
      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-10" data-reveal-group>
        {facts.map((f) => (
          <div class="flex flex-col-reverse border-t border-navy/15 pt-5">
            <dt class="eyebrow mt-3 text-muted">{f.label}</dt>
            <dd class="numeral text-[2.8rem] text-blue sm:text-[4.2rem] lg:text-[3.3rem] xl:text-[4.2rem]" data-count={f.value} data-suffix={f.suffix} data-pad={f.pad || undefined}>
              {String(f.value.toLocaleString('en-IN')).padStart(f.pad, '0')}{f.suffix}
            </dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="lg:pt-12">
      <Headline id="intro-h" text={t('home.intro.h')} accent={t('home.intro.accent')} accentColor="blue" stack data-reveal />
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-navy/85 sm:text-xl" data-reveal>{t('about.p1')}</p>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted" data-reveal>{t('about.p2')}</p>
      <TextLink href={lp('/about')} label={t('home.intro.link')} class="mt-6" />
    </div>
  </div>
</Section>

<!-- 4 · New Year's Eve -->
<section class="on-dark relative overflow-hidden bg-navy-deep text-cream" aria-labelledby="nye-h">
  <div class="grid lg:grid-cols-2">
    <div class="container-kilf py-20 sm:py-28 lg:ml-auto lg:max-w-[40rem] lg:pr-14">
      <ChapterLabel n={2} label={t('home.nye.chapter')} tone="dark" />
      <Headline id="nye-h" text={t('home.nye.h')} accent={t('home.nye.accent')} tone="dark" size="xl" class="mt-6" />
      <p class="mt-6 max-w-md text-xl leading-snug text-cream/90">{t('home.nye.lead')}</p>
      <ul class="mt-8 flex flex-wrap gap-2.5">
        {[['moon', t('home.nye.1')], ['music', t('home.nye.2')], ['sparkle', t('home.nye.3')]].map(([icon, label]) => (
          <li class="inline-flex items-center gap-2.5 rounded-full bg-white/8 py-2 pl-2 pr-4 text-[0.95rem] font-semibold ring-1 ring-inset ring-white/15">
            <span class="inline-grid size-8 place-items-center rounded-full bg-lime text-navy"><Icon name={icon} size={18} /></span>
            {label}
          </li>
        ))}
      </ul>
      <div class="mt-12 border-t border-white/15 pt-8">
        <Countdown
          client:visible
          target={site.startISO}
          initial={initial}
          labels={{ title: t('countdown.title'), days: t('countdown.days'), hours: t('countdown.hours'), minutes: t('countdown.minutes'), live: t('countdown.live') }}
        />
      </div>
    </div>
    <div class="relative min-h-[22rem] sm:min-h-[30rem] lg:min-h-full">
      {realNye ? <Illustration src="illustrations/nye.jpg" alt="" sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" /> : <NightLake client:visible />}
    </div>
  </div>
</section>

<!-- 5 · Voices -->
<Section tone="sky" waves labelledby="voices-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <ChapterLabel n={3} label={t('home.voices.chapter')} />
      <Headline id="voices-h" text={t('home.voices.h')} accent={t('home.voices.accent')} class="mt-6" />
      <p class="mt-4 text-sm font-semibold text-muted">{t('home.voices.note')}</p>
    </div>
    <TextLink href={lp('/speakers')} label={t('cta.seeSpeakers')} />
  </div>
  <ul class="mt-12 grid grid-cols-2 gap-x-3 gap-y-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6" data-reveal-group>
    {speakers.map((s) => <SpeakerCard name={s.data.name} role={s.data.role} photo={s.data.photo} size="sm" lang="en" />)}
  </ul>
</Section>

<!-- 6 · Strands -->
<Section tone="cream" waves labelledby="strands-h">
  <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
    <div>
      <ChapterLabel n={4} label={t('home.strands.chapter')} />
      <Headline id="strands-h" text={t('home.strands.h')} accent={t('home.strands.accent')} class="mt-6" />
    </div>
    <p class="max-w-md text-lg text-muted lg:justify-self-end">{t('home.strands.lead')}</p>
  </div>
  <div class="mt-12"><StrandGrid lang={lang} /></div>
</Section>

<!-- 7 · Khasakkinte Ithihasam -->
<section class="on-dark relative overflow-hidden bg-navy text-cream" aria-labelledby="khasak-h">
  <div class="grid lg:grid-cols-[1.1fr_1fr]">
    <div class="relative min-h-72 sm:min-h-96 lg:order-2 lg:min-h-full">
      <Illustration src="illustrations/p4_stage.jpg" alt="A theatre stage lit by a single spotlight: two figures beside a house and a great tree." sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
    </div>
    <div class="container-kilf py-20 sm:py-28 lg:ml-auto lg:max-w-[40rem] lg:pr-14">
      <div class="flex flex-wrap items-center gap-3">
        <ChapterLabel n={5} label={t('home.khasak.chapter')} tone="dark" />
        <Badge tone="dark">{t('home.khasak.proposed')}</Badge>
      </div>
      <Headline id="khasak-h" text={t('home.khasak.h')} accent={t('home.khasak.accent')} tone="dark" class="mt-6" stack />
      <p class="mt-6 max-w-lg text-lg text-cream/90">{t('home.khasak.lead')}</p>
      <blockquote class="mt-8 border-l-2 border-coral pl-5 font-[family-name:var(--font-serif)] text-[1.9rem] italic leading-tight">
        {t('home.khasak.quote')}
      </blockquote>
      <LimeButton href={lp('/khasak')} label={t('cta.learnMore')} class="mt-9" />
    </div>
  </div>
</section>

<!-- 8 · Youth -->
<Section tone="blue" labelledby="youth-h">
  <RippleField slot="backdrop" client:visible tone="lime" x={88} y={30} size={520} />
  <div class="grid items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <ChapterLabel n={6} label={t('home.youth.chapter')} tone="dark" />
      <Headline id="youth-h" text={t('home.youth.h')} accent={t('home.youth.accent')} tone="blue" size="xl" class="mt-6" />
      <p class="mt-6 max-w-lg text-lg text-white/90">{t('home.youth.lead')}</p>
      <LimeButton href={lp('/youth')} label={t('home.youth.cta')} size="lg" class="mt-9" />
    </div>
    <ul class="flex flex-wrap gap-2.5" lang="en" aria-label="Youth activities (proposed)" data-reveal-group>
      {youthChips.map((c, i) => (
        <li class:list={['rounded-full px-5 py-3 text-base font-bold transition-transform duration-500 ease-[var(--ease-calm)] hover:-translate-y-1 sm:text-lg', i % 3 === 0 ? 'bg-lime text-navy' : i % 3 === 1 ? 'bg-coral text-navy' : 'bg-white text-navy']}>{c}</li>
      ))}
    </ul>
  </div>
</Section>

<!-- 9 · Statement -->
<section class="relative overflow-hidden bg-coral py-24 text-navy sm:py-32" aria-labelledby="statement-h">
  <RippleField client:visible tone="coral" x={50} y={50} size={760} squash={0.34} follow />
  <div class="container-kilf relative text-center">
    <p class="eyebrow" data-reveal>{t('home.statement.kicker')}</p>
    <h2 id="statement-h" class:list={['display mx-auto mt-6 max-w-5xl', ml ? 'text-[2.2rem] sm:text-[3.4rem] lg:text-[4.4rem]' : 'text-[2.7rem] sm:text-[4.4rem] lg:text-[5.8rem]']} data-reveal>
      {t('home.statement.h')} <em class="serif-accent">{t('home.statement.accent')}</em>
    </h2>
    <p class="mx-auto mt-7 max-w-xl text-lg text-navy/90 sm:text-xl" data-reveal>{t('home.statement.lead')}</p>
    <TextLink href={lp('/about')} label={t('home.statement.link')} tone="navy" class="mt-5" />
  </div>
</section>

<!-- 10 · Be part of KILF -->
<Section tone="cream" waves labelledby="involved-h">
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div>
      <ChapterLabel n={7} label={t('home.involved.chapter')} />
      <Headline id="involved-h" text={t('home.involved.h')} accent={t('home.involved.accent')} class="mt-6" />
      <p class="mt-6 max-w-sm text-lg text-muted">{t('home.involved.lead')}</p>
    </div>
    <InvolvedCards lang={lang} />
  </div>
</Section>

<!-- 11 · Newsletter / WhatsApp -->
<Section tone="navy" labelledby="newsletter-h">
  <RippleField slot="backdrop" client:visible tone="dark" x={8} y={85} size={520} waves />
  <SignupBlock lang={lang} chapter={8} />
</Section>

<script>
  // Keep the "days to go" chip current (the build may be days old).
  document.querySelectorAll<HTMLElement>('[data-days-left]').forEach((el) => {
    const days = Math.max(0, Math.floor((new Date(el.dataset.daysLeft!).getTime() - Date.now()) / 86400000));
    el.textContent = String(days);
  });
</script>
