---
import fs from 'node:fs';
import path from 'node:path';
import Section from '@/components/Section.astro';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import Icon from '@/components/Icon.astro';
import LakeArt from '@/components/LakeArt.astro';
import LimeButton from '@/components/LimeButton.astro';
import TextLink from '@/components/TextLink.astro';
import Logo from '@/components/Logo.astro';
import Form from '@/components/Form.astro';
import Field from '@/components/Field.astro';
import Placeholder from '@/components/Placeholder.astro';
import data from '@/data/partnership.json';
import { site, env } from '@/lib/site';
import type { Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;

const proposalFile = 'downloads/kilf-2027-partnership-proposal.pdf';
const hasProposal = fs.existsSync(path.join(process.cwd(), 'public', proposalFile));
const callUrl = env.partnerCallUrl || `mailto:${site.email}?subject=${encodeURIComponent('KILF 2027 partnership call')}`;
---
<!-- Hook -->
<section class="on-dark relative overflow-hidden bg-blue-bright text-white" aria-labelledby="partners-h">
  <div class="waves-light pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="container-kilf relative pb-14 pt-14 sm:pb-16 sm:pt-20 lg:pt-24">
    <ChapterLabel n={1} label="Partner with KILF" tone="dark" class="hero-in" />
    <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
      <h1 id="partners-h" class="display hero-in text-[2.7rem] font-bold tracking-[-0.045em] sm:text-[4rem] lg:col-span-8 lg:text-[4.6rem]" style="--d:0.08s">
        Your brand. Our story. <span class="text-grad-warm">One lake.</span>
      </h1>
      <p class="hero-in max-w-md text-lg leading-relaxed text-white/85 lg:col-span-4 lg:pb-3" style="--d:0.16s">
        Five days, 100+ speakers and 10,000+ visitors on the shore of Ashtamudi. Become a founding partner of the first Kollam
        International Literature Festival.
      </p>
    </div>
    <div class="hero-in mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" style="--d:0.24s">
      <LimeButton href="#enquire" label="Enquire now" variant="lime" size="lg" class="min-w-[12rem] justify-between !gap-10" />
      <TextLink href={callUrl} label="Book a partnership call" tone="dark" />
    </div>
  </div>
  <div class="container-kilf relative pb-14 sm:pb-20">
    <LakeArt art="jetty" sizes="(min-width: 1280px) 1120px, 100vw" focus={[0.6, 0.5]} class="aspect-[16/10] w-full sm:aspect-[2.2/1] lg:aspect-[2.6/1]" />
  </div>
</section>

<!-- Why partner -->
<Section tone="cream" labelledby="why-h">
  <ChapterLabel n={2} label="Why partner" />
  <Headline id="why-h" text="Four reasons to be" accent="on the shore." class="mt-6" />
  <ul class="mt-12 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {data.why.map((w, i) => (
      <li class="flex min-h-[16rem] flex-col border-b border-r border-line p-7">
        <div class="flex items-start justify-between gap-4">
          <span class="eyebrow text-navy">{String(i + 1).padStart(2, '0')}</span>
          <Icon name={w.icon} size={28} class="text-blue-bright" />
        </div>
        <h3 class="mt-auto pt-10 font-display text-[1.35rem] font-semibold leading-tight tracking-[-0.03em]">{w.title}</h3>
        <p class="mt-2 text-muted">{w.text}</p>
      </li>
    ))}
  </ul>
</Section>

<!-- Audience -->
<Section tone="sky" labelledby="audience-h">
  <ChapterLabel n={3} label="Audience" />
  <Headline id="audience-h" text="Who you’ll" accent="meet." class="mt-6" />
  <ul class="mt-12 grid grid-cols-2 border-l border-t border-navy/15 md:grid-cols-3">
    {data.audience.map((a) => (
      <li class="flex flex-col gap-5 border-b border-r border-navy/15 bg-cream p-6 sm:flex-row sm:items-center sm:p-7">
        <Icon name={a.icon} size={28} class="shrink-0 text-blue-bright" />
        <span class="font-display text-lg font-semibold leading-tight tracking-[-0.02em]">{a.title}</span>
      </li>
    ))}
  </ul>
</Section>

<!-- Picture your brand here -->
<Section tone="cream" labelledby="picture-h">
  <ChapterLabel n={4} label="Visibility" />
  <Headline id="picture-h" text="Picture your brand" accent="here." class="mt-6" />
  <p class="mt-5 max-w-2xl text-lg text-muted">Illustrative mock-ups. Final placements depend on the partnership tier.</p>
  <div class="mt-12 grid gap-4 lg:grid-cols-[1.6fr_1fr_1fr]">
    <!-- stage banner -->
    <figure class="border border-line">
      <div class="on-dark relative aspect-[16/9] bg-footer p-5 text-white sm:p-7">
        <div class="flex h-full flex-col justify-between">
          <div class="flex items-center justify-between"><Logo tone="dark" class="h-8 sm:h-10" /><span class="border border-dashed border-lime/70 px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-lime sm:text-sm">Your logo</span></div>
          <p class="display text-2xl sm:text-4xl">Where words meet the <span class="text-grad-warm">world.</span></p>
          <p class="text-xs text-mist sm:text-sm">Main stage · Ashramam Maidan</p>
        </div>
      </div>
      <figcaption class="border-t border-line p-4 text-sm font-semibold">Main stage backdrop</figcaption>
    </figure>
    <!-- pass -->
    <figure class="flex flex-col border border-line">
      <div class="grid aspect-[16/9] flex-1 place-items-center bg-sky p-5 lg:aspect-auto">
        <div class="w-40 rotate-[-4deg] bg-cream p-4 shadow-[0_18px_40px_-20px_rgb(15_28_116/0.5)] ring-1 ring-line">
          <Logo class="h-7 text-blue" />
          <p class="mt-3 font-display text-lg font-semibold leading-none tracking-[-0.02em]">Festival<br /><span class="text-blue-bright">Pass</span></p>
          <p class="mt-2 text-[0.65rem] text-muted">31 Dec – 4 Jan</p>
          <div class="mt-3 border border-dashed border-blue/40 py-2 text-center text-[0.65rem] font-bold uppercase tracking-widest text-blue">Your logo</div>
        </div>
      </div>
      <figcaption class="border-t border-line p-4 text-sm font-semibold">Festival pass</figcaption>
    </figure>
    <!-- social post -->
    <figure class="flex flex-col border border-line">
      <div class="grid aspect-[16/9] flex-1 place-items-center bg-lime p-5 lg:aspect-auto">
        <div class="w-44 bg-white p-3 shadow-[0_18px_40px_-20px_rgb(15_28_116/0.5)]">
          <div class="flex items-center gap-2"><span class="size-6 rounded-full bg-navy"></span><span class="text-[0.7rem] font-bold">kilf2027</span></div>
          <div class="on-dark mt-2 grid aspect-square place-items-center bg-blue-bright p-3 text-center text-white">
            <p class="display text-base">Turn the <span class="text-lime">page.</span></p>
            <span class="mt-1 border border-dashed border-white/70 px-2 py-1 text-[0.55rem] font-bold uppercase tracking-widest">with your logo</span>
          </div>
          <div class="mt-2 flex gap-2 text-navy"><Icon name="heart" size={16} /><Icon name="chat" size={16} /></div>
        </div>
      </div>
      <figcaption class="border-t border-line p-4 text-sm font-semibold">Social media post</figcaption>
    </figure>
  </div>
</Section>

<!-- Tiers -->
<Section tone="cream" rule labelledby="tiers-h">
  <ChapterLabel n={5} label="Partnership tiers" />
  <Headline id="tiers-h" text="Choose your" accent="chapter." class="mt-6" />
  <ul class="mt-12 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-5">
    {data.tiers.map((tier) => (
      <li class:list={['flex flex-col border-b border-r border-line p-7', tier.highlight ? 'on-dark bg-blue text-white' : 'bg-cream']}>
        {tier.count.length <= 2 ? (
          <span class:list={['numeral text-5xl', tier.highlight ? 'text-lime' : 'text-blue-bright']}>{tier.count.padStart(2, '0')}</span>
        ) : (
          <span class:list={['eyebrow', tier.highlight ? 'text-lime' : 'text-blue-bright']}>{tier.count}</span>
        )}
        <h3 class="mt-6 font-display text-xl font-semibold leading-tight tracking-[-0.02em]">{tier.name}</h3>
        <p class:list={['mt-2 flex-1 text-[0.95rem]', tier.highlight ? 'text-white/85' : 'text-muted']}>{tier.text}</p>
        <p class:list={['eyebrow mt-6 border-t pt-4', tier.highlight ? 'border-white/20 text-white/80' : 'border-line text-navy']}>Pricing on request</p>
      </li>
    ))}
  </ul>

  <!-- Benefits matrix -->
  <h3 class="display mt-20 text-3xl text-navy sm:text-4xl">Benefits at a <span class="text-blue-bright">glance.</span></h3>
  <div class="mt-8 overflow-x-auto border border-line" tabindex="0" role="region" aria-label="Benefits by tier (scrolls horizontally)">
    <table class="w-full min-w-[42rem] border-collapse text-left text-sm sm:text-base">
      <caption class="sr-only">Partnership benefits by tier</caption>
      <thead class="bg-footer text-white">
        <tr>
          <th scope="col" class="p-4 font-semibold">Benefit</th>
          {data.matrixColumns.map((c) => <th scope="col" class="p-4 text-center font-semibold">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {data.matrix.map((row) => (
          <tr class="border-t border-line bg-cream">
            <th scope="row" class="p-4 font-medium">{row.benefit}</th>
            {row.tiers.map((on) => (
              <td class="p-4 text-center">
                {on ? (
                  <span class="inline-grid size-7 place-items-center bg-lime text-ink"><Icon name="check" size={16} label="Included" /></span>
                ) : (
                  <span class="text-line" aria-label="Not included">—</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-sm text-muted">Benefits are indicative and tailored with each partner.</p>
</Section>

<!-- Enquiry -->
<Section tone="sky" id="enquire" labelledby="enquire-h">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div>
      <ChapterLabel n={6} label="Enquire" />
      <Headline id="enquire-h" text="Let’s write this" accent="together." class="mt-6" />
      <p class="mt-6 max-w-md text-lg leading-relaxed text-navy/80">Tell us a little about your brand and we’ll share the full proposal and tailored options.</p>
      <div class="mt-9 flex flex-col items-start gap-4">
        <LimeButton href={callUrl} label="Book a partnership call" external={!!env.partnerCallUrl} />
        {
          hasProposal ? (
            <a href={`/${proposalFile}`} download class="inline-flex min-h-11 items-center gap-2 font-semibold text-navy underline decoration-1 underline-offset-4 hover:text-blue">
              <Icon name="download" size={20} /> Download the partnership proposal (PDF)
            </a>
          ) : (
            <p class="inline-flex items-center gap-2 text-sm text-muted">
              <Icon name="download" size={20} /> Proposal PDF: <Placeholder value="[PROPOSAL PDF]" />
            </p>
          )
        }
        <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center gap-2 font-semibold text-navy hover:text-blue"><Icon name="mail" size={20} class="text-blue-bright" />{site.email}</a>
      </div>
    </div>
    <Form id="partner-form" name="partner" lang={lang} endpoint={env.formEndpointPartner || env.formEndpoint} class="border border-navy/10 bg-cream p-6 sm:p-9" successText="Thank you. Our partnerships team will be in touch shortly.">
      <Field formId="partner-form" name="name" label="Name" autocomplete="name" required />
      <Field formId="partner-form" name="email" type="email" label="Work email" autocomplete="email" required />
      <Field formId="partner-form" name="phone" type="tel" label="Phone" autocomplete="tel" inputmode="tel" required />
      <Field formId="partner-form" name="organisation" label="Company / brand" autocomplete="organization" required />
      <Field formId="partner-form" name="tier" type="select" label="Interested in" options={[...data.tiers.map((t) => t.name), 'Not sure yet']} full />
      <Field formId="partner-form" name="message" type="textarea" label="Message" full rows={4} />
    </Form>
  </div>
</Section>
