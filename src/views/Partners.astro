---
import fs from 'node:fs';
import path from 'node:path';
import Section from '@/components/Section.astro';
import ChapterLabel from '@/components/ChapterLabel.astro';
import Headline from '@/components/Headline.astro';
import Icon from '@/components/Icon.astro';
import LakeArt from '@/components/LakeArt.astro';
import LimeButton from '@/components/LimeButton.astro';
import TextLink from '@/components/TextLink.astro';
import Logo from '@/components/Logo.astro';
import Form from '@/components/Form.astro';
import Field from '@/components/Field.astro';
import Placeholder from '@/components/Placeholder.astro';
import data from '@/data/partnership.json';
import { site, env } from '@/lib/site';
import { headings, type Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = headings(lang);

const proposalFile = 'downloads/kilf-2027-partnership-proposal.pdf';
const hasProposal = fs.existsSync(path.join(process.cwd(), 'public', proposalFile));
const callUrl = env.partnerCallUrl || `mailto:${site.email}?subject=${encodeURIComponent('KILF 2027 partnership call')}`;
const steps = [
  ['Enquire', 'Send the form below, or book a call. Tell us about your brand and what you’d like KILF to do for it.'],
  ['Talk it through', 'We share the full proposal and shape the options around your goals and budget.'],
  ['Agree the chapter', 'Choose your tier and benefits. We confirm everything in writing.'],
  ['On the shore', 'Your brand goes live across the festival, online and by the lake.'],
];
// How many partners each tier takes: a number of places, or a word.
const places = (count: string) => (/^\d+$/.test(count) ? `${count} ${count === '1' ? 'place' : 'places'}` : count);
---
<!-- Hook -->
<section class="relative overflow-hidden bg-cream text-navy" aria-labelledby="partners-h">
  <div class="container-kilf relative pb-14 pt-14 sm:pb-16 sm:pt-20 lg:pt-24">
    <ChapterLabel label={h('Partner with KILF', 'KILF-ന്റെ പങ്കാളിയാകാം')} lang={h.lang} />
    <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
      <Headline as="h1" size="xl" id="partners-h" text={h('Your brand. Our story.', 'നിങ്ങളുടെ ബ്രാൻഡ്. ഞങ്ങളുടെ കഥ.')} accent={h('One lake.', 'ഒരേ കായൽ.')} lang={h.lang} class="lg:col-span-8" />
      <p class="max-w-md text-lg leading-relaxed text-muted lg:col-span-4 lg:pb-3">
        Five days on the shore of Ashtamudi, from New Year’s Eve into 2027. Become a founding partner of the first Kollam
        International Literature Festival.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <LimeButton href="#enquire" label="Enquire now" size="lg" />
      <TextLink href={callUrl} label="Book a partnership call" />
    </div>
  </div>
  <div class="container-kilf relative pb-16 sm:pb-24">
    <LakeArt art="jetty" sizes="(min-width: 1280px) 1120px, 100vw" focus={[0.6, 0.5]} class="aspect-[16/10] w-full rounded-[1.25rem] sm:aspect-[2.2/1] lg:aspect-[2.6/1]" />
  </div>
</section>

<!-- Why partner -->
<Section tone="cream" rule labelledby="why-h">
  <ChapterLabel label={h('Why partner', 'എന്തിന് പങ്കാളിയാകണം')} lang={h.lang} />
  <Headline id="why-h" text={h('Four reasons to be', 'തീരത്തുണ്ടാകാൻ')} accent={h('on the shore.', 'നാലു കാരണങ്ങൾ.')} lang={h.lang} class="mt-6" />
  <ul class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {data.why.map((w) => (
      <li class="border-t border-line pt-6">
        <Icon name={w.icon} size={28} class="text-cobalt" />
        <h3 class="mt-6 font-display text-[1.3rem] leading-tight tracking-[-0.03em]">{w.title}</h3>
        <p class="mt-2 text-muted">{w.text}</p>
      </li>
    ))}
  </ul>
</Section>

<!-- Audience -->
<Section tone="sky" labelledby="audience-h">
  <ChapterLabel label={h('Audience', 'പ്രേക്ഷകർ')} lang={h.lang} />
  <Headline id="audience-h" text={h('Who you’ll', 'നിങ്ങൾ')} accent={h('meet.', 'കണ്ടുമുട്ടുന്നവർ.')} lang={h.lang} class="mt-6" />
  <ul class="mt-12 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
    {data.audience.map((a) => (
      <li class="flex items-center gap-5 border-t border-navy/15 py-6">
        <Icon name={a.icon} size={26} class="shrink-0 text-cobalt" />
        <span class="font-display text-lg font-extrabold leading-tight tracking-[-0.02em]">{a.title}</span>
      </li>
    ))}
  </ul>
</Section>

<!-- Picture your brand here -->
<Section tone="cream" labelledby="picture-h">
  <ChapterLabel label={h('Visibility', 'ദൃശ്യത')} lang={h.lang} />
  <Headline id="picture-h" text={h('Picture your brand', 'നിങ്ങളുടെ ബ്രാൻഡ്')} accent={h('here.', 'ഇവിടെ.')} lang={h.lang} class="mt-6" />
  <p class="mt-5 max-w-2xl text-lg text-muted">Illustrative mock-ups. Final placements depend on the partnership tier.</p>
  <div class="mt-12 grid gap-4 lg:grid-cols-[1.6fr_1fr_1fr]">
    <!-- stage banner -->
    <figure class="border border-line">
      <div class="on-dark relative aspect-[16/9] bg-night p-5 text-white sm:p-7">
        <div class="flex h-full flex-col justify-between">
          <div class="flex items-center justify-between"><Logo tone="dark" wrap="wide" class="[--h:1.8rem] sm:[--h:2.4rem]" /><span class="border border-dashed border-water/70 px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-water-light sm:text-sm">Your logo</span></div>
          <p class="display text-2xl sm:text-4xl"><span class="text-red-bright">Pause.</span> Turn a page.</p>
          <p class="text-xs text-mist sm:text-sm">Main stage · Sree Narayana Cultural Complex</p>
        </div>
      </div>
      <figcaption class="border-t border-line p-4 text-sm font-bold">Main stage backdrop</figcaption>
    </figure>
    <!-- pass -->
    <figure class="flex flex-col border border-line">
      <div class="grid aspect-[16/9] flex-1 place-items-center bg-lake-soft p-5 lg:aspect-auto">
        <div class="w-40 rotate-[-4deg] bg-cream p-4 shadow-[0_18px_40px_-20px_rgb(11_26_74/0.4)] ring-1 ring-line">
          <Logo markOnly class="[--h:2.2rem]" />
          <p class="mt-3 font-display text-lg font-extrabold leading-none tracking-[-0.02em]">Festival<br /><span class="text-coral-ink">Pass</span></p>
          <p class="mt-2 text-[0.65rem] text-muted">31 Dec – 4 Jan</p>
          <div class="mt-3 border border-dashed border-ink/40 py-2 text-center text-[0.65rem] font-bold uppercase tracking-widest text-ink">Your logo</div>
        </div>
      </div>
      <figcaption class="border-t border-line p-4 text-sm font-bold">Festival pass</figcaption>
    </figure>
    <!-- social post -->
    <figure class="flex flex-col border border-line">
      <div class="grid aspect-[16/9] flex-1 place-items-center bg-lake p-5 lg:aspect-auto">
        <div class="w-44 bg-white p-3 shadow-[0_18px_40px_-20px_rgb(11_26_74/0.4)]">
          <div class="flex items-center gap-2"><span class="size-6 rounded-full bg-navy"></span><span class="text-[0.7rem] font-bold">kilf2027</span></div>
          <div class="mt-2 grid aspect-square place-items-center bg-coral p-3 text-center text-navy">
            <p class="display text-base">Pause. Turn a page.</p>
            <span class="mt-1 border border-dashed border-navy/60 px-2 py-1 text-[0.55rem] font-bold uppercase tracking-widest">with your logo</span>
          </div>
          <div class="mt-2 flex gap-2 text-navy"><Icon name="heart" size={16} /><Icon name="chat" size={16} /></div>
        </div>
      </div>
      <figcaption class="border-t border-line p-4 text-sm font-bold">Social media post</figcaption>
    </figure>
  </div>
</Section>

<!-- Tiers -->
<Section tone="cream" rule labelledby="tiers-h">
  <ChapterLabel label={h('Partnership tiers', 'പങ്കാളിത്ത തലങ്ങൾ')} lang={h.lang} />
  <Headline id="tiers-h" text={h('Choose your', 'നിങ്ങളുടെ അധ്യായം')} accent={h('chapter.', 'തിരഞ്ഞെടുക്കൂ.')} lang={h.lang} class="mt-6" />
  <ul class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
    {data.tiers.map((tier) => (
      <li class:list={['flex flex-col border-t-2 pt-6', tier.highlight ? 'border-cobalt' : 'border-navy/15']}>
        <span class="eyebrow text-cobalt">{places(tier.count)}</span>
        <h3 class="mt-5 font-display text-xl leading-tight tracking-[-0.02em]">{tier.name}</h3>
        <p class="mt-2 flex-1 text-[0.95rem] text-muted">{tier.text}</p>
        <p class="eyebrow mt-6 text-navy">Pricing on request</p>
      </li>
    ))}
  </ul>

  <!-- Benefits matrix -->
  <h3 class="display mt-24 text-3xl text-cobalt sm:text-4xl" lang={h.lang}>{h('Benefits at a', 'ആനുകൂല്യങ്ങൾ')} <span class="text-red">{h('glance.', 'ഒറ്റനോട്ടത്തിൽ.')}</span></h3>
  <div class="mt-8 overflow-x-auto border border-line" tabindex="0" role="region" aria-label="Benefits by tier (scrolls horizontally)">
    <table class="w-full min-w-[42rem] border-collapse text-left text-sm sm:text-base">
      <caption class="sr-only">Partnership benefits by tier</caption>
      <thead class="bg-night text-white">
        <tr>
          <th scope="col" class="p-4 font-bold">Benefit</th>
          {data.matrixColumns.map((c) => <th scope="col" class="p-4 text-center font-bold">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {data.matrix.map((row) => (
          <tr class="border-t border-line bg-cream">
            <th scope="row" class="p-4 font-medium">{row.benefit}</th>
            {row.tiers.map((on) => (
              <td class="p-4 text-center">
                {on ? (
                  <span class="inline-grid size-7 place-items-center rounded-full bg-lake-soft text-cobalt"><Icon name="check" size={16} label="Included" /></span>
                ) : (
                  <span class="text-muted/50" aria-label="Not included">—</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-sm text-muted">Benefits are indicative and tailored with each partner.</p>
</Section>

<!-- How partnering works: four steps, in order -->
<Section tone="cream" rule labelledby="process-h">
  <ChapterLabel label={h('How it works', 'എങ്ങനെ')} lang={h.lang} />
  <Headline id="process-h" text={h('From first call', 'ആദ്യ വിളി മുതൽ')} accent={h('to the festival.', 'ഫെസ്റ്റിവൽ വരെ.')} lang={h.lang} class="mt-6" />
  <ol class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map(([title, line], i) => (
      <li class="border-t border-line pt-6">
        <span class="numeral text-[2.4rem] text-cobalt">{i + 1}</span>
        <h3 class="mt-5 font-display text-[1.3rem] leading-tight tracking-[-0.03em]">{title}</h3>
        <p class="mt-2 text-[0.98rem] leading-relaxed text-muted">{line}</p>
      </li>
    ))}
  </ol>
</Section>

<!-- Enquiry -->
<Section tone="sky" id="enquire" labelledby="enquire-h">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div>
      <ChapterLabel label={h('Enquire', 'അന്വേഷിക്കാം')} lang={h.lang} />
      <Headline id="enquire-h" text={h('Let’s write this', 'ഇത് നമുക്ക്')} accent={h('together.', 'ഒരുമിച്ചെഴുതാം.')} lang={h.lang} class="mt-6" />
      <p class="mt-6 max-w-md text-lg leading-relaxed text-navy/80">Tell us a little about your brand and we’ll share the full proposal and tailored options.</p>
      <div class="mt-9 flex flex-col items-start gap-4">
        <LimeButton href={callUrl} label="Book a partnership call" external={!!env.partnerCallUrl} />
        {
          hasProposal ? (
            <a href={`/${proposalFile}`} download class="inline-flex min-h-11 items-center gap-2 font-bold text-navy underline decoration-1 underline-offset-4 hover:text-cobalt">
              <Icon name="download" size={20} /> Download the partnership proposal (PDF)
            </a>
          ) : (
            <p class="inline-flex items-center gap-2 text-sm text-muted">
              <Icon name="download" size={20} /> Proposal PDF: <Placeholder value="[PROPOSAL PDF]" />
            </p>
          )
        }
        <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center gap-2 font-bold text-navy hover:text-cobalt"><Icon name="mail" size={20} class="text-cobalt" />{site.email}</a>
      </div>
    </div>
    <Form id="partner-form" name="partner" lang={lang} endpoint={env.formEndpointPartner || env.formEndpoint} class="border border-navy/10 bg-cream p-6 sm:p-9" successText="Thank you. Our partnerships team will be in touch shortly.">
      <Field formId="partner-form" name="name" label="Name" autocomplete="name" required />
      <Field formId="partner-form" name="email" type="email" label="Work email" autocomplete="email" required />
      <Field formId="partner-form" name="phone" type="tel" label="Phone" autocomplete="tel" inputmode="tel" required />
      <Field formId="partner-form" name="organisation" label="Company / brand" autocomplete="organization" required />
      <Field formId="partner-form" name="tier" type="select" label="Interested in" options={[...data.tiers.map((t) => t.name), 'Not sure yet']} full />
      <Field formId="partner-form" name="message" type="textarea" label="Message" full rows={4} />
    </Form>
  </div>
</Section>
