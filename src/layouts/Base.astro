---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBar from '@/components/MobileBar.astro';
import LeadSlideIn from '@/components/LeadSlideIn.astro';
import Consent from '@/components/Consent.astro';
import { businessLd, breadcrumbLd } from '@/lib/schema';

interface Props {
  /** Full <title>, max 60 characters. */
  title: string;
  /** Meta description, max 155 characters. */
  description: string;
  crumbs?: { href?: string; label: string }[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** WhatsApp message context for this page. */
  waContext?: string;
  animateLogo?: boolean;
  ogType?: 'website' | 'article';
}
const { title, description, crumbs, jsonLd = [], noindex = false, waContext = 'building', animateLogo = false, ogType = 'website' } = Astro.props;
const base = Astro.site!;
const path = Astro.url.pathname;
const canonical = new URL(path.endsWith('/') ? path : path + '/', base).href;
const slug = path === '/' ? 'home' : path.replace(/^\/|\/$/g, '').replace(/\//g, '--');
const ogSlug = slug === '404' ? 'home' : slug;
const ogImage = new URL(`/og/${ogSlug}.jpg`, base).href;
const ld = [businessLd(base), ...(crumbs ? [breadcrumbLd(crumbs, base, canonical)] : []), ...jsonLd];
if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[seo] title > 60 chars (${title.length}) on ${path}`);
  if (description.length > 155) console.warn(`[seo] description > 155 chars (${description.length}) on ${path}`);
}
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#6B3022" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/rajdhani-300.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/rajdhani-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="FACADO Exterior Design Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Motion mode: "m" = full motion, "rm" = reduced (opacity only). No class = no JS: everything is visible.
      (function (d) {
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.classList.add('js', rm ? 'rm' : 'm');
      })(document.documentElement);
    </script>
    <slot name="head" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header animateLogo={animateLogo} waContext={waContext} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar waContext={waContext} />
    <LeadSlideIn waContext={waContext} />
    <Consent />
    <script>
      import '@/scripts/ui';
    </script>
  </body>
</html>
