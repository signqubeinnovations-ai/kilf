---
import Base from '@/layouts/Base.astro';
import WaButton from '@/components/WaButton.astro';
import Dim from '@/components/Dim.astro';
---
<Base title="Page not found | FACADO" description="This page does not exist. Find ACP facade services, projects, or message FACADO on WhatsApp." noindex>
  <section class="s-rust nf" aria-labelledby="nf-h">
    <div class="wrap">
      <h1 id="nf-h" class="t-hero"><span class="thin">THIS PAGE</span><br /><span class="bold">ISN'T BUILT.</span></h1>
      <Dim label="404 / PAGE NOT FOUND" class="nf-dim" />
      <p class="lead">The link may be old, or the page may have moved. Your next facade is still one message away.</p>
      <div class="nf-cta">
        <WaButton context="building" size="lg" />
        <a class="btn btn-ghost btn-lg" href="/">Home</a>
        <a class="btn btn-ghost btn-lg" href="/projects">Projects</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 80svh; display: flex; align-items: center; padding-block: 5rem; }
  .nf h1 { margin-top: 2rem; }
  :global(.nf-dim) { margin: 2rem 0 1.5rem; max-width: 36rem; }
  .nf .lead { color: var(--fg); }
  .nf-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.5rem; }
</style>
