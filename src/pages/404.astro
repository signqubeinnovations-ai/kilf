---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Headline from '@/components/Headline.astro';
import LimeButton from '@/components/LimeButton.astro';
import TextLink from '@/components/TextLink.astro';
import Rings from '@/components/Rings.astro';
---
<BaseLayout title="Page not found" description="This page seems to have drifted out onto the lake." noindex>
  <section class="bg-cream pb-24 pt-16 sm:pb-32 sm:pt-24">
    <div class="container-kilf text-center">
      <Rings n={3} size={120} tone="lake" class="mx-auto" />
      <p class="numeral mt-6 text-7xl text-cobalt sm:text-8xl">404</p>
      <Headline as="h1" text="This page drifted out onto the" accent="lake." class="mx-auto mt-6 max-w-3xl" />
      <p class="mx-auto mt-5 max-w-lg text-lg text-muted">Some stories go missing. Let’s get you back to the shore.</p>
      <p class="mt-3 text-lg text-muted" lang="ml">ഈ പേജ് കണ്ടെത്താനായില്ല.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
        <LimeButton href="/" label="Back to the home page" />
        <TextLink href="/programme" label="Explore the programme" />
      </div>
    </div>
  </section>
</BaseLayout>
