---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Headline from '@/components/Headline.astro';
import Counter from '@/components/Counter.astro';
import Dim from '@/components/Dim.astro';
import Art from '@/components/Art.astro';
import WaButton from '@/components/WaButton.astro';
import FaqList from '@/components/FaqList.astro';
import Process from '@/components/Process.astro';
import Picker from '@/components/Picker.astro';
import CtaBand from '@/components/CtaBand.astro';
import ProofThumb from '@/components/ProofThumb.astro';
import { claddingScene, swatches } from '@/lib/facade';
import { categories, secondaryCategories, whyAcp, materials, quality, marquee } from '@/lib/content';

const N = 11;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const [featured, ...more] = projects;
const faqs = (await getCollection('faqs')).filter((f) => f.data.preview).sort((a, b) => a.data.order - b.data.order).slice(0, 4).map((f) => f.data);
---
<Base
  title="ACP Facade & Elevation Design in Kollam | FACADO"
  description="Premium ACP cladding and facade design for shops, showrooms, offices and villas in Karunagappally and Kollam. Free 3D design consultation on WhatsApp."
  waContext="building"
  animateLogo
>
  <!-- 01 HERO -->
  <section class="hero s-rust" aria-labelledby="hero-h">
    <Counter n={1} of={N} />
    <div class="wrap hero-in">
      <div class="hero-copy">
        <h1 id="hero-h" data-hl>
          <span class="eyebrow hero-eb">ACP facade design · Kollam, Kerala</span>
          <span class="t-hero hero-lines">
            <span class="ln" style="--i:1"><span class="thin">FACADES THAT</span></span>
            <span class="ln" style="--i:2"><span class="thin">MAKE YOUR</span></span>
            <span class="ln" style="--i:3"><span class="bold">BUILDING SELL.</span></span>
          </span>
        </h1>
        <Dim label="ACP FACADE / DESIGN · FABRICATE · INSTALL" class="hero-dim" />
        <p class="lead hero-lead">Your shop is judged in 3 seconds. FACADO designs, fabricates and installs premium ACP facades across Kerala.</p>
        <div class="hero-cta">
          <WaButton context="building" size="lg" magnetic pulse />
          <a class="btn btn-ghost btn-lg" href="#recent-work">See our work</a>
        </div>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true"><Art kind="hero" /></div>
  </section>

  <!-- 02 CLADDING SCENE -->
  <section class="cs s-charcoal" data-cladding data-gsap aria-labelledby="cs-h">
    <div class="cs-pin" data-pin>
      <Counter n={2} of={N} />
      <div class="wrap grid-12 cs-grid">
        <div class="cs-copy">
          <p class="eyebrow">What ACP does</p>
          <Headline id="cs-h" lines={['SAME BUILDING.', 'NEW FACE.', '*MORE CUSTOMERS.']} size="4" />
          <p class="cs-count caps"><span class="num">Panel</span> <span class="cs-n"><span data-cs-count>48</span> → 48</span></p>
          <p class="body-copy cs-cap" data-cs-cap>We fix a new aluminium skin in front of the old wall. The structure stays. The face changes, panel by panel, joint by joint.</p>
        </div>
        <div class="cs-art" set:html={claddingScene()} />
      </div>
    </div>
  </section>

  <!-- 03 WHAT WE BUILD -->
  <section class="section s-paper" id="what-we-build" aria-labelledby="wwb-h">
    <Counter n={3} of={N} />
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">What we build</p>
        <Headline id="wwb-h" lines={['FACADES FOR', '*EVERY KIND OF BUILDING.']} size="4" />
      </div>
      <div class="tiles">
        {categories.map((c, i) => (
          <a class={`tile tile-${i + 1} crop crop-hover`} href={c.href} data-reveal style={`--i:${i}`}>
            <span class="tile-img" data-cad><Art kind={c.kind} /></span>
            <Dim label={c.label} draw={false} class="tile-dim" />
            <span class="tile-row"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3 class="t-2">{c.title}</h3><span class="link-arrow" aria-hidden="true">View</span></span>
          </a>
        ))}
      </div>
      <div class="chips">
        <span class="caps num">Also</span>
        {secondaryCategories.map((c) => <a class="chip" href={c.href}>{c.title}</a>)}
      </div>
    </div>
  </section>

  <!-- 04 RECENT WORK -->
  <section class="section s-charcoal" id="recent-work" aria-labelledby="rw-h">
    <Counter n={4} of={N} />
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Recent work</p>
        <Headline id="rw-h" lines={['BUILT TO', '*PERFORM.']} size="4" />
      </div>
      {featured && (
        <article class="feat grid-12">
          <a class="feat-img crop crop-hover" href={`/projects/${featured.id}`} data-cad data-track="project_view">
            {featured.data.cover ? (
              <Picture src={featured.data.cover.src} alt={featured.data.cover.alt} widths={[640, 960, 1400]} sizes="(min-width: 64rem) 58vw, 100vw" formats={['avif', 'webp']} />
            ) : (
              <span class="ph"><Art kind="showroom" /><span class="ph-note fill">[FILL: project photo for {featured.data.client}]</span></span>
            )}
            {featured.data.cover && <span class="tag img-tag">{featured.data.cover.label}</span>}
          </a>
          <div class="feat-copy">
            <Dim label={featured.data.dimLabel} start />
            <h3 class="t-3 feat-h"><span class="thin">{featured.data.client.split('+')[0].trim()}</span>{featured.data.client.includes('+') && <><br /><span class="bold">+ {featured.data.client.split('+')[1].trim()}</span></>}</h3>
            <p class="caps num">{featured.data.location}</p>
            <p class="body-copy">{featured.data.summary}</p>
            <a class="link-arrow" href={`/projects/${featured.id}`} data-track="project_view">Read the case study</a>
          </div>
        </article>
      )}
      {more.length > 0 && (
        <ul class="more">
          {more.slice(0, 3).map((p) => (
            <li><a href={`/projects/${p.id}`} class="crop crop-hover more-a" data-track="project_view">{p.data.cover && <Picture src={p.data.cover.src} alt={p.data.cover.alt} widths={[480, 800]} sizes="(min-width: 64rem) 30vw, 100vw" formats={['avif', 'webp']} />}<span class="t-1">{p.data.title}</span><span class="caps num">{p.data.location}</span></a></li>
          ))}
        </ul>
      )}
      <p class="more-link"><a class="link-arrow" href="/projects">All projects</a></p>
    </div>
  </section>

  <!-- 05 WHY ACP -->
  <section class="section s-rust" aria-labelledby="why-h">
    <Counter n={5} of={N} />
    <div class="wrap grid-12">
      <div class="why-head">
        <p class="eyebrow">Why ACP</p>
        <Headline id="why-h" lines={['WHY', '*ACP.']} size="hero" />
        <p class="body-copy why-sub">A light aluminium skin with a hard-wearing finish. Shaped to your design. Fixed on a rust-free frame.</p>
      </div>
      <ol class="rule-list why-list">
        {whyAcp.map((w, i) => (
          <li data-reveal style={`--i:${i}`}><span class="num">{String(i + 1).padStart(2, '0')}</span><h3 class="t-1">{w.title}</h3><p class="body-copy">{w.text}</p></li>
        ))}
      </ol>
    </div>
    <div class="marquee mq" aria-hidden="true">
      <div class="marquee-track">
        {[...marquee, ...marquee, ...marquee, ...marquee].map((m, i) => <span class={i % 2 ? 'thin' : 'bold'}>{m}<i>·</i></span>)}
      </div>
    </div>
  </section>

  <!-- 06 PROCESS -->
  <section class="section s-charcoal" aria-labelledby="pr-h">
    <Counter n={6} of={N} />
    <div class="wrap grid-12">
      <div class="pr-head">
        <p class="eyebrow">Process</p>
        <Headline id="pr-h" lines={['ONE TEAM.', '*START TO FINISH.']} size="4" />
        <p class="pr-groups"><span class="thin">Design</span> <span class="arr">→</span> <span>Fabricate</span> <span class="arr">→</span> <span class="bold">Install</span></p>
        <p class="body-copy">No hand-offs between a designer, a fabricator and a fixing crew. The team that draws your facade builds it.</p>
        <a class="link-arrow" href="/about#process">The full process</a>
      </div>
      <div class="pr-steps"><Process /></div>
    </div>
  </section>

  <!-- 07 MATERIALS -->
  <section class="section s-paper" aria-labelledby="mt-h">
    <Counter n={7} of={N} />
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Materials we use</p>
        <Headline id="mt-h" lines={['WHAT IT IS', '*MADE OF.']} size="4" />
      </div>
      <ol class="mats">
        {materials.map((m, i) => (
          <li data-reveal style={`--i:${i}`}><span class="num">{String(i + 1).padStart(2, '0')}</span><h3 class="t-1">{m.title}</h3><p class="body-copy">{m.text}</p></li>
        ))}
      </ol>
      <div class="sw-wrap">
        <Dim label="FINISHES / WOOD · STONE · METALLIC · SOLID" start />
        <ul class="swatches" aria-label="Finish samples">
          {swatches.map((s) => <li class="sw"><span class="sw-chip" style={`background:${s.css}`} /><span class="sw-name">{s.name}</span></li>)}
        </ul>
        <p class="body-copy sw-note">Screen colours are a guide. We bring physical samples to your site.</p>
      </div>
    </div>
  </section>

  <!-- 08 PICKER -->
  <Picker n={8} of={N} />

  <!-- 09 QUALITY -->
  <section class="section s-charcoal" aria-labelledby="q-h">
    <Counter n={9} of={N} />
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Quality standards</p>
        <Headline id="q-h" lines={['CHECKED AT', '*EVERY JOINT.']} size="4" />
      </div>
      <ol class="qual">
        {quality.map((q, i) => (
          <li data-reveal style={`--i:${i}`}><span class="num">{String(i + 1).padStart(2, '0')}</span><h3 class="t-1">{q.title}</h3><p class="body-copy">{q.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 10 FAQ -->
  <section class="section s-paper" aria-labelledby="fq-h">
    <Counter n={10} of={N} />
    <div class="wrap grid-12">
      <div class="fq-head">
        <p class="eyebrow">FAQ</p>
        <Headline id="fq-h" lines={['STRAIGHT', '*ANSWERS.']} size="4" />
        <a class="link-arrow" href="/faq">All questions</a>
        <ProofThumb />
      </div>
      <div class="fq-list"><FaqList items={faqs} /></div>
    </div>
  </section>

  <!-- 11 CTA -->
  <CtaBand n={11} of={N} context="building" />
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; min-height: min(100svh - 4.5rem, 62rem); display: flex; align-items: center; padding-block: clamp(4rem, 8vw, 7rem) clamp(5rem, 9vw, 8rem); }
  .hero-in { position: relative; z-index: 2; }
  .hero-copy { max-width: 64rem; }
  .hero-eb { display: flex; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .hero-lines { display: block; }
  :global(.hero-dim) { margin-top: clamp(1.5rem, 3vw, 2.5rem); max-width: 40rem; }
  .hero-lead { margin-top: 1.5rem; color: var(--fg); max-width: 34ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .hero-art { position: absolute; z-index: 1; right: -6vw; bottom: -2px; width: clamp(16rem, 42vw, 44rem); height: 88%; pointer-events: none; }
  .hero-art :global(.art) { height: 100%; }
  .hero-art :global(svg) { width: 100%; height: 100%; }
  @media (max-width: 64rem) { .hero-art { opacity: 0.32; width: 75vw; right: -24vw; } }
  :global(.m) .hero-art { animation: rise 1.2s var(--ease) 0.25s both; }
  :global(.m) .hero-art :global(.led) { stroke-dasharray: 800; animation: led 1.6s var(--ease) 1.1s both; }
  @keyframes rise { from { transform: translateY(40%); } }
  @keyframes led { from { stroke-dashoffset: 800; } to { stroke-dashoffset: 0; } }
  :global(.rm) .hero-art { animation: fade 0.6s linear both; }
  @keyframes fade { from { opacity: 0; } }

  /* Cladding scene */
  .cs { position: relative; }
  .cs-pin { position: relative; min-height: 100svh; display: flex; align-items: center; padding-block: clamp(4rem, 8vw, 6rem); }
  .cs-grid { align-items: center; row-gap: 2.5rem; }
  .cs-copy { grid-column: 1 / -1; }
  .cs-art { grid-column: 1 / -1; }
  .cs-art :global(svg) { width: 100%; height: auto; max-height: 72svh; }
  @media (min-width: 64rem) { .cs-copy { grid-column: 1 / span 5; } .cs-art { grid-column: 6 / span 7; } }
  .cs-count { margin-top: 2rem; font-weight: 700; letter-spacing: 0.2em; display: flex; gap: 1rem; align-items: baseline; }
  .cs-n { font-size: var(--step-3); letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .cs-cap { margin-top: 1rem; }

  /* Section heads */
  .sec-head { display: grid; gap: 1.5rem; margin-bottom: clamp(3rem, 6vw, 5rem); max-width: 60rem; }

  /* Tiles */
  .tiles { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1rem, 2vw, 2rem); grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .tile { grid-column: 1 / -1; display: grid; gap: 1.1rem; text-decoration: none; }
  @media (min-width: 48rem) {
    .tile-1 { grid-column: 1 / span 7; }
    .tile-2 { grid-column: 8 / span 5; margin-top: 8rem; }
    .tile-3 { grid-column: 1 / span 5; }
    .tile-4 { grid-column: 6 / span 7; margin-top: 5rem; }
  }
  .tile-img { display: block; overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-paper-deep); }
  .tile-img :global(.art), .tile-img :global(svg) { width: 100%; height: 100%; transition: transform 1.2s var(--ease); }
  .tile:hover .tile-img :global(svg) { transform: scale(1.04); }
  :global(.tile-dim) > span { font-size: 0.72rem; }
  .tile-row { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: baseline; }
  .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: clamp(3rem, 6vw, 5rem); }
  .chips .caps { margin-right: 0.75rem; font-size: 0.85rem; }

  /* Featured */
  .feat { row-gap: 2rem; align-items: end; }
  .feat-img { grid-column: 1 / -1; display: block; position: relative; aspect-ratio: 16 / 11; overflow: hidden; }
  .feat-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .feat-copy { grid-column: 1 / -1; display: grid; gap: 1.1rem; }
  @media (min-width: 64rem) { .feat-img { grid-column: 1 / span 7; } .feat-copy { grid-column: 9 / span 4; } }
  .feat-h { line-height: 0.95; }
  .ph { position: relative; display: block; width: 100%; height: 100%; }
  .ph :global(.art) { height: 100%; }
  .ph-note { position: absolute; left: 1rem; bottom: 1rem; color: var(--color-charcoal); font-size: 0.85rem; font-family: var(--font-body); background-color: #f6e7a8; }
  .img-tag { position: absolute; left: 1rem; top: 1rem; background: var(--color-charcoal); }
  .more { list-style: none; padding: 0; margin: 4rem 0 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .more-a { display: grid; gap: 0.6rem; text-decoration: none; }
  .more-link { margin-top: 3rem; }

  /* Why */
  .why-head { grid-column: 1 / -1; margin-bottom: 3rem; }
  .why-sub { margin-top: 1.5rem; max-width: 34ch; }
  .why-list { grid-column: 1 / -1; }
  @media (min-width: 64rem) { .why-head { grid-column: 1 / span 5; margin: 0; position: sticky; top: 7rem; align-self: start; } .why-list { grid-column: 7 / span 6; } }
  .why-list li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.25rem 1rem; padding: 1.6rem 0; align-items: baseline; }
  .why-list li .body-copy { grid-column: 2; }
  .mq { margin-top: clamp(4rem, 8vw, 7rem); border-block: 1px solid var(--rule); padding-block: 1.2rem; font-size: var(--step-3); text-transform: uppercase; letter-spacing: 0.04em; line-height: 1; }
  .mq i { font-style: normal; color: var(--accent); margin-left: 2.5rem; }

  /* Process */
  .pr-head { grid-column: 1 / -1; display: grid; gap: 1.5rem; align-content: start; margin-bottom: 3.5rem; }
  .pr-steps { grid-column: 1 / -1; }
  @media (min-width: 64rem) { .pr-head { grid-column: 1 / span 5; position: sticky; top: 7rem; align-self: start; margin: 0; } .pr-steps { grid-column: 7 / span 6; } }
  .pr-groups { font-size: var(--step-1); text-transform: uppercase; letter-spacing: 0.04em; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pr-groups .arr { color: var(--accent); }

  /* Materials */
  .mats, .qual { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); border-top: 1px solid var(--rule); }
  .mats li, .qual li { display: grid; gap: 0.6rem; align-content: start; padding: 1.75rem 1.5rem 2rem 0; border-bottom: 1px solid var(--rule); }
  .qual { grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .sw-wrap { margin-top: clamp(4rem, 7vw, 6rem); display: grid; gap: 1.5rem; }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr)); gap: 0.6rem; }
  @media (min-width: 48rem) { .sw-chip { aspect-ratio: 3 / 4; } .swatches { grid-template-columns: repeat(9, minmax(0, 1fr)); } }
  .sw { display: grid; gap: 0.6rem; }
  .sw-chip { display: block; aspect-ratio: 1; border: 1px solid var(--rule); transition: transform 0.7s var(--ease); transform-origin: bottom; }
  .sw:hover .sw-chip { transform: scale(1.06); }
  .sw-name { font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.78rem; }
  .sw-note { font-size: 0.95rem; }

  /* FAQ preview */
  .fq-head { grid-column: 1 / -1; display: grid; gap: 1.5rem; align-content: start; margin-bottom: 2rem; }
  .fq-list { grid-column: 1 / -1; }
  @media (min-width: 64rem) { .fq-head { grid-column: 1 / span 4; } .fq-list { grid-column: 6 / span 7; } }
</style>
