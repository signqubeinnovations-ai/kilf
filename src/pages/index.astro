---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Headline from '@/components/Headline.astro';
import Counter from '@/components/Counter.astro';
import Dim from '@/components/Dim.astro';
import Art from '@/components/Art.astro';
import WaButton from '@/components/WaButton.astro';
import FaqList from '@/components/FaqList.astro';
import Process from '@/components/Process.astro';
import Picker from '@/components/Picker.astro';
import CtaBand from '@/components/CtaBand.astro';
import ProofThumb from '@/components/ProofThumb.astro';
import RefImage from '@/components/RefImage.astro';
import { claddingScene, swatches } from '@/lib/facade';
import { whyAcp, materials, quality, marquee, homeServices, sectors, capabilities, possibilities, whyChoose } from '@/lib/content';
import { site } from '@/lib/site';

const N = 13;
const pad = (n: number) => String(n).padStart(2, '0');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const [featured] = projects;
const faqs = (await getCollection('faqs')).filter((f) => f.data.preview).sort((a, b) => a.data.order - b.data.order).slice(0, 4).map((f) => f.data);
---
<Base
  title="ACP Facade & Elevation Design in Kollam | FACADO"
  description="Premium ACP cladding and facade design for shops, showrooms, offices and villas in Karunagappally and Kollam. Free 3D design consultation on WhatsApp."
  waContext="building"
  animateLogo
>
  <!-- 01 HERO -->
  <section class="hero s-rust" aria-labelledby="hero-h">
    <Counter n={1} of={N} />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="hero-h" data-hl>
          <span class="eyebrow hero-eb">ACP facade design · Kollam, Kerala</span>
          <span class="t-hero hero-lines">
            <span class="ln" style="--i:1"><span class="thin">TRANSFORMING</span></span>
            <span class="ln" style="--i:2"><span class="thin">BUILDING EXTERIORS</span></span>
            <span class="ln" style="--i:3"><span class="bold">WITH PRECISION.</span></span>
          </span>
        </h1>
        <Dim label="MODERN · DURABLE · ENGINEERED" class="hero-dim" />
        <p class="lead hero-lead">FACADO LLP designs, engineers, fabricates and installs premium ACP facade systems for commercial buildings, showrooms, institutions and villas across Kerala.</p>
        <div class="hero-cta">
          <WaButton context="building" size="lg" magnetic pulse label="Book a free facade consultation" />
          <a class="btn btn-ghost btn-lg" href="#services">Explore services</a>
        </div>
      </div>
      <figure class="hero-img crop" data-cad>
        <RefImage name="commercial-complex" eager sizes="(min-width: 64rem) 50vw, 100vw" />
        <figcaption><Dim label="ACP FACADE / COMMERCIAL COMPLEX" draw={false} /></figcaption>
      </figure>
    </div>
  </section>

  <!-- Capability strip -->
  <section class="caps-strip s-charcoal" aria-label="What we do">
    <ol class="wrap caps-list">
      {capabilities.map((c, i) => (
        <li data-reveal style={`--i:${i}`}><span class="num">{pad(i + 1)}</span><h2 class="t-1">{c.title}</h2><p class="body-copy">{c.text}</p></li>
      ))}
    </ol>
  </section>

  <!-- 02 INTRO -->
  <section class="section s-paper" aria-labelledby="in-h">
    <Counter n={2} of={N} />
    <div class="wrap grid-12 intro">
      <div class="in-copy">
        <p class="eyebrow">About FACADO</p>
        <Headline id="in-h" lines={['ELEVATING', '*MODERN ARCHITECTURE.']} size="4" />
        <p class="lead in-lead">A dedicated ACP facade company. One team from first survey to final handover.</p>
        <div class="body-copy in-body">
          <p>We partner with architects, builders, developers, institutions and business owners to create exteriors that combine aesthetics, durability and precise engineering.</p>
          <p>Every facade is designed to strengthen the identity of the building, and to perform for years in Kerala's sun, rain and humidity.</p>
        </div>
        <ul class="in-who" aria-label="Who we work with">
          {['Architects', 'Builders', 'Developers', 'Institutions', 'Business owners'].map((w) => <li class="chip">{w}</li>)}
        </ul>
        <a class="link-arrow" href="/about">About the studio</a>
      </div>
      <div class="in-img crop" data-reveal data-cad><RefImage name="glass-office" sizes="(min-width: 64rem) 40vw, 100vw" /></div>
    </div>
  </section>

  <!-- 03 SERVICES -->
  <section class="section s-paper svc" id="services" aria-labelledby="sv-h">
    <Counter n={3} of={N} />
    <div class="wrap">
      <div class="sec-head row">
        <div>
          <p class="eyebrow">Services</p>
          <Headline id="sv-h" lines={['WHAT WE', '*DELIVER.']} size="4" />
        </div>
        <p class="body-copy">Whether you are building new or revitalising an existing building, we deliver facade solutions that combine design, durability and engineering.</p>
      </div>
      <ol class="svc-list">
        {homeServices.map((s, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <a href={s.href} class="svc-row">
              <span class="num">{pad(i + 1)}</span>
              <span class="svc-txt"><h3 class="t-2">{s.title}</h3><span class="body-copy">{s.text}</span></span>
              <span class="svc-thumb crop" data-cad><RefImage name={s.img} tag={false} sizes="(min-width: 64rem) 22vw, 40vw" /></span>
              <span class="link-arrow svc-go" aria-hidden="true">View</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="svc-note body-copy">Images are illustrative. Project photos are on <a href="/projects">Projects</a>.</p>
    </div>
  </section>

  <!-- 04 CLADDING SCENE -->
  <section class="cs s-charcoal" data-cladding data-gsap aria-labelledby="cs-h">
    <div class="cs-pin" data-pin>
      <Counter n={4} of={N} />
      <div class="wrap grid-12 cs-grid">
        <div class="cs-copy">
          <p class="eyebrow">How ACP works</p>
          <Headline id="cs-h" lines={['SAME BUILDING.', 'NEW FACE.', '*MORE CUSTOMERS.']} size="4" />
          <p class="cs-count caps"><span class="num">Panel</span> <span class="cs-n"><span data-cs-count>48</span> → 48</span></p>
          <p class="body-copy cs-cap" data-cs-cap>A rust-free aluminium framework is anchored to the existing structure. Precision-fabricated panels are fixed and sealed on it, panel by panel. The building stays. The face changes.</p>
        </div>
        <div class="cs-art" set:html={claddingScene()} />
      </div>
    </div>
  </section>

  <!-- 05 SECTORS -->
  <section class="section s-paper" aria-labelledby="sc-h">
    <Counter n={5} of={N} />
    <div class="wrap">
      <div class="sec-head row">
        <div>
          <p class="eyebrow">Sectors</p>
          <Headline id="sc-h" lines={['BUILT FOR', '*EVERY SECTOR.']} size="4" />
        </div>
        <p class="body-copy">Each sector has its own priorities. We design for how your building is used and seen.</p>
      </div>
      <ol class="sectors">
        {sectors.map((s, i) => (
          <li data-reveal style={`--i:${i % 3}`}><span class="num">{pad(i + 1)}</span><h3 class="t-2">{s.title}</h3><p class="body-copy">{s.text}</p></li>
        ))}
      </ol>
    </div>
    <div class="marquee mq" aria-hidden="true">
      <div class="marquee-track">
        {[...marquee, ...marquee, ...marquee, ...marquee].map((m, i) => <span class={i % 2 ? 'thin' : 'bold'}>{m}<i>·</i></span>)}
      </div>
    </div>
  </section>

  <!-- 06 WHY ACP -->
  <section class="section s-rust" aria-labelledby="why-h">
    <Counter n={6} of={N} />
    <div class="wrap grid-12">
      <div class="why-head">
        <p class="eyebrow">Why ACP facades</p>
        <Headline id="why-h" lines={['THE SMART CHOICE', '*FOR MODERN BUILDINGS.']} size="3" />
        <p class="body-copy why-sub">ACP has become the preferred exterior for contemporary architecture. It balances appearance, performance and cost.</p>
        <div class="why-img crop" data-reveal data-cad><RefImage name="grey-box-projection" sizes="(min-width: 64rem) 36vw, 100vw" /></div>
      </div>
      <ol class="rule-list why-list">
        {whyAcp.map((w, i) => (
          <li data-reveal style={`--i:${i % 5}`}><span class="num">{pad(i + 1)}</span><h3 class="t-1">{w.title}</h3><p class="body-copy">{w.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 PROCESS -->
  <section class="section s-charcoal" aria-labelledby="pr-h">
    <Counter n={7} of={N} />
    <div class="wrap grid-12">
      <div class="pr-head">
        <p class="eyebrow">Our process</p>
        <Headline id="pr-h" lines={['PRECISION AT', '*EVERY STAGE.']} size="4" />
        <p class="pr-groups"><span class="thin">Design</span> <span class="arr">→</span> <span>Fabricate</span> <span class="arr">→</span> <span class="bold">Install</span></p>
        <p class="body-copy">Nine steps, one accountable team. No hand-offs between a designer, a fabricator and a fixing crew.</p>
        <a class="link-arrow" href="/about#process">The full process</a>
      </div>
      <div class="pr-steps"><Process /></div>
    </div>
  </section>

  <!-- 08 MATERIALS & QUALITY -->
  <section class="section s-paper" aria-labelledby="mt-h">
    <Counter n={8} of={N} />
    <div class="wrap">
      <div class="mt-head">
        <div class="sec-head">
          <p class="eyebrow">Built to perform</p>
          <Headline id="mt-h" lines={['EXCEPTIONAL FACADES.', '*EXCEPTIONAL MATERIALS.']} size="3" />
          <p class="body-copy">Great facades begin with the right materials, and last because of how they are fixed.</p>
        </div>
        <div class="mt-img crop" data-reveal><RefImage name="acp-sheets" contain sizes="(min-width: 64rem) 40vw, 100vw" /></div>
      </div>
      <div class="mq-grid">
        <div>
          <p class="caps num mq-h">We use</p>
          <ol class="rule-list mq-list">{materials.map((m, i) => <li><span class="num">{pad(i + 1)}</span><span><strong>{m.title}</strong><span class="body-copy">{m.text}</span></span></li>)}</ol>
        </div>
        <div>
          <p class="caps num mq-h">Quality standards</p>
          <ol class="rule-list mq-list">{quality.map((q, i) => <li><span class="num">{pad(i + 1)}</span><span><strong>{q.title}</strong><span class="body-copy">{q.text}</span></span></li>)}</ol>
        </div>
      </div>
      <div class="sw-wrap">
        <Dim label="FINISHES / WOOD · STONE · METALLIC · SOLID" start />
        <ul class="swatches" aria-label="Finish samples">
          {swatches.map((s) => <li class="sw"><span class="sw-chip" style={`background:${s.css}`} /><span class="sw-name">{s.name}</span></li>)}
        </ul>
        <p class="body-copy sw-note">Screen colours are a guide. We bring physical samples to your site.</p>
      </div>
    </div>
  </section>

  <!-- 09 DESIGN POSSIBILITIES + WHY FACADO -->
  <section class="section s-charcoal" aria-labelledby="dp-h">
    <Counter n={9} of={N} />
    <div class="wrap grid-12">
      <div class="dp-col">
        <p class="eyebrow">Design possibilities</p>
        <Headline id="dp-h" lines={['A UNIQUE', '*ARCHITECTURAL IDENTITY.']} size="3" />
        <p class="body-copy">ACP offers unmatched flexibility. These are the styles we design and build most.</p>
        <ul class="dp-tags">{possibilities.map((p) => <li class="chip" title={p.text}>{p.title}</li>)}</ul>
        <div class="dp-img crop" data-reveal data-cad><RefImage name="wood-finish-house" sizes="(min-width: 64rem) 40vw, 100vw" /></div>
      </div>
      <div class="wc-col">
        <p class="eyebrow">Why choose FACADO</p>
        <ol class="rule-list wc">
          {whyChoose.map((w, i) => <li data-reveal style={`--i:${i % 5}`}><span class="num">{pad(i + 1)}</span><span class="t-1">{w}</span></li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- 10 RECENT WORK -->
  <section class="section s-paper" id="recent-work" aria-labelledby="rw-h">
    <Counter n={10} of={N} />
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Recent work</p>
        <Headline id="rw-h" lines={['CREATING', '*ARCHITECTURAL LANDMARKS.']} size="4" />
      </div>
      {featured && (
        <article class="feat grid-12">
          <a class="feat-img crop crop-hover" href={`/projects/${featured.id}`} data-cad data-track="project_view">
            {featured.data.cover ? (
              <Picture src={featured.data.cover.src} alt={featured.data.cover.alt} widths={[640, 960, 1400]} sizes="(min-width: 64rem) 58vw, 100vw" formats={['avif', 'webp']} />
            ) : (
              <span class="ph"><Art kind="showroom" /><span class="ph-note fill">[FILL: project photo for {featured.data.client}]</span></span>
            )}
            {featured.data.cover && <span class="tag img-tag">{featured.data.cover.label}</span>}
          </a>
          <div class="feat-copy">
            <Dim label={featured.data.dimLabel} start />
            <h3 class="t-3 feat-h"><span class="thin">{featured.data.client.split('+')[0].trim()}</span>{featured.data.client.includes('+') && <><br /><span class="bold">+ {featured.data.client.split('+')[1].trim()}</span></>}</h3>
            <p class="caps num">{featured.data.location}</p>
            <p class="body-copy">{featured.data.summary}</p>
            <a class="link-arrow" href={`/projects/${featured.id}`} data-track="project_view">Read the case study</a>
          </div>
        </article>
      )}
      <p class="more-link"><a class="link-arrow" href="/projects">All projects</a></p>
    </div>
  </section>

  <!-- 11 PICKER -->
  <Picker n={11} of={N} />

  <!-- 12 FAQ -->
  <section class="section s-paper" aria-labelledby="fq-h">
    <Counter n={12} of={N} />
    <div class="wrap grid-12">
      <div class="fq-head">
        <p class="eyebrow">FAQ</p>
        <Headline id="fq-h" lines={['STRAIGHT', '*ANSWERS.']} size="4" />
        <a class="link-arrow" href="/faq">All questions</a>
        <ProofThumb />
      </div>
      <div class="fq-list"><FaqList items={faqs} /></div>
    </div>
  </section>

  <!-- 13 CTA -->
  <section class="section-tight s-charcoal pre-cta" aria-label="Let's redefine your building exterior">
    <div class="wrap pre-in">
      <p class="t-2 pre-h"><span class="thin">Let's redefine</span> <span class="bold">your building exterior.</span></p>
      <p class="body-copy">New commercial space or an existing building: send us a photo and your location. Studio: {site.address.street}, {site.address.locality}.</p>
    </div>
  </section>
  <CtaBand n={13} of={N} context="building" />
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; padding-block: clamp(3rem, 6vw, 5.5rem) clamp(4rem, 7vw, 6.5rem); }
  .hero-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 64rem) { .hero-grid { grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); } }
  .hero-eb { display: flex; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .hero-lines { display: block; font-size: clamp(2.6rem, 0.9rem + 5.4vw, 6.2rem); }
  :global(.hero-dim) { margin-top: clamp(1.5rem, 3vw, 2.25rem); max-width: 36rem; }
  .hero-lead { margin-top: 1.5rem; color: var(--fg); max-width: 40ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: clamp(2rem, 4vw, 2.75rem); }
  .hero-img { margin: 0; position: relative; display: grid; gap: 0.9rem; --crop-c: var(--color-sand-hi); }
  .hero-img :global(.ref) { aspect-ratio: 4 / 3; }
  @media (min-width: 64rem) { .hero-img { margin-right: calc(var(--gutter) * -1 - 1vw); } .hero-img :global(.ref) { aspect-ratio: 5 / 6; } }
  :global(.m) .hero-img :global(.ref) { animation: rise 1.2s var(--ease) 0.2s both; }
  @keyframes rise { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }

  /* Capability strip */
  .caps-strip { padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .caps-list { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 2rem 2.5rem; }
  .caps-list li { display: grid; gap: 0.5rem; align-content: start; border-top: 1px solid var(--rule); padding-top: 1.25rem; }
  .caps-list h2 { letter-spacing: 0.06em; }

  /* Section heads */
  .sec-head { display: grid; gap: 1.5rem; margin-bottom: clamp(3rem, 6vw, 4.5rem); max-width: 62rem; }
  .sec-head.row { max-width: none; align-items: end; }
  @media (min-width: 64rem) { .sec-head.row { grid-template-columns: 1.3fr 1fr; gap: 4rem; } .sec-head.row > .body-copy { padding-bottom: 0.5rem; } }

  /* Intro */
  .intro { row-gap: 3rem; align-items: center; }
  .in-copy { grid-column: 1 / -1; display: grid; gap: 1.5rem; }
  .in-img { grid-column: 1 / -1; aspect-ratio: 4 / 5; }
  @media (min-width: 64rem) { .in-copy { grid-column: 1 / span 6; } .in-img { grid-column: 8 / span 5; } }
  .in-lead { color: var(--fg); max-width: 32ch; }
  .in-body { display: grid; gap: 1rem; }
  .in-who { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }

  /* Services */
  .svc::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: var(--rule); }
  .svc-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .svc-list li { border-bottom: 1px solid var(--rule); }
  .svc-row { display: grid; grid-template-columns: 2.75rem 1fr; gap: 1rem 1.5rem; padding: 1.75rem 0; text-decoration: none; align-items: center; }
  .svc-txt { display: grid; gap: 0.6rem; }
  .svc-thumb { grid-column: 2; aspect-ratio: 16 / 10; overflow: hidden; --crop-gap: 6px; --crop-l: 10px; }
  .svc-go { display: none; }
  @media (min-width: 48rem) {
    .svc-row { grid-template-columns: 3.5rem 1fr 14rem auto; gap: 2rem; }
    .svc-thumb { grid-column: auto; }
    .svc-go { display: inline-flex; }
  }
  @media (min-width: 64rem) { .svc-row { grid-template-columns: 4rem 1fr 18rem 6rem; } }
  .svc-row:hover h3 { color: var(--color-rust); }
  .svc-row:hover .svc-thumb :global(img) { transform: scale(1.05); }
  .svc-note { margin-top: 1.5rem; font-size: 0.9rem; }

  /* Cladding scene */
  .cs { position: relative; }
  .cs-pin { position: relative; min-height: 100svh; display: flex; align-items: center; padding-block: clamp(4rem, 8vw, 6rem); }
  .cs-grid { align-items: center; row-gap: 2.5rem; }
  .cs-copy { grid-column: 1 / -1; }
  .cs-art { grid-column: 1 / -1; }
  .cs-art :global(svg) { width: 100%; height: auto; max-height: 72svh; }
  @media (min-width: 64rem) { .cs-copy { grid-column: 1 / span 5; } .cs-art { grid-column: 6 / span 7; } }
  .cs-count { margin-top: 2rem; font-weight: 700; letter-spacing: 0.2em; display: flex; gap: 1rem; align-items: baseline; }
  .cs-n { font-size: var(--step-3); letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .cs-cap { margin-top: 1rem; }

  /* Sectors */
  .sectors { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .sectors li { display: grid; gap: 0.75rem; align-content: start; padding: 2rem 1.75rem 2.25rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); transition: background-color 0.4s var(--ease); }
  .sectors li:hover { background: var(--color-paper-deep); }
  @media (min-width: 48rem) { .sectors li { min-height: 13rem; } }
  .mq { margin-top: clamp(4rem, 7vw, 6rem); border-block: 1px solid var(--rule); padding-block: 1.2rem; font-size: var(--step-3); text-transform: uppercase; letter-spacing: 0.04em; line-height: 1; }
  .mq i { font-style: normal; color: var(--accent); margin-left: 2.5rem; }

  /* Why ACP */
  .why-head { grid-column: 1 / -1; display: grid; gap: 1.5rem; margin-bottom: 3rem; align-content: start; }
  .why-list { grid-column: 1 / -1; }
  .why-img { aspect-ratio: 5 / 4; margin-top: 1rem; --crop-c: var(--color-sand-hi); }
  @media (min-width: 64rem) { .why-head { grid-column: 1 / span 5; margin: 0; position: sticky; top: 6.5rem; align-self: start; } .why-list { grid-column: 7 / span 6; } }
  .why-sub { max-width: 40ch; }
  .why-list li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.25rem 1rem; padding: 1.4rem 0; align-items: baseline; }
  .why-list li .body-copy { grid-column: 2; }

  /* Process */
  .pr-head { grid-column: 1 / -1; display: grid; gap: 1.5rem; align-content: start; margin-bottom: 3.5rem; }
  .pr-steps { grid-column: 1 / -1; }
  @media (min-width: 64rem) { .pr-head { grid-column: 1 / span 5; position: sticky; top: 7rem; align-self: start; margin: 0; } .pr-steps { grid-column: 7 / span 6; } }
  .pr-groups { font-size: var(--step-1); text-transform: uppercase; letter-spacing: 0.04em; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pr-groups .arr { color: var(--accent); }

  /* Materials & quality */
  .mt-head { display: grid; gap: 2rem; align-items: end; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .mt-head .sec-head { margin: 0; }
  .mt-img { aspect-ratio: 16 / 10; }
  @media (min-width: 64rem) { .mt-head { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .mq-grid { display: grid; gap: 3rem; }
  @media (min-width: 64rem) { .mq-grid { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .mq-h { margin-bottom: 1rem; font-size: 0.9rem; }
  .mq-list li { display: grid; grid-template-columns: 3rem 1fr; padding: 1.1rem 0; align-items: baseline; }
  .mq-list li > span:last-child { display: grid; gap: 0.25rem; }
  .mq-list strong { font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--step-1); line-height: 1.1; }
  .sw-wrap { margin-top: clamp(4rem, 7vw, 5.5rem); display: grid; gap: 1.5rem; }
